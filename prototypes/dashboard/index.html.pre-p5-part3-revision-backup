<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1440">
  <title>Workspace Dashboard — Traverse Studio</title>

  <!-- Design system tokens (single source of truth) -->
  <link rel="stylesheet" href="../../colors_and_type.css">
  <!-- Lucide icon font (FA Pro substitute, repo convention) -->
  <link rel="stylesheet" href="https://unpkg.com/lucide-static@0.453.0/font/lucide.css">

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      color: var(--surface-900);
      background: var(--surface-50);
      -webkit-font-smoothing: antialiased;
    }
    button { font-family: inherit; cursor: pointer; border: 0; background: transparent; padding: 0; color: inherit; }
    a { color: inherit; text-decoration: none; }

    /* ---------- App shell ---------- */
    .app {
      display: grid;
      grid-template-columns: 240px 1fr;
      min-height: 100vh;
    }

    /* Screens (only the active one is visible) */
    .screen { display: none; }
    .screen.is-active { display: block; }

    /* Sidebars (only the active variant is visible) */
    .sidebar[data-sidebar-variant] { display: none; }
    .sidebar.is-active { display: flex; }

    /* ---------- Sidebar (shared shell) ---------- */
    .sidebar {
      background: var(--surface-50);
      border-right: 1px solid var(--surface-200);
      padding: 16px 12px;
      flex-direction: column;
      gap: 6px;
      position: relative;
    }
    .sb-brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 6px 8px;
    }
    .sb-brand img.wordmark { height: 28px; display: block; }
    .sb-collapse {
      width: 28px; height: 28px;
      border-radius: 8px;
      color: var(--surface-500);
      display: inline-flex; align-items: center; justify-content: center;
      transition: background 120ms;
    }
    .sb-collapse:hover { background: var(--surface-100); color: var(--surface-700); }
    .sb-collapse i { font-size: 16px; }

    .sb-workspace {
      display: grid;
      grid-template-columns: 28px 1fr 16px;
      gap: 10px;
      align-items: center;
      padding: 6px 8px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 120ms;
      width: 100%;
      text-align: left;
    }
    .sb-workspace:hover { background: var(--surface-100); }
    .sb-workspace .avatar {
      width: 28px; height: 28px;
      border-radius: 999px;
      background: var(--surface-200);
      color: var(--surface-700);
      font: 600 11px var(--font-sans);
      display: inline-flex; align-items: center; justify-content: center;
      letter-spacing: 0.02em;
      overflow: hidden;
    }
    .sb-workspace .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .sb-workspace .name {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sb-workspace .chev { color: var(--surface-400); font-size: 14px; }

    .sb-eyebrow {
      font: 600 11px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 14px 8px 6px;
    }

    .sb-nav { display: flex; flex-direction: column; gap: 2px; }
    .sb-item {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 10px;
      align-items: center;
      padding: 8px 10px;
      border-radius: 8px;
      cursor: pointer;
      color: var(--surface-700);
      transition: background 120ms, color 120ms;
    }
    .sb-item:hover { background: var(--surface-100); color: var(--surface-900); }
    .sb-item i {
      width: 28px;
      font-size: 16px;
      text-align: center;
      color: var(--surface-500);
    }
    .sb-item:hover i { color: var(--surface-700); }
    .sb-item .label { font: 500 14px var(--font-sans); }
    .sb-item.active {
      background: var(--primary-500);
      color: #fff;
      box-shadow: 0 1px 2px 0 rgba(79, 70, 229, 0.25);
    }
    .sb-item.active i,
    .sb-item.active .label { color: #fff; }

    /* ---------- Workspace dropdown ---------- */
    .ws-dropdown-wrap { position: relative; }
    .ws-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      box-shadow: 0 10px 24px -8px rgba(15, 23, 42, 0.18), 0 2px 4px 0 rgba(15, 23, 42, 0.06);
      padding: 6px;
      z-index: 20;
      display: none;
    }
    .ws-dropdown.is-open { display: block; }
    .ws-menu-item {
      display: grid;
      grid-template-columns: 24px 1fr 12px;
      gap: 10px;
      align-items: center;
      padding: 8px 10px;
      border-radius: 8px;
      cursor: pointer;
      color: var(--surface-800);
      width: 100%;
      text-align: left;
      transition: background 120ms;
    }
    .ws-menu-item:hover { background: var(--surface-100); }
    .ws-menu-item i.lead {
      width: 24px;
      font-size: 16px;
      color: var(--surface-600);
      text-align: center;
    }
    .ws-menu-item .label {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
    }
    .ws-menu-item i.trail {
      width: 12px;
      font-size: 14px;
      color: var(--surface-400);
    }

    /* ---------- Workspace switcher list ---------- */
    .ws-list-section {
      padding: 6px 0 4px;
    }
    .ws-list-divider {
      height: 0;
      border: none;
      border-top: 0.5px solid var(--border-subtle);
      margin: 4px 6px;
    }
    .ws-list-row {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 10px 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 120ms;
      width: 100%;
      text-align: left;
      background: transparent;
      border: none;
      overflow: hidden;
    }
    .ws-list-row:hover { background: var(--surface-100); }
    .ws-list-row.is-current {
      background: color-mix(in srgb, var(--primary-600), transparent 92%);
      cursor: default;
    }
    .ws-list-row.is-current::before {
      content: '';
      position: absolute;
      left: 0; top: 6px; bottom: 6px;
      width: 3px;
      border-radius: 0 2px 2px 0;
      background: var(--primary-500);
    }
    .ws-list-row-body {
      flex: 1;
      min-width: 0;
    }
    .ws-list-row-name {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ws-list-row-meta {
      font: 400 11px var(--font-sans);
      color: var(--surface-500);
      margin-top: 1px;
    }
    .ws-list-row-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }
    .ws-current-pill {
      font: 600 10px var(--font-sans);
      color: var(--primary-600);
      background: color-mix(in srgb, var(--primary-500), transparent 85%);
      border-radius: 9999px;
      padding: 1px 7px;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .ws-list-row .role-badge {
      padding: 1px 6px;
      font-size: 10px;
      line-height: 16px;
    }

    /* ---------- Workspace switch toast ---------- */
    .ws-switch-toast {
      position: fixed;
      bottom: 56px; /* above devbar */
      right: 20px;
      background: var(--surface-900);
      color: #fff;
      font: 500 13px var(--font-sans);
      padding: 10px 16px;
      border-radius: 10px;
      box-shadow: var(--shadow-md);
      z-index: 9999;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 180ms ease, transform 180ms ease;
      pointer-events: none;
    }
    .ws-switch-toast.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ---------- System Admin sidebar variant ---------- */
    .sa-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 8px;
      border-radius: 8px;
      cursor: pointer;
      color: var(--surface-700);
      font: 500 13px var(--font-sans);
      width: 100%;
      text-align: left;
      transition: background 120ms;
    }
    .sa-back:hover { background: var(--surface-100); color: var(--surface-900); }
    .sa-back i { font-size: 14px; color: var(--surface-500); }

    /* ---------- Content ---------- */
    .content {
      padding: 40px 48px 48px;
      overflow: auto;
    }
    .dashboard-shell {
      max-width: 1180px;
      margin: 0 auto;
    }

    /* ---------- Action card: feedback awaiting review ---------- */
    .action-card {
      background: #fff;
      border: 1px solid var(--primary-200);
      border-radius: 14px;
      padding: 20px 22px 16px;
      margin-bottom: 28px;
      box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04);
    }
    .action-card__head {
      display: flex; align-items: flex-start; gap: 14px;
      margin-bottom: 14px;
      cursor: pointer;
      user-select: none;
      border-radius: 8px;
      padding: 2px;
      margin: -2px -2px 12px;
      transition: background 120ms;
    }
    .action-card__head:hover { background: var(--surface-50); }
    .action-card.is-collapsed .action-card__head { margin-bottom: 0; }
    .action-card.is-collapsed .action-card__list { display: none; }

    .action-card__toggle {
      width: 32px; height: 32px;
      border-radius: 8px;
      color: var(--surface-500);
      background: transparent;
      border: 0;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      align-self: center;
      transition: background 120ms, color 120ms;
    }
    .action-card__toggle:hover { background: var(--surface-100); color: var(--surface-800); }
    .action-card__toggle:focus-visible {
      outline: 2px solid var(--primary-400);
      outline-offset: 2px;
    }
    .action-card__toggle i {
      font-size: 18px;
      transition: transform 200ms ease;
    }
    .action-card.is-collapsed .action-card__toggle i { transform: rotate(-90deg); }
    .action-card__icon {
      width: 40px; height: 40px;
      border-radius: 10px;
      background: var(--warn-100);
      color: var(--warn-600);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .action-card__heading { flex: 1; min-width: 0; }
    .action-card__eyebrow {
      display: inline-flex; align-items: center; gap: 6px;
      font: 600 11px var(--font-sans);
      color: var(--warn-600);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .action-card__title {
      font: 600 18px/1.3 var(--font-sans);
      color: var(--surface-900);
      margin: 4px 0 2px;
    }
    .action-card__sub {
      font: 400 13px/1.5 var(--font-sans);
      color: var(--surface-600);
    }
    .action-card__list {
      display: flex; flex-direction: column;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      overflow: hidden;
    }
    .action-row {
      display: grid;
      grid-template-columns: 36px 1fr auto auto;
      gap: 14px;
      align-items: center;
      padding: 12px 14px;
      background: #fff;
      transition: background 120ms;
    }
    .action-row + .action-row { border-top: 1px solid var(--surface-100); }
    .action-row:hover { background: var(--surface-50); }
    .action-row .ico {
      width: 36px; height: 36px;
      border-radius: 9px;
      background: var(--surface-100);
      color: var(--surface-700);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 16px;
    }
    .action-row .test-name {
      font: 500 14px var(--font-sans);
      color: var(--surface-900);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      min-width: 0;
    }
    .action-row .candidate-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--warn-100);
      color: var(--warn-600);
      font: 600 12px var(--font-sans);
      white-space: nowrap;
    }
    .action-row .candidate-pill::before {
      content: "";
      width: 6px; height: 6px; border-radius: 999px;
      background: currentColor;
    }
    .action-row .review-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid var(--surface-300);
      background: #fff;
      color: var(--surface-800);
      font: 500 13px var(--font-sans);
      cursor: pointer;
      transition: background 120ms, border-color 120ms, color 120ms;
      text-decoration: none;
    }
    .action-row .review-btn:hover {
      border-color: var(--primary-400);
      color: var(--primary-700);
      background: var(--primary-50);
    }
    .action-row .review-btn i { font-size: 14px; }

    /* Workspace header */
    .ws-header {
      text-align: center;
      margin-bottom: 36px;
    }
    .ws-eyebrow {
      font: 500 13px var(--font-sans);
      color: var(--surface-500);
      letter-spacing: 0.01em;
    }
    .ws-title {
      font: 600 32px/1.2 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 6px 0 22px;
    }

    /* Summary pill */
    .ws-pill {
      display: inline-flex;
      align-items: stretch;
      background: var(--surface-100);
      border-radius: 999px;
      padding: 6px;
      gap: 2px;
    }
    .ws-pill .seg {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: 999px;
      font: 500 13px var(--font-sans);
      color: var(--surface-700);
      cursor: pointer;
      transition: background 120ms, color 120ms;
    }
    .ws-pill .seg:hover { background: rgba(255,255,255,0.6); color: var(--surface-900); }
    .ws-pill .dot {
      width: 6px; height: 6px; border-radius: 999px;
      background: var(--success-500);
      flex-shrink: 0;
    }
    .ws-pill .dot.warn { background: var(--warn-500); }
    .ws-pill .dot.info { background: var(--info-500); }

    /* ---------- Cards row ---------- */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      padding: 22px 24px;
    }
    .card-head {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 18px;
    }
    .card-head h2 {
      margin: 0;
      font: 600 16px var(--font-sans);
      color: var(--surface-900);
    }
    .card-head .sub {
      font: 400 13px var(--font-sans);
      color: var(--surface-500);
    }

    /* ---------- Assets card ---------- */
    .asset-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .asset-tile {
      background: var(--surface-50);
      border-radius: 12px;
      padding: 22px 18px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-align: center;
    }
    .asset-tile .icon {
      color: var(--surface-700);
      font-size: 22px;
      margin-bottom: 6px;
    }
    .asset-tile .num {
      font: 600 30px/1 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
    }
    .asset-tile .label {
      font: 500 13px var(--font-sans);
      color: var(--surface-700);
    }
    .asset-tile .dots {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 6px;
      font: 500 11px var(--font-sans);
      color: var(--surface-500);
    }
    .asset-tile .dots span {
      display: inline-flex; align-items: center; gap: 5px;
    }
    .asset-tile .dots i {
      width: 6px; height: 6px; border-radius: 999px; display: inline-block;
    }
    .dot-success { background: var(--success-500); }
    .dot-warn    { background: var(--warn-500); }
    .dot-info    { background: var(--info-500); }

    /* ---------- Activity card ---------- */
    .activity-stats {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      background: var(--surface-50);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 20px;
    }
    .activity-stats .stat {
      padding: 18px 18px 16px;
      text-align: center;
      border-right: 1px solid var(--surface-100);
    }
    .activity-stats .stat:last-child { border-right: none; }
    .activity-stats .num {
      font: 600 30px/1 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
    }
    .activity-stats .label {
      font: 500 12px var(--font-sans);
      color: var(--surface-500);
      margin-top: 6px;
    }

    .activity-eyebrow {
      font: 600 11px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 6px;
    }
    .activity-list { list-style: none; margin: 0; padding: 0; }
    .activity-row {
      display: grid;
      grid-template-columns: 28px 1fr auto auto;
      gap: 12px;
      align-items: center;
      padding: 8px 0;
    }
    .activity-row + .activity-row { border-top: 1px solid var(--surface-100); }
    .activity-row .ico {
      width: 28px; height: 28px;
      border-radius: 7px;
      background: var(--surface-100);
      color: var(--surface-600);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 14px;
    }
    .activity-row .title {
      font: 500 14px var(--font-sans);
      color: var(--surface-800);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }
    .activity-row .when {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      white-space: nowrap;
    }
    .activity-row .pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font: 500 12px var(--font-sans);
    }
    .activity-row .pill::before {
      content: "";
      width: 6px; height: 6px; border-radius: 999px;
      background: currentColor;
    }
    .pill.abandoned  { background: var(--warn-100);    color: var(--warn-500); }
    .pill.in-progress{ background: var(--info-100);    color: var(--info-500); }
    .pill.pending    { background: var(--info-100);    color: var(--info-500); }
    .pill.graded     { background: var(--success-100); color: var(--success-500); }

    /* ============================================================
       Settings pages (Workspace Settings + System Admin)
       ============================================================ */

    .settings-shell {
      max-width: 1280px;
      margin: 0 auto;
    }
    .settings-title {
      font: 700 32px/1.2 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 0 0 18px;
    }
    .settings-title.is-large {
      font-size: 36px;
      margin-bottom: 24px;
    }

    /* Tabs */
    .tabs {
      display: flex;
      gap: 28px;
      border-bottom: 1px solid var(--surface-200);
      margin-bottom: 28px;
    }
    .tab {
      position: relative;
      padding: 10px 2px 14px;
      font: 500 14px var(--font-sans);
      color: var(--surface-500);
      cursor: pointer;
      transition: color 120ms;
    }
    .tab:hover { color: var(--surface-800); }
    .tab.is-active {
      color: var(--primary-600);
      font-weight: 600;
    }
    .tab.is-active::after {
      content: "";
      position: absolute;
      left: 0; right: 0; bottom: -1px;
      height: 2px;
      background: var(--primary-600);
      border-radius: 2px 2px 0 0;
    }

    /* Section heading */
    .settings-section { margin-bottom: 28px; }
    .settings-section h3 {
      font: 600 16px var(--font-sans);
      color: var(--surface-900);
      margin: 0 0 4px;
    }
    .settings-section .section-sub {
      font: 400 13px var(--font-sans);
      color: var(--surface-500);
      margin: 0 0 24px;
    }

    /* Form rows: 2-col label / input */
    .form-row {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 32px;
      align-items: flex-start;
      padding: 18px 0;
      border-top: 1px solid var(--surface-100);
    }
    .form-row:first-of-type { border-top: 0; padding-top: 8px; }
    .form-label {
      font: 600 14px var(--font-sans);
      color: var(--surface-900);
    }
    .form-label .sub {
      display: block;
      font: 400 13px var(--font-sans);
      color: var(--surface-500);
      margin-top: 4px;
    }
    .form-label .description {
      display: block;
      font: 400 12px/1.5 var(--font-sans);
      color: var(--surface-500);
      margin-top: 8px;
      max-width: 360px;
    }

    .text-input,
    .select-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      transition: border-color 120ms, box-shadow 120ms;
    }
    .text-input::placeholder,
    .select-input::placeholder { color: var(--surface-400); }
    .text-input:focus,
    .select-input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .select-input {
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
      background-repeat: no-repeat;
      background-position: right 14px center;
      padding-right: 40px;
    }
    .select-placeholder { color: var(--surface-400); }

    /* Image upload card */
    .image-upload {
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 14px;
      min-height: 92px;
    }
    .image-upload .preview {
      width: 56px; height: 56px;
      border-radius: 999px;
      background: var(--surface-200);
      overflow: hidden;
      flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--surface-500);
    }
    .image-upload .preview img { width: 100%; height: 100%; object-fit: cover; }
    .image-upload .actions {
      display: flex;
      flex-direction: column;
      gap: 14px;
      color: var(--surface-500);
    }
    .image-upload .actions button {
      width: 24px; height: 24px;
      border-radius: 6px;
      color: var(--surface-500);
      display: inline-flex; align-items: center; justify-content: center;
      transition: background 120ms, color 120ms;
    }
    .image-upload .actions button:hover { background: var(--surface-100); color: var(--surface-700); }
    .image-upload .actions button i { font-size: 16px; }

    /* Toggle switch */
    .toggle {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle .slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background: var(--surface-300);
      border-radius: 999px;
      transition: background 160ms;
    }
    .toggle .slider::before {
      content: "";
      position: absolute;
      width: 18px; height: 18px;
      left: 3px; top: 3px;
      background: #fff;
      border-radius: 999px;
      transition: transform 160ms;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.2);
    }
    .toggle input:checked + .slider { background: var(--primary-500); }
    .toggle input:checked + .slider::before { transform: translateX(20px); }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 10px;
      font: 600 14px var(--font-sans);
      cursor: pointer;
      transition: background 120ms, border-color 120ms, color 120ms;
      border: 1px solid transparent;
    }
    .btn i { font-size: 16px; }
    .btn-primary {
      background: var(--primary-600);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary-700); }
    .btn-secondary {
      background: #fff;
      border-color: var(--surface-200);
      color: var(--surface-800);
    }
    .btn-secondary:hover { background: var(--surface-50); border-color: var(--surface-300); }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 8px;
    }

    /* ============================================================
       Data tables (Workspace Settings : Users, System Admin)
       ============================================================ */

    .table-toolbar {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }
    .table-toolbar.is-split { justify-content: space-between; }
    .table-toolbar .toolbar-end {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .search-input {
      position: relative;
      display: inline-flex;
      align-items: center;
    }
    .search-input i {
      position: absolute;
      left: 12px;
      font-size: 14px;
      color: var(--surface-400);
      pointer-events: none;
    }
    .search-input input {
      padding: 8px 14px 8px 34px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 13px var(--font-sans);
      color: var(--surface-900);
      width: 260px;
      transition: border-color 120ms, box-shadow 120ms;
    }
    .search-input input::placeholder { color: var(--surface-400); }
    .search-input input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 12px;
      overflow: hidden;
      table-layout: fixed;
    }
    .data-table thead th {
      background: var(--primary-50);
      text-align: left;
      padding: 14px 18px;
      font: 600 11px var(--font-sans);
      color: var(--surface-700);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-bottom: 1px solid var(--surface-200);
      white-space: nowrap;
    }
    .data-table thead th .sort {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      user-select: none;
    }
    .data-table thead th .sort i {
      font-size: 13px;
      color: var(--surface-400);
    }
    .data-table thead th.is-active-sort {
      color: var(--primary-700);
    }
    .data-table thead th.is-active-sort .sort i {
      color: var(--primary-600);
    }
    .data-table tbody td {
      padding: 16px 18px;
      font: 400 14px var(--font-sans);
      color: var(--surface-800);
      border-bottom: 1px solid var(--surface-100);
      vertical-align: middle;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .data-table tbody tr:last-child td { border-bottom: 0; }
    .data-table tbody tr:hover td { background: var(--surface-50); }
    .data-table td.col-id {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: 12px;
      color: var(--surface-500);
    }
    .data-table td.col-actions {
      width: 40px;
      text-align: right;
    }
    .row-menu-btn {
      width: 28px; height: 28px;
      border-radius: 6px;
      color: var(--surface-500);
      display: inline-flex; align-items: center; justify-content: center;
      transition: background 120ms, color 120ms;
    }
    .row-menu-btn:hover { background: var(--surface-100); color: var(--surface-800); }
    .row-menu-btn i { font-size: 16px; }

    /* Workspace Settings : Users uses a compact single-column variant */
    .data-table.is-compact tbody td { padding: 18px 22px; }
    .data-table.is-compact thead th { padding: 12px 22px; }

    /* ============================================================
       Modal
       ============================================================ */

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.42);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 50;
    }
    .modal-overlay.is-open { display: flex; }
    .modal-card {
      background: #fff;
      border-radius: 14px;
      width: 440px;
      max-width: calc(100vw - 40px);
      padding: 22px 22px 20px;
      box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.32);
    }
    .modal-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 14px;
    }
    .modal-head h2 {
      margin: 0;
      font: 600 18px var(--font-sans);
      color: var(--surface-900);
    }
    .modal-close {
      width: 28px; height: 28px;
      border-radius: 6px;
      color: var(--surface-500);
      display: inline-flex; align-items: center; justify-content: center;
      transition: background 120ms, color 120ms;
    }
    .modal-close:hover { background: var(--surface-100); color: var(--surface-800); }
    .modal-body p {
      margin: 0 0 14px;
      font: 400 13px/1.5 var(--font-sans);
      color: var(--surface-600);
    }
    .modal-body .text-input { margin-bottom: 18px; }
    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    /* ============================================================
       User profile screen
       ============================================================ */

    .profile-shell {
      max-width: 1280px;
      margin: 0 auto;
    }

    .profile-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font: 400 13px var(--font-sans);
      color: var(--surface-500);
      margin-bottom: 20px;
    }
    .profile-breadcrumb a {
      color: var(--surface-600);
      cursor: pointer;
      transition: color 120ms;
    }
    .profile-breadcrumb a:hover { color: var(--primary-600); }
    .profile-breadcrumb i { font-size: 12px; color: var(--surface-400); }
    .profile-breadcrumb .current { color: var(--surface-900); font-weight: 500; }

    .profile-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .profile-header {
      padding: 24px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      border-bottom: 1px solid var(--surface-100);
    }

    .profile-avatar {
      width: 64px; height: 64px;
      border-radius: 999px;
      background: var(--primary-100);
      color: var(--primary-700);
      font: 700 22px var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: 0.02em;
    }

    .profile-info { flex: 1; min-width: 0; }
    .profile-name-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .profile-name {
      font: 600 22px var(--font-sans);
      color: var(--surface-900);
      margin: 0;
      letter-spacing: -0.01em;
    }
    .profile-email {
      font: 400 14px var(--font-sans);
      color: var(--surface-600);
      margin-top: 4px;
    }
    .profile-title-line {
      font: 400 13px var(--font-sans);
      color: var(--surface-500);
      margin-top: 4px;
    }
    .profile-meta {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .profile-meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 400 13px var(--font-sans);
      color: var(--surface-600);
    }
    .profile-meta-item strong {
      color: var(--surface-800);
      font-weight: 600;
    }

    .profile-actions {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      flex-shrink: 0;
    }

    .row-menu-btn.is-bordered {
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      width: 38px; height: 38px;
    }

    /* Role chip variants */
    .role-chip {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font: 600 11px var(--font-sans);
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    .role-chip.is-org-owner { background: var(--success-100); color: var(--success-600); }
    .role-chip.is-org-admin { background: var(--primary-200); color: var(--primary-800); }
    .role-chip.is-admin     { background: var(--primary-100); color: var(--primary-700); }
    .role-chip.is-standard  { background: var(--info-100);    color: var(--info-500); }
    .role-chip.is-moderator { background: var(--warn-100);    color: var(--warn-600); }
    .role-chip.is-viewer    { background: var(--surface-100); color: var(--surface-600); }

    /* Status cell + dot */
    .status-cell {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font: 400 13px var(--font-sans);
      color: var(--surface-800);
    }
    .status-dot {
      width: 8px; height: 8px;
      border-radius: 999px;
      flex-shrink: 0;
    }
    .status-dot.is-active      { background: var(--success-500); }
    .status-dot.is-pending     { background: var(--warn-500); }
    .status-dot.is-deactivated { background: var(--surface-400); }
    .status-dot.is-removed     { background: var(--error-500); }

    /* Profile bio grid */
    .profile-bio {
      padding: 20px 24px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
    }
    .profile-bio-field {
      padding: 0 20px;
      border-right: 1px solid var(--surface-100);
    }
    .profile-bio-field:first-child { padding-left: 0; }
    .profile-bio-field:last-child  { border-right: 0; padding-right: 0; }
    .bio-label {
      font: 600 11px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .bio-value {
      font: 400 14px var(--font-sans);
      color: var(--surface-800);
    }
    .bio-value.is-empty {
      color: var(--surface-400);
      font-style: italic;
    }

    /* Two-column layout */
    .profile-body {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 20px;
      align-items: start;
    }
    .profile-body .col-right {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Section card */
    .section-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 12px;
      overflow: hidden;
    }
    .section-card.is-danger { border-color: var(--error-100); }

    .section-head {
      padding: 16px 20px;
      border-bottom: 1px solid var(--surface-100);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .section-head.is-danger { border-bottom-color: var(--error-100); }
    .section-title {
      font: 600 14px var(--font-sans);
      color: var(--surface-900);
    }
    .section-title.is-danger { color: var(--error-600); }
    .section-count {
      font: 400 13px var(--font-sans);
      color: var(--surface-400);
    }
    .section-footer {
      padding: 12px 16px;
      border-top: 1px solid var(--surface-100);
    }

    /* Workspace access table renders inside a section-card, no outer border */
    .section-card .data-table {
      border: 0;
      border-radius: 0;
    }
    .section-card .data-table thead th {
      background: var(--surface-50);
      color: var(--surface-500);
      font-size: 11px;
    }

    .ws-name {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
    }

    /* Meta list */
    .meta-list { padding: 4px 0; }
    .meta-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 10px 20px;
      border-bottom: 1px solid var(--surface-50);
      gap: 12px;
    }
    .meta-row:last-child { border-bottom: 0; }
    .meta-key {
      font: 400 12px var(--font-sans);
      color: var(--surface-400);
      white-space: nowrap;
    }
    .meta-val {
      font: 500 13px var(--font-sans);
      color: var(--surface-800);
      text-align: right;
    }
    .meta-val.is-muted { color: var(--surface-400); font-weight: 400; }

    /* Audit list */
    .audit-list { padding: 4px 0; }
    .audit-row {
      display: flex;
      gap: 12px;
      padding: 12px 20px;
      border-bottom: 1px solid var(--surface-50);
      align-items: flex-start;
    }
    .audit-row:last-child { border-bottom: 0; }
    .audit-dot {
      width: 6px; height: 6px;
      border-radius: 999px;
      background: var(--surface-300);
      flex-shrink: 0;
      margin-top: 6px;
    }
    .audit-text {
      font: 400 13px/1.5 var(--font-sans);
      color: var(--surface-600);
    }
    .audit-text strong {
      color: var(--surface-900);
      font-weight: 600;
    }
    .audit-time {
      font: 400 12px var(--font-sans);
      color: var(--surface-400);
      margin-top: 2px;
    }

    /* Danger zone */
    .danger-zone { padding: 16px 20px; }
    .danger-zone-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .danger-zone-row + .danger-zone-row {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--surface-50);
    }
    .danger-zone-label {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
      margin-bottom: 2px;
    }
    .danger-zone-desc {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
    }

    /* Danger button */
    .btn-danger {
      background: #fff;
      border: 1px solid var(--error-100);
      color: var(--error-600);
    }
    .btn-danger:hover {
      background: var(--error-100);
      border-color: var(--error-400);
    }

    /* "Current" workspace chip */
    .current-ws-chip {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      background: var(--primary-100);
      color: var(--primary-700);
      border-radius: 8px;
      font: 600 10px var(--font-sans);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-left: 8px;
    }

    /* Clickable user-list rows */
    .data-table tr.is-clickable { cursor: pointer; }
    .data-table tr.is-clickable:hover td { background: var(--surface-50); }

    /* Profile action menu (anchored under the ... button) */
    .profile-menu-wrap { position: relative; }
    .profile-menu {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      box-shadow: 0 10px 24px -8px rgba(15, 23, 42, 0.18), 0 2px 4px 0 rgba(15, 23, 42, 0.06);
      min-width: 200px;
      padding: 4px;
      z-index: 30;
      display: none;
    }
    .profile-menu.is-open { display: block; }
    .profile-menu-item {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      text-align: left;
      padding: 8px 12px;
      border-radius: 6px;
      font: 500 13px var(--font-sans);
      color: var(--surface-800);
      cursor: pointer;
      transition: background 120ms;
    }
    .profile-menu-item:hover { background: var(--surface-100); }
    .profile-menu-item.is-danger { color: var(--error-600); }
    .profile-menu-item.is-danger:hover { background: var(--error-100); }
    .profile-menu-divider {
      height: 1px;
      background: var(--surface-100);
      margin: 4px 0;
    }

    /* Edit profile / Add to workspace modals */
    .modal-card.is-wide { width: 540px; }
    .modal-form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }
    .field-label {
      display: block;
      font: 600 13px var(--font-sans);
      color: var(--surface-900);
      margin-bottom: 6px;
    }
    .field-hint {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin: 6px 0 0;
    }
    .field-group { margin-bottom: 14px; }
    .field-group:last-child { margin-bottom: 0; }
    .text-input[readonly] {
      background: var(--surface-50);
      color: var(--surface-500);
      cursor: default;
    }
    .textarea-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      resize: vertical;
      min-height: 88px;
      transition: border-color 120ms, box-shadow 120ms;
    }
    .textarea-input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }

    /* Avatar upload (Edit profile) */
    .avatar-upload-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-bottom: 18px;
      margin-bottom: 18px;
      border-bottom: 1px solid var(--surface-100);
    }
    .avatar-upload-preview {
      width: 56px; height: 56px;
      border-radius: 999px;
      background: var(--primary-100);
      color: var(--primary-700);
      font: 700 18px var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .avatar-upload-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .avatar-upload-btn {
      font: 500 13px var(--font-sans);
      color: var(--primary-600);
      cursor: pointer;
      text-align: left;
    }
    .avatar-upload-btn:hover { text-decoration: underline; }
    .avatar-upload-hint {
      font: 400 12px var(--font-sans);
      color: var(--surface-400);
    }

    /* Workspace typeahead */
    .typeahead-wrap { position: relative; }
    .typeahead-area {
      display: flex;
      align-items: center;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      overflow: hidden;
      transition: border-color 120ms, box-shadow 120ms;
    }
    .typeahead-area.is-focused {
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .typeahead-input {
      flex: 1;
      padding: 10px 14px;
      border: 0;
      outline: 0;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      background: transparent;
    }
    .typeahead-input::placeholder { color: var(--surface-400); }
    .typeahead-clear {
      width: 32px;
      align-items: center;
      justify-content: center;
      color: var(--surface-400);
      cursor: pointer;
      display: none;
    }
    .typeahead-clear.is-visible { display: inline-flex; }
    .typeahead-clear:hover { color: var(--surface-700); }
    .typeahead-clear i { font-size: 14px; }
    .typeahead-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      box-shadow: 0 10px 24px -8px rgba(15, 23, 42, 0.18);
      max-height: 220px;
      overflow-y: auto;
      padding: 4px;
      z-index: 30;
      display: none;
    }
    .typeahead-dropdown.is-open { display: block; }
    .typeahead-option {
      padding: 10px 12px;
      border-radius: 6px;
      cursor: pointer;
    }
    .typeahead-option:hover,
    .typeahead-option.is-active { background: var(--surface-100); }
    .typeahead-opt-name {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
    }
    .typeahead-opt-desc {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
    }
    .typeahead-empty {
      padding: 10px 12px;
      font: 400 13px var(--font-sans);
      color: var(--surface-400);
      text-align: center;
    }

    /* Disabled button */
    .btn[aria-disabled="true"] {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* ============================================================
       Devbar (prototype-only screen switcher)
       ============================================================ */
    .devbar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--surface-900);
      color: #fff;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 100;
      font: 500 12px var(--font-sans);
      box-shadow: 0 -6px 20px -8px rgba(15, 23, 42, 0.35);
    }
    .devbar .dev-label {
      color: rgba(255,255,255,0.55);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 11px;
      margin-right: 6px;
    }
    .devbar .dev-btn {
      padding: 6px 10px;
      border-radius: 6px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      font: 500 12px var(--font-sans);
      cursor: pointer;
      transition: background 120ms;
    }
    .devbar .dev-btn:hover { background: rgba(255,255,255,0.16); }
    .devbar .dev-btn.is-active { background: var(--primary-500); }
    .devbar .dev-divider {
      width: 1px;
      height: 18px;
      background: rgba(255,255,255,0.18);
      margin: 0 4px;
    }
    .devbar .dev-spacer { flex: 1; }

    /* When devbar is present, leave space at the bottom for it */
    .content { padding-bottom: 80px; }

    /* ---------- Organisation sidebar variant ---------- */
    /* (no extra CSS needed beyond .sa-back — it is shared) */

    /* ---------- Organisation hub — tab strip ---------- */
    .org-tabs {
      display: flex;
      border-bottom: 1px solid var(--surface-200);
      gap: 0;
      margin-bottom: 28px;
    }
    .org-tab {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px 10px;
      border: none;
      border-bottom: 2px solid transparent;
      background: transparent;
      font: 500 14px var(--font-sans);
      color: var(--surface-500);
      cursor: pointer;
      transition: color 100ms, border-color 100ms;
      margin-bottom: -1px;
      white-space: nowrap;
    }
    .org-tab:hover { color: var(--surface-700); }
    .org-tab.is-active {
      color: var(--primary-700);
      border-bottom-color: var(--primary-600);
    }
    .org-tab-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      height: 20px;
      padding: 0 6px;
      border-radius: 999px;
      font: 600 11px var(--font-sans);
      background: var(--surface-200);
      color: var(--surface-600);
    }
    .org-tab.is-active .org-tab-count {
      background: var(--primary-50);
      color: var(--primary-700);
    }

    /* Tab panels */
    .org-tab-panel { display: none; }
    .org-tab-panel.is-active { display: block; }

    /* Organisation page header */
    .org-page-header {
      margin-bottom: 24px;
    }
    .org-page-header h1 {
      font: 600 28px/1.2 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 0 0 6px;
    }
    .org-page-header .sub {
      font: 400 14px/1.5 var(--font-sans);
      color: var(--surface-500);
      margin: 0;
    }

    /* -----------------------------------------------
       Section 2: Summary tab
       ----------------------------------------------- */

    /* Row 1 — metric cards grid */
    .org-summary-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
      margin-bottom: 24px;
    }
    .org-summary-metric-card {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      padding: 16px 18px;
    }
    .org-summary-metric-number {
      font: 500 28px/1 var(--font-sans);
      letter-spacing: -0.4px;
      color: var(--surface-900);
    }
    .org-summary-metric-label {
      font: 400 12px/1.4 var(--font-sans);
      color: var(--surface-700);
      margin-top: 6px;
    }
    .org-summary-metric-sublabel {
      font: 400 11.5px/1.4 var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
    }

    /* Row 2 — two-column side-by-side cards */
    .org-summary-row2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    @media (max-width: 900px) {
      .org-summary-row2 {
        grid-template-columns: 1fr;
      }
    }

    /* Shared card chrome for both Row 2 cards */
    .org-summary-card {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .org-summary-leaders-header,
    .org-summary-activity-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      border-bottom: 0.5px solid var(--surface-200);
    }
    .org-summary-card-title {
      font: 500 16px/1.2 var(--font-sans);
      color: var(--surface-900);
      margin: 0;
    }
    .org-summary-card-meta {
      font: 400 12px/1 var(--font-sans);
      color: var(--surface-500);
    }
    .org-summary-card-action {
      background: transparent;
      border: none;
      color: var(--primary-700);
      font: 500 12.5px/1 var(--font-sans);
      cursor: pointer;
      padding: 0;
      text-decoration: none;
    }
    .org-summary-card-action:hover {
      text-decoration: underline;
    }

    /* Card A — Organisation leaders */
    .org-summary-leaders-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .org-summary-leaders-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 20px;
    }
    .org-summary-leaders-row + .org-summary-leaders-row {
      border-top: 0.5px solid var(--surface-200);
    }
    .org-summary-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--surface-100);
      color: var(--surface-600);
      font: 600 11px/1 var(--font-sans);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .org-summary-leader-info {
      flex: 1;
      min-width: 0;
    }
    .org-summary-leader-name-row {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font: 500 13.5px/1 var(--font-sans);
      color: var(--surface-900);
    }
    .org-summary-leader-email {
      font: 400 12px/1.4 var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
    }
    .org-summary-role-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 9999px;
      font: 500 11px/20px var(--font-sans);
    }
    .org-summary-role-badge.is-admin-tier {
      background: var(--primary-50);
      color: var(--primary-700);
    }
    .org-summary-view-link {
      background: transparent;
      border: none;
      color: var(--primary-700);
      font: 500 12.5px/1 var(--font-sans);
      padding: 4px 8px;
      border-radius: 4px;
      cursor: pointer;
      flex-shrink: 0;
      text-decoration: none;
    }
    .org-summary-view-link:hover {
      background: var(--primary-50);
    }

    /* Card B — Recent admin activity */
    .org-summary-activity-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .org-summary-activity-row {
      display: flex;
      gap: 12px;
      padding: 10px 20px;
    }
    .org-summary-activity-dot {
      width: 8px;
      height: 8px;
      margin-top: 6px;
      background: var(--primary-300);
      border-radius: 50%;
      flex-shrink: 0;
    }
    .org-summary-activity-body {
      flex: 1;
      min-width: 0;
    }
    .org-summary-activity-text {
      font: 400 13px/1.5 var(--font-sans);
      color: var(--surface-900);
    }
    .org-summary-activity-time {
      font: 400 11.5px/1.4 var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
    }

    /* -----------------------------------------------
       Section 3: Workspaces tab
       ----------------------------------------------- */

    /* Top action row */
    .org-workspaces-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }
    .org-workspaces-toolbar-end {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .org-workspaces-sort {
      height: 32px;
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 8px;
      font: 400 13px var(--font-sans);
      color: var(--surface-700);
      padding: 0 10px;
      cursor: pointer;
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
      background-repeat: no-repeat;
      background-position: right 8px center;
      padding-right: 28px;
      transition: border-color 120ms;
    }
    .org-workspaces-sort:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }

    /* Consolidated card */
    .org-workspaces-card {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .org-workspaces-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    /* Row */
    .ws-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      transition: background 0.1s;
    }
    .ws-row + .ws-row {
      border-top: 0.5px solid var(--surface-200);
    }
    .ws-row:hover {
      background: var(--surface-50);
    }

    /* Row left */
    .ws-row-main {
      min-width: 0;
    }
    .ws-row-name {
      font: 500 16px var(--font-sans);
      color: var(--surface-900);
      margin: 0 0 4px;
      letter-spacing: -0.1px;
    }
    .ws-row-meta {
      display: flex;
      gap: 4px;
      flex-wrap: wrap;
      font: 400 13px var(--font-sans);
      color: var(--surface-700);
      align-items: center;
    }
    .ws-row-sep {
      color: var(--surface-300);
    }

    /* Row right */
    .ws-row-actions {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-shrink: 0;
    }
    .ws-row-link-btn {
      background: transparent;
      border: 0;
      color: var(--primary-700);
      font: 500 12.5px/1 var(--font-sans);
      padding: 4px 8px;
      border-radius: 4px;
      cursor: pointer;
      transition: background 120ms;
      text-decoration: none;
      white-space: nowrap;
    }
    .ws-row-link-btn:hover {
      background: var(--primary-50);
    }
    .ws-row-overflow-btn {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background: transparent;
      border: 0;
      color: var(--surface-500);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 120ms, color 120ms;
    }
    .ws-row-overflow-btn:hover {
      background: var(--surface-100);
    }
    .ws-row-overflow-btn i {
      font-size: 16px;
    }

    /* -----------------------------------------------
       Section 4: Users tab
       ----------------------------------------------- */

    /* Outer layout */
    #org-panel-users {
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding-top: 20px;
    }

    /* Action row */
    .users-action-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    /* Sub-tab strip (reuses .org-tabs / .org-tab base styles, plus count chips) */
    .users-sub-tabs {
      display: flex;
      gap: 0;
    }
    .users-sub-tab-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      height: 18px;
      padding: 2px 6px;
      border-radius: 9999px;
      font: 500 11px/16px var(--font-sans);
      background: var(--surface-100);
      color: var(--surface-500);
      margin-left: 6px;
    }
    .org-tab.is-active .users-sub-tab-chip {
      background: var(--primary-50);
      color: var(--primary-700);
    }

    /* Right side of action row */
    .users-action-end {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Filter popover trigger */
    .users-filter-trigger {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      color: var(--surface-700);
      height: 32px;
      padding: 0 12px;
      font: 500 13px var(--font-sans);
      border-radius: 8px;
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: border-color 120ms, color 120ms;
    }
    .users-filter-trigger:hover {
      border-color: var(--surface-300);
      color: var(--surface-900);
    }
    .users-filter-count {
      background: var(--primary-600);
      color: #fff;
      border-radius: 9999px;
      padding: 0 5px;
      height: 16px;
      min-width: 16px;
      font: 600 10px var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    /* Filter popover panel */
    .users-filter-wrap {
      position: relative;
    }
    .users-filter-popover {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      width: 240px;
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 10px;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -1px rgb(0 0 0 / 0.06);
      padding: 12px;
      display: none;
      flex-direction: column;
      gap: 12px;
      z-index: 20;
    }
    .users-filter-popover.is-open {
      display: flex;
    }
    .users-filter-section-label {
      font: 600 10.5px var(--font-sans);
      color: var(--surface-500);
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 5px;
      display: block;
    }
    .users-filter-select {
      width: 100%;
      padding: 7px 10px;
      border: 0.5px solid var(--surface-200);
      border-radius: 7px;
      background: var(--surface-0);
      font: 400 13px var(--font-sans);
      color: var(--surface-800);
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
      background-repeat: no-repeat;
      background-position: right 8px center;
      padding-right: 28px;
    }
    .users-filter-select:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .users-filter-footer {
      padding-top: 8px;
      border-top: 0.5px solid var(--surface-200);
      display: flex;
      justify-content: flex-end;
    }
    .users-filter-clear {
      font: 500 12.5px var(--font-sans);
      color: var(--primary-700);
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 0;
    }
    .users-filter-clear:disabled,
    .users-filter-clear[aria-disabled="true"] {
      color: var(--surface-400);
      cursor: default;
    }

    /* Sub-panels — only the active one is visible */
    .users-subpanel { display: none; }
    .users-subpanel.is-active { display: block; }

    /* Two-pane body */
    .users-body {
      display: flex;
      gap: 18px;
      align-items: flex-start;
    }
    .users-main-col {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Peek rail */
    .users-peek-rail {
      width: 325px;
      flex-shrink: 0;
      align-self: flex-start;
      position: sticky;
      top: 20px;
    }

    /* ---- Users table card ---- */
    .users-table-card {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .users-table {
      width: 100%;
      border-collapse: collapse;
    }
    .users-table thead th {
      text-align: left;
      padding: 11px 16px;
      font: 500 11.5px var(--font-sans);
      color: var(--surface-500);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      background: var(--surface-50);
      border-bottom: 0.5px solid var(--surface-200);
      white-space: nowrap;
    }
    .users-table thead th.col-checkbox {
      width: 40px;
      padding-left: 16px;
      padding-right: 8px;
    }
    .users-table tbody tr {
      cursor: pointer;
      transition: background 0.1s;
    }
    .users-table tbody tr:not(:last-child) td {
      border-bottom: 0.5px solid var(--surface-200);
    }
    .users-table tbody tr:hover td {
      background: var(--surface-50);
    }
    .users-table tbody tr.is-selected td {
      background: color-mix(in srgb, var(--primary-600), transparent 94%);
    }
    .users-table tbody tr.is-peeked td {
      background: color-mix(in srgb, var(--primary-600), transparent 91%);
    }
    .users-table tbody td {
      padding: 13px 16px;
      vertical-align: middle;
    }
    .users-table tbody td.col-checkbox {
      padding-left: 16px;
      padding-right: 8px;
    }

    /* Name cell */
    .users-name-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .users-avatar {
      width: 32px;
      height: 32px;
      border-radius: 9999px;
      background: var(--surface-200);
      color: var(--surface-700);
      font: 600 11px var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: 0.02em;
    }
    .users-name-text {
      display: flex;
      flex-direction: column;
    }
    .users-name-primary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
    }
    .users-name-email {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin-top: 1px;
    }

    /* Role badge (V2, two-tier) */
    .role-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 9999px;
      font: 500 11px/20px var(--font-sans);
      white-space: nowrap;
    }
    .role-badge.is-admin-tier {
      background: var(--primary-50);
      color: var(--primary-700);
    }
    .role-badge.is-neutral-tier {
      background: var(--surface-100);
      color: var(--surface-600);
    }

    /* Role line (workspaces & roles cell)
       Two-column grid so workspace names left-align to each other in
       column 1 and role badges left-align to each other in column 2. */
    .role-line {
      display: grid;
      grid-template-columns: 120px auto;
      align-items: center;
      column-gap: 10px;
      margin-bottom: 3px;
    }
    .role-line:last-child { margin-bottom: 0; }
    .role-line-ws {
      font: 400 12px var(--font-sans);
      color: var(--surface-700);
    }
    /* Tighter badge sizing inside .role-line so the chip hugs its text */
    .role-line .role-badge {
      padding: 1px 6px;
      line-height: 16px;
      justify-self: start;
    }

    /* Status dot */
    .users-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font: 400 13px var(--font-sans);
      color: var(--surface-800);
    }
    .users-status-dot {
      width: 7px;
      height: 7px;
      border-radius: 9999px;
      flex-shrink: 0;
    }
    .users-status-dot.is-active      { background: var(--success-500); }
    .users-status-dot.is-pending     { background: var(--warn-500); }
    .users-status-dot.is-expired     { background: var(--error-400); }
    .users-status-dot.is-cancelled   { background: var(--surface-400); }
    .users-status-dot.is-deactivated { background: var(--surface-400); }

    /* Muted time */
    .users-time {
      font: 400 12px var(--font-sans);
      color: var(--surface-700);
    }

    /* Table footer */
    .users-table-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 16px 10px;
      border-top: 0.5px solid var(--surface-200);
    }
    .users-table-footer-count {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
    }

    /* Invite actions text buttons */
    .users-invite-actions {
      display: inline-flex;
      gap: 4px;
      align-items: center;
    }
    .users-link-btn {
      font: 500 12px var(--font-sans);
      color: var(--primary-700);
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 3px 6px;
      border-radius: 4px;
      transition: background 120ms;
    }
    .users-link-btn:hover { background: var(--primary-50); }
    .users-link-btn.is-danger { color: var(--surface-500); }
    .users-link-btn.is-danger:hover { color: var(--surface-800); background: var(--surface-100); }

    /* ---- Peek rail — empty state ---- */
    .users-peek-empty {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      padding: 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 14px;
    }
    .users-peek-empty-icon {
      width: 44px;
      height: 44px;
      background: var(--primary-50);
      color: var(--primary-700);
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }
    .users-peek-empty-title {
      font: 500 15px var(--font-sans);
      color: var(--surface-900);
      margin: 0;
    }
    .users-peek-empty-sub {
      font: 400 12.5px/1.55 var(--font-sans);
      color: var(--surface-700);
      margin: -6px 0 0;
    }
    .users-peek-tips {
      width: 100%;
      padding-top: 8px;
      border-top: 0.5px solid var(--surface-200);
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .users-peek-tip {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font: 400 12px var(--font-sans);
      color: var(--surface-600);
    }
    .users-kbd {
      font-family: monospace;
      font-size: 10.5px;
      padding: 2px 6px;
      background: var(--surface-100);
      border: 0.5px solid var(--surface-200);
      border-radius: 4px;
      color: var(--surface-700);
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ---- Peek rail — detail state ---- */
    .users-peek-detail {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .users-peek-detail-head {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 0.5px solid var(--surface-200);
    }
    .users-peek-avatar {
      width: 48px;
      height: 48px;
      border-radius: 9999px;
      background: var(--primary-100);
      color: var(--primary-700);
      font: 700 16px var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: 0.02em;
    }
    .users-peek-head-info {
      flex: 1;
      min-width: 0;
    }
    .users-peek-name {
      font: 600 14px var(--font-sans);
      color: var(--surface-900);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .users-peek-email {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .users-peek-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 5px;
    }
    .users-peek-close {
      width: 26px;
      height: 26px;
      border-radius: 6px;
      border: 0;
      background: transparent;
      color: var(--surface-500);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 120ms, color 120ms;
    }
    .users-peek-close:hover { background: var(--surface-100); color: var(--surface-800); }
    .users-peek-close i { font-size: 14px; }

    /* Peek status row */
    .users-peek-status-row {
      padding: 8px 16px;
      border-bottom: 0.5px solid var(--surface-200);
    }

    /* Peek meta dl */
    .users-peek-meta {
      padding: 12px 16px;
      border-bottom: 0.5px solid var(--surface-200);
    }
    .users-peek-meta dl {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 5px 12px;
      margin: 0;
    }
    .users-peek-meta dt {
      font: 400 11.5px var(--font-sans);
      color: var(--surface-500);
      white-space: nowrap;
    }
    .users-peek-meta dd {
      font: 500 12px var(--font-sans);
      color: var(--surface-800);
      margin: 0;
    }

    /* Peek workspaces section */
    .users-peek-section {
      padding: 12px 16px;
      border-bottom: 0.5px solid var(--surface-200);
    }
    .users-peek-section:last-child { border-bottom: 0; }
    .users-peek-overline {
      font: 600 10.5px var(--font-sans);
      color: var(--surface-500);
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 8px;
      display: block;
    }
    .users-peek-ws-list {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .users-peek-ws-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 400 12.5px var(--font-sans);
      color: var(--surface-800);
    }

    /* Peek quick actions */
    .users-peek-actions {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .users-peek-action-btn {
      width: 100%;
      text-align: left;
      padding: 8px 12px;
      border: 0;
      background: transparent;
      font: 500 13px var(--font-sans);
      color: var(--surface-800);
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background 120ms;
    }
    .users-peek-action-btn:hover { background: var(--surface-100); }
    .users-peek-action-btn i { font-size: 15px; color: var(--surface-500); }
    .users-peek-action-btn.is-danger { color: var(--error-600); }
    .users-peek-action-btn.is-danger:hover { background: var(--error-50, var(--error-100)); }
    .users-peek-action-btn.is-danger i { color: var(--error-400); }
    .users-peek-action-divider {
      height: 1px;
      background: var(--surface-100);
      margin: 4px 12px;
    }

    /* ---- Bulk action bar ---- */
    .users-bulk-bar {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
      display: none;
      align-items: center;
      gap: 12px;
      background: var(--surface-900);
      color: var(--surface-0);
      border-radius: 12px;
      box-shadow: 0 10px 24px -8px rgba(15, 23, 42, 0.35), 0 2px 8px rgba(15, 23, 42, 0.2);
      padding: 10px 16px;
      max-width: 90vw;
    }
    .users-bulk-bar.is-visible { display: flex; }
    .users-bulk-label {
      font: 500 13px var(--font-sans);
      color: var(--surface-0);
      white-space: nowrap;
    }
    .users-bulk-divider {
      width: 1px;
      height: 20px;
      background: var(--surface-700);
      flex-shrink: 0;
    }
    .users-bulk-btn {
      background: transparent;
      border: 0;
      color: var(--surface-0);
      font: 500 12.5px var(--font-sans);
      padding: 6px 10px;
      border-radius: 7px;
      cursor: pointer;
      transition: background 120ms;
    }
    .users-bulk-btn:hover { background: rgba(255,255,255,0.1); /* alpha overlay, intentional exception */ }
    .users-bulk-btn.is-danger { color: #FFB5AB; }
    /* Danger hover uses rgba alpha — intentional exception, alpha overlays can't reasonably be tokenised */
    .users-bulk-btn.is-danger:hover { background: rgba(220,60,40,0.22); }
    .users-bulk-clear {
      margin-left: auto;
      color: var(--surface-300);
      font: 500 12px var(--font-sans);
    }
    .users-bulk-clear:hover { color: var(--surface-0); background: transparent; }

    /* -----------------------------------------------
       Section 5B: Organisation user profile screen
       Uses org-profile- prefix to avoid collision with
       the existing user-profile screen's .profile-* classes
       ----------------------------------------------- */

    .org-profile-shell {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px 32px 48px;
    }

    /* Breadcrumb */
    .org-profile-breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin-bottom: 20px;
    }
    .org-profile-breadcrumb a {
      color: var(--surface-500);
      cursor: pointer;
      text-decoration: none;
      transition: color 120ms;
    }
    .org-profile-breadcrumb a:hover { color: var(--surface-700); }
    .org-profile-breadcrumb .bc-sep { color: var(--surface-400); }
    .org-profile-breadcrumb .bc-current { color: var(--surface-900); font-weight: 500; }

    /* Two-column grid */
    .org-profile-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
      gap: 18px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .org-profile-grid { grid-template-columns: 1fr; }
    }

    /* Card shell (shared by main + side) */
    .org-profile-card {
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    /* Card sections */
    .org-profile-section {
      padding: 20px 24px;
      border-top: 0.5px solid var(--surface-200);
    }
    .org-profile-section:first-child {
      border-top: 0;
      padding: 22px 24px;
    }

    /* Section header row */
    .org-profile-section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .org-profile-section-title {
      font: 500 17px var(--font-sans);
      color: var(--surface-900);
    }
    .org-profile-section-title.is-danger { color: var(--error-600); }
    .org-profile-section-link {
      font: 500 13px var(--font-sans);
      color: var(--primary-700);
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 0;
      text-decoration: none;
      transition: color 120ms;
    }
    .org-profile-section-link:hover { color: var(--primary-900); }

    /* Section 1: Identity */
    .org-profile-identity-row {
      display: flex;
      gap: 18px;
      align-items: flex-start;
    }
    .org-profile-avatar-lg {
      width: 64px;
      height: 64px;
      border-radius: 9999px;
      background: var(--surface-100);
      color: var(--surface-700);
      font: 600 18px var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: 0.02em;
    }
    .org-profile-identity-col {
      flex: 1;
      min-width: 0;
    }
    .org-profile-name-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .org-profile-full-name {
      font: 500 24px/1.2 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.3px;
    }
    .org-profile-status-inline {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font: 400 13px var(--font-sans);
      color: var(--surface-700);
    }
    .org-profile-email {
      font: 400 13px var(--font-sans);
      color: var(--surface-700);
      margin-top: 4px;
    }
    .org-profile-org-line {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
    }
    .org-profile-identity-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-shrink: 0;
      position: relative;
    }
    .org-profile-icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 0.5px solid var(--surface-200);
      background: var(--surface-0);
      color: var(--surface-600);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 120ms, border-color 120ms, color 120ms;
      font-size: 15px;
    }
    .org-profile-icon-btn:hover {
      background: var(--surface-50);
      border-color: var(--surface-300);
      color: var(--surface-900);
    }

    /* Overflow menu */
    .org-profile-overflow-wrap {
      position: relative;
    }
    .org-profile-overflow-menu {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      min-width: 200px;
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 10px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
      padding: 5px;
      display: none;
      flex-direction: column;
      z-index: 30;
    }
    .org-profile-overflow-menu.is-open { display: flex; }
    .org-profile-overflow-item {
      font: 400 13px var(--font-sans);
      color: var(--surface-800);
      padding: 8px 12px;
      border-radius: 7px;
      cursor: pointer;
      background: transparent;
      border: 0;
      text-align: left;
      transition: background 120ms;
    }
    .org-profile-overflow-item:hover { background: var(--surface-100); }
    .org-profile-overflow-item.is-danger { color: var(--error-600); }
    .org-profile-overflow-item.is-danger:hover { background: var(--error-50, var(--surface-100)); }
    .org-profile-overflow-divider {
      height: 0.5px;
      background: var(--surface-200);
      margin: 4px 0;
    }

    /* Bio dl */
    .org-profile-bio-dl {
      margin: 0;
    }
    .org-profile-bio-dl dt {
      font: 500 11.5px var(--font-sans);
      color: var(--surface-500);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 3px;
    }
    .org-profile-bio-dl dd {
      font: 400 13.5px/1.55 var(--font-sans);
      color: var(--surface-900);
      margin: 0 0 14px 0;
    }
    .org-profile-bio-dl dd:last-child { margin-bottom: 0; }

    /* Workspace memberships table */
    .org-profile-ws-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 2px;
    }
    .org-profile-ws-table thead th {
      padding: 8px 10px;
      font: 500 11px var(--font-sans);
      color: var(--surface-500);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 0.5px solid var(--surface-200);
      text-align: left;
    }
    .org-profile-ws-table thead th.org-profile-ws-th-actions { width: 120px; }
    .org-profile-ws-row td {
      padding: 11px 10px;
      border-bottom: 0.5px solid var(--surface-200);
      vertical-align: middle;
    }
    .org-profile-ws-row:last-child td { border-bottom: 0; }
    .org-profile-ws-td-name {
      font: 500 13.5px var(--font-sans);
      color: var(--surface-900);
    }
    .org-profile-ws-td-meta {
      font: 400 12.5px var(--font-sans);
      color: var(--surface-700);
    }
    .org-profile-ws-td-actions {
      display: flex;
      gap: 6px;
      justify-content: flex-end;
    }
    .org-profile-link-btn {
      font: 500 12px var(--font-sans);
      color: var(--primary-700);
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 3px 6px;
      border-radius: 4px;
      transition: background 120ms;
      white-space: nowrap;
    }
    .org-profile-link-btn:hover { background: var(--primary-50); }
    .org-profile-link-btn.is-danger { color: var(--error-600); }
    .org-profile-link-btn.is-danger:hover { background: var(--error-50, var(--surface-100)); }

    /* Activity list */
    .org-profile-audit-entry {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 8px 0;
      border-bottom: 0.5px solid var(--surface-200);
    }
    .org-profile-audit-entry:last-child { border-bottom: 0; }
    .org-profile-audit-dot {
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      background: var(--primary-300);
      flex-shrink: 0;
      margin-top: 5px;
    }
    .org-profile-audit-dot.is-warn { background: var(--warn-500); }
    .org-profile-audit-body { flex: 1; }
    .org-profile-audit-text {
      font: 400 13px var(--font-sans);
      color: var(--surface-900);
      line-height: 1.5;
    }
    .org-profile-audit-meta {
      font: 400 11.5px var(--font-sans);
      color: var(--surface-500);
      margin-top: 3px;
    }

    /* At-a-glance dl */
    .org-profile-glance-dl {
      margin: 0;
    }
    .org-profile-glance-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 9px 0;
      border-bottom: 0.5px solid var(--surface-200);
      gap: 12px;
    }
    .org-profile-glance-row:last-child { border-bottom: 0; }
    .org-profile-glance-dt {
      font: 400 11.5px var(--font-sans);
      color: var(--surface-500);
      white-space: nowrap;
    }
    .org-profile-glance-dd {
      font: 400 13px var(--font-sans);
      color: var(--surface-900);
      text-align: right;
      margin: 0;
    }

    /* Danger zone (side card) */
    .org-profile-danger-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 10px 0;
    }
    .org-profile-danger-label {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
    }
    .org-profile-danger-desc {
      font: 400 12px/1.5 var(--font-sans);
      color: var(--surface-500);
    }
    .org-profile-danger-divider {
      border-top: 0.5px solid var(--surface-200);
      padding-top: 14px;
      margin-top: 4px;
    }

    /* Small button variant for danger zone */
    .btn-sm {
      padding: 6px 12px;
      font: 600 12px var(--font-sans);
      border-radius: 8px;
    }

    /* ============================================================
       Section 7 — Workspace Members screen (.workspace-members-*)
       ============================================================ */

    .workspace-members-header {
      margin-bottom: 24px;
    }
    .workspace-members-header h1 {
      font: 600 28px/1.2 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 0 0 6px;
    }
    .workspace-members-header .sub {
      font: 400 13.5px/1.5 var(--font-sans);
      color: var(--surface-700);
      margin: 0;
    }

    /* Workspace members filter popover — scoped IDs avoid collision with org panel */
    #ws-members-filter-popover {
      position: absolute;
      top: calc(100% + 4px);
      right: 0;
      z-index: 40;
      background: var(--surface-0);
      border: 0.5px solid var(--surface-200);
      border-radius: 10px;
      box-shadow: 0 4px 16px rgba(0,0,0,.10);
      padding: 14px 16px 10px;
      width: 220px;
      display: none;
      flex-direction: column;
      gap: 12px;
    }
    #ws-members-filter-popover.is-open { display: flex; }

    /* Workspace-scope single role column */
    .workspace-members-role-cell {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ============================================================
       Section 6 — Org modal shell (.org-modal-*)
       ============================================================ */

    /* Backdrop */
    .org-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(2px);
      display: none; /* shown via style.display = 'flex' */
      align-items: center;
      justify-content: center;
      z-index: 50;
    }

    /* Dialog */
    .org-modal-dialog {
      background: var(--surface-0, #fff);
      border-radius: 12px;
      border: 0.5px solid var(--surface-200);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      display: flex;
      flex-direction: column;
      max-height: 90vh;
      max-width: calc(100vw - 40px);
      width: 480px; /* md default */
    }
    .org-modal-dialog.org-modal-sm { width: 400px; }
    .org-modal-dialog.org-modal-md { width: 480px; }
    .org-modal-dialog.org-modal-lg { width: 640px; }

    /* Header */
    .org-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      border-bottom: 0.5px solid var(--surface-200);
      flex-shrink: 0;
    }
    .org-modal-title {
      margin: 0;
      font: 500 16px var(--font-sans);
      color: var(--surface-900);
    }
    .org-modal-close {
      width: 32px; height: 32px;
      border-radius: 6px;
      color: var(--surface-500);
      display: inline-flex; align-items: center; justify-content: center;
      transition: background 120ms, color 120ms;
      flex-shrink: 0;
    }
    .org-modal-close:hover { background: var(--surface-100); color: var(--surface-800); }
    .org-modal-close i { font-size: 16px; }

    /* Body */
    .org-modal-body {
      padding: 20px 24px;
      overflow-y: auto;
      flex: 1;
    }

    /* Footer */
    .org-modal-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      padding: 16px 24px;
      border-top: 0.5px solid var(--surface-200);
      flex-shrink: 0;
    }
    .org-modal-footer.is-hidden { display: none; }

    /* Form groups inside org-modals */
    .org-modal-form { display: flex; flex-direction: column; gap: 16px; }
    .org-modal-group {}
    .org-modal-label {
      display: block;
      font: 500 12px var(--font-sans);
      color: var(--surface-700);
      margin-bottom: 6px;
    }
    .org-modal-label .opt-hint {
      font-weight: 400;
      color: var(--surface-500);
    }
    .org-modal-input,
    .org-modal-select,
    .org-modal-textarea {
      width: 100%;
      padding: 8px 10px;
      font: 13px var(--font-sans);
      color: var(--surface-900);
      background: var(--surface-100);
      border: 0.5px solid var(--surface-200);
      border-radius: 6px;
      outline: none;
      transition: border-color 120ms, box-shadow 120ms, background 120ms;
      box-sizing: border-box;
    }
    .org-modal-input::placeholder,
    .org-modal-textarea::placeholder { color: var(--surface-400); }
    .org-modal-input:focus,
    .org-modal-select:focus,
    .org-modal-textarea:focus {
      border-color: var(--primary-600);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-600), transparent 85%);
      background: var(--surface-0, #fff);
    }
    .org-modal-textarea { resize: vertical; }

    /* Role picker grid (invite member modal) */
    .org-modal-role-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 4px;
    }
    .org-modal-role-card {
      text-align: left;
      padding: 10px 12px;
      border: 0.5px solid var(--surface-200);
      border-radius: 8px;
      background: var(--surface-0, #fff);
      cursor: pointer;
      transition: border-color 120ms, background 120ms, box-shadow 120ms;
      font-family: var(--font-sans);
    }
    .org-modal-role-card:hover {
      border-color: var(--primary-300);
      background: var(--surface-50);
    }
    .org-modal-role-card.is-selected {
      border-color: var(--primary-600);
      background: color-mix(in srgb, var(--primary-600), transparent 94%);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-600), transparent 88%);
    }
    .org-modal-role-name {
      font: 500 13px var(--font-sans);
      color: var(--surface-900);
    }
    .org-modal-role-helper {
      font: 400 11.5px/1.4 var(--font-sans);
      color: var(--surface-500);
      margin-top: 2px;
    }
    .org-modal-role-note {
      font: 400 11px var(--font-sans);
      color: var(--surface-500);
      margin-top: 8px;
    }

    /* Info block (add-to-workspace modal) */
    .org-modal-info {
      font: 400 12px/1.55 var(--font-sans);
      color: var(--surface-700);
      padding: 10px 12px;
      background: var(--surface-100);
      border: 0.5px solid var(--surface-200);
      border-radius: 6px;
      margin-top: 16px;
    }

    /* ============================================================
       Welcome hero (P5 onboarding → dashboard handoff)
       ============================================================ */

    .welcome-hero {
      background: var(--surface-0);
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      box-shadow: var(--shadow-md);
      padding: 40px 40px 36px;
      margin-bottom: 32px;
      display: flex;
      gap: 32px;
      align-items: flex-start;
      position: relative;
      overflow: hidden;
    }
    /* Primary-50 left accent rail */
    .welcome-hero::before {
      content: "";
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 5px;
      background: var(--primary-400);
      border-radius: 14px 0 0 14px;
    }
    .welcome-hero__icon-block {
      width: 52px; height: 52px;
      border-radius: 14px;
      background: var(--primary-50);
      color: var(--primary-600);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .welcome-hero__body {
      flex: 1;
      min-width: 0;
    }
    .welcome-hero__greeting {
      font: 600 24px/1.3 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 0 0 6px;
    }
    .welcome-hero__role-line {
      font: 500 14px/1.4 var(--font-sans);
      color: var(--surface-600);
      margin: 0 0 14px;
    }
    .welcome-hero__copy {
      font: 400 14px/1.6 var(--font-sans);
      color: var(--surface-700);
      margin: 0;
      max-width: 540px;
    }
    .welcome-hero__actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: flex-end;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .welcome-hero__cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 10px;
      font: 600 14px var(--font-sans);
      cursor: pointer;
      border: 1px solid transparent;
      background: var(--primary-600);
      color: var(--surface-0);
      text-decoration: none;
      transition: background 120ms;
      white-space: nowrap;
    }
    .welcome-hero__cta:hover { background: var(--primary-700); }
    .welcome-hero__dismiss {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 16px;
      border-radius: 10px;
      font: 500 13px var(--font-sans);
      cursor: pointer;
      border: 1px solid var(--surface-200);
      background: transparent;
      color: var(--surface-600);
      transition: background 120ms, border-color 120ms, color 120ms;
      white-space: nowrap;
    }
    .welcome-hero__dismiss:hover {
      background: var(--surface-50);
      border-color: var(--surface-300);
      color: var(--surface-800);
    }
    .welcome-hero__dismiss:focus-visible,
    .welcome-hero__cta:focus-visible {
      outline: 2px solid var(--primary-400);
      outline-offset: 2px;
    }

    /* Post-dismiss placeholder panel (Moderator / Viewer only) */
    .welcome-placeholder {
      background: var(--surface-0);
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      box-shadow: var(--shadow-md);
      padding: 64px 40px;
      margin-bottom: 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0;
    }
    .welcome-placeholder__icon {
      width: 52px; height: 52px;
      border-radius: 14px;
      background: var(--surface-100);
      color: var(--surface-500);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 24px;
      margin-bottom: 20px;
    }
    .welcome-placeholder__heading {
      font: 600 18px/1.3 var(--font-sans);
      color: var(--surface-900);
      margin: 0 0 10px;
    }
    .welcome-placeholder__body {
      font: 400 14px/1.6 var(--font-sans);
      color: var(--surface-600);
      margin: 0 0 24px;
      max-width: 420px;
    }

    /* Hero + takeover visibility states */
