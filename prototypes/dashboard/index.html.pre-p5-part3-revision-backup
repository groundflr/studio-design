<div class="ws-switch-toast" id="ws-switch-toast" aria-live="polite" aria-atomic="true"></div>

<!-- ==========================================================
     Devbar — prototype-only screen switcher
     ========================================================== -->
<div class="devbar" aria-label="Prototype controls">
  <span class="dev-label">Screen</span>
  <button class="dev-btn" data-nav="dashboard">Dashboard</button>
  <button class="dev-btn" data-nav="workspace-settings">Workspace Settings</button>
  <button class="dev-btn" data-nav="workspace-members">Workspace Members</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-nav="system-admin-users">SA · Users</button>
  <button class="dev-btn" data-nav="system-admin-workspaces">SA · Workspaces</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-nav="user-profile">User profile</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-nav="organisation">Organisation</button>
  <button class="dev-btn" data-nav="organisation-user-profile">Org · User profile</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-action="open-add-users">Modal · Add users</button>
  <button class="dev-btn" data-action="open-invite-user">Modal · Invite user</button>
  <button class="dev-btn" data-action="open-edit-profile">Modal · Edit profile</button>
  <button class="dev-btn" data-action="open-add-to-workspace">Modal · Add to ws</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-org-modal-open="org-invite-member-modal">Org · Invite member</button>
  <button class="dev-btn" data-org-modal-open="org-add-to-workspace-modal">Org · Add to ws</button>
  <button class="dev-btn" data-org-modal-open="org-edit-profile-modal">Org · Edit profile</button>
  <span class="dev-divider"></span>
  <span class="dev-label">Welcome state</span>
  <button class="dev-btn" id="wb-off" data-welcome-role="off">Off</button>
  <button class="dev-btn" id="wb-standard" data-welcome-role="standard">Standard</button>
  <button class="dev-btn" id="wb-moderator" data-welcome-role="moderator">Moderator</button>
  <button class="dev-btn" id="wb-viewer" data-welcome-role="viewer">Viewer</button>
  <button class="dev-btn" id="wb-empty" data-welcome-role="empty">Empty</button>
  <button class="dev-btn" id="wb-reset-dismiss" data-welcome-action="reset-dismiss">Reset dismiss</button>
  <span class="dev-spacer"></span>
  <button class="dev-btn" data-action="toggle-ws-dropdown">Toggle workspace menu</button>
  <button class="dev-btn" id="dev-reset-workspace">Reset workspace</button>
</div>

<script>
  (function () {
    // ------- Action card collapse (existing behaviour) -------
    var card = document.getElementById('action-card');
    if (card) {
      var head = card.querySelector('.action-card__head');
      var toggleBtn = card.querySelector('.action-card__toggle');
      function setExpanded(expanded) {
        card.classList.toggle('is-collapsed', !expanded);
        head.setAttribute('aria-expanded', String(expanded));
        toggleBtn.setAttribute('aria-label', expanded ? 'Hide tests with feedback ready' : 'Show tests with feedback ready');
      }
      function toggle() { setExpanded(card.classList.contains('is-collapsed')); }
      head.addEventListener('click', function (e) {
        if (e.target.closest('a')) return;
        toggle();
      });
      head.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    }

    // ------- Screen + sidebar switching -------
    var app = document.querySelector('.app');
    var screens = document.querySelectorAll('.screen');
    var sidebars = document.querySelectorAll('.sidebar[data-sidebar-variant]');
    var devBtns = document.querySelectorAll('.devbar .dev-btn[data-nav]');

    // Map screen -> sidebar variant
    var sidebarFor = {
      'dashboard': 'workspace',
      'workspace-settings': 'workspace',
      'workspace-members': 'workspace',
      'system-admin-users': 'system-admin',
      'system-admin-workspaces': 'system-admin',
      'user-profile': 'workspace', // default; overridden by listContext
      'organisation': 'organisation',
      'organisation-user-profile': 'organisation',
    };

    // Where the user came from when opening a profile (so the breadcrumb back link goes back there
    // and the correct sidebar stays in place).
    var listContext = {
      screen: 'system-admin-users',
      sidebar: 'system-admin',
      breadcrumb: 'All users'
    };

    function setScreen(name, opts) {
      if (!sidebarFor[name]) return;
      opts = opts || {};
      var sidebarVariant = opts.sidebar || sidebarFor[name];
      screens.forEach(function (s) {
        s.classList.toggle('is-active', s.getAttribute('data-screen-name') === name);
      });
      sidebars.forEach(function (sb) {
        sb.classList.toggle('is-active', sb.getAttribute('data-sidebar-variant') === sidebarVariant);
      });
      // Update sidebar active items
      document.querySelectorAll('.sb-item[data-nav]').forEach(function (a) {
        a.classList.toggle('active', a.getAttribute('data-nav') === name);
      });
      // Update devbar active state
      devBtns.forEach(function (b) {
        b.classList.toggle('is-active', b.getAttribute('data-nav') === name);
      });
      app.setAttribute('data-screen', name);
      // Close dropdown + profile menu after navigation
      closeDropdown();
      closeProfileMenu();
    }

    // ------- Organisation tab switching -------
    function activateOrgTab(tabName) {
      // Sync tab strip buttons
      document.querySelectorAll('.org-tabs .org-tab[data-org-tab]').forEach(function (btn) {
        var active = btn.getAttribute('data-org-tab') === tabName;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', String(active));
      });
      // Sync tab panels
      document.querySelectorAll('.org-tab-panel').forEach(function (panel) {
        var panelTab = panel.id.replace('org-panel-', '');
        panel.classList.toggle('is-active', panelTab === tabName);
      });
      // Sync sidebar nav items
      document.querySelectorAll('.sidebar[data-sidebar-variant="organisation"] .sb-item[data-org-tab]').forEach(function (item) {
        item.classList.toggle('active', item.getAttribute('data-org-tab') === tabName);
      });
      // Persist to URL hash for deep-linking
      var params = new URLSearchParams(location.search);
      params.set('tab', tabName);
      history.replaceState(null, '', '?' + params.toString());
    }

    // Delegated click for org tab strip
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.org-tabs .org-tab[data-org-tab]');
      if (btn) {
        e.preventDefault();
        activateOrgTab(btn.getAttribute('data-org-tab'));
      }
    });

    function navTo(name, opts) {
      opts = opts || {};
      // Going to user-profile without row data (e.g. via devbar) keeps last context.
      if (name === 'user-profile') {
        setScreen(name, { sidebar: listContext.sidebar });
      } else if (name === 'organisation') {
        setScreen(name);
        // Activate the requested tab (from data-org-tab attr or URL or default 'summary')
        var requestedTab = opts.orgTab;
        if (!requestedTab) {
          var urlTab = new URLSearchParams(location.search).get('tab');
          requestedTab = (urlTab && ['summary','workspaces','users'].indexOf(urlTab) !== -1) ? urlTab : 'summary';
        }
        activateOrgTab(requestedTab);
      } else if (name === 'organisation-user-profile') {
        setScreen(name);
        // Highlight "Users" in the organisation sidebar
        document.querySelectorAll('.sidebar[data-sidebar-variant="organisation"] .sb-item[data-org-tab]').forEach(function (item) {
          item.classList.toggle('active', item.getAttribute('data-org-tab') === 'users');
        });
      } else {
        setScreen(name);
      }
    }

    document.addEventListener('click', function (e) {
      var nav = e.target.closest('[data-nav]');
      if (nav) {
        // Ignore clicks from within the org tab strip itself (handled separately above)
        if (nav.closest('.org-tabs')) return;
        e.preventDefault();
        var screenName = nav.getAttribute('data-nav');
        var orgTab = nav.getAttribute('data-org-tab');
        navTo(screenName, orgTab ? { orgTab: orgTab } : {});
      }
    });

    // ------- User profile: data binding -------
    var roleClassMap = {
      'org owner': { cls: 'is-org-owner', label: 'Org owner' },
      'org admin': { cls: 'is-org-admin', label: 'Org admin' },
      'super':     { cls: 'is-org-admin', label: 'Org admin' },
      'workspace admin': { cls: 'is-admin', label: 'Workspace admin' },
      'admin':     { cls: 'is-admin', label: 'Workspace admin' },
      'standard':  { cls: 'is-standard', label: 'Standard user' },
      'standard user': { cls: 'is-standard', label: 'Standard user' },
      'moderator': { cls: 'is-moderator', label: 'Moderator' },
      'viewer':    { cls: 'is-viewer', label: 'Viewer' }
    };

    function initialsFor(name) {
      return name.split(/\s+/).map(function (n) { return n.charAt(0); }).slice(0, 2).join('').toUpperCase();
    }

    function populateProfile(data) {
      data = data || {};
      var name  = data.name  || 'Sarah Chen';
      var email = data.email || 'sarah.chen@acmecorp.com';
      var roleKey = (data.role || 'Org admin').toLowerCase();
      var role = roleClassMap[roleKey] || { cls: 'is-standard', label: data.role || 'Standard user' };
      var initials = initialsFor(name);

      document.querySelectorAll('[data-profile-name]').forEach(function (el) { el.textContent = name; });
      document.querySelectorAll('[data-profile-current-name]').forEach(function (el) { el.textContent = name; });
      document.querySelectorAll('[data-profile-email]').forEach(function (el) {
        el.textContent = email || '';
      });
      document.querySelectorAll('[data-profile-avatar]').forEach(function (el) { el.textContent = initials; });

      document.querySelectorAll('[data-profile-role-chip]').forEach(function (el) {
        el.className = 'role-chip ' + role.cls;
        el.setAttribute('data-profile-role-chip', '');
        el.textContent = role.label;
      });
      document.querySelectorAll('[data-profile-meta-role]').forEach(function (el) {
        el.className = 'role-chip ' + role.cls;
        el.setAttribute('data-profile-meta-role', '');
        el.textContent = role.label;
      });

      // Update breadcrumb back text from listContext.
      var backLink = document.querySelector('[data-profile-back]');
      if (backLink) backLink.textContent = listContext.breadcrumb;
    }

    function navigateToUserProfile(userData) {
      // Capture the list we came from so the breadcrumb + sidebar work correctly.
      var current = app.getAttribute('data-screen');
      if (current === 'workspace-settings') {
        listContext = { screen: 'workspace-settings', sidebar: 'workspace', breadcrumb: 'Users', tab: 'users' };
      } else if (current === 'system-admin-users') {
        listContext = { screen: 'system-admin-users', sidebar: 'system-admin', breadcrumb: 'All users' };
      }
      populateProfile(userData);
      setScreen('user-profile', { sidebar: listContext.sidebar });
    }

    // Row-click → user profile
    document.addEventListener('click', function (e) {
      if (e.target.closest('.row-menu-btn')) return; // let row-menu button click through
      var row = e.target.closest('table[data-user-list] tbody tr');
      if (!row) return;

      var type = row.closest('table').getAttribute('data-user-list');
      var cells = row.querySelectorAll('td');
      var data;
      if (type === 'system') {
        // first, last, email, role, id, actions
        data = {
          name: (cells[0].textContent + ' ' + cells[1].textContent).trim().replace(/\s+/g, ' '),
          email: cells[2].textContent.trim(),
          role: cells[3].textContent.trim()
        };
      } else {
        // workspace: just full name
        data = {
          name: cells[0].textContent.trim(),
          email: '',
          role: 'Standard user'
        };
      }
      navigateToUserProfile(data);
    });

    // Breadcrumb back link
    document.addEventListener('click', function (e) {
      var back = e.target.closest('[data-profile-back]');
      if (!back) return;
      e.preventDefault();
      if (listContext.screen === 'workspace-settings') {
        setScreen('workspace-settings');
        // Restore the Users tab
        var ws = document.querySelector('[data-screen-name="workspace-settings"]');
        if (ws) {
          ws.querySelectorAll('.tab').forEach(function (t) {
            t.classList.toggle('is-active', t.getAttribute('data-tab') === 'users');
          });
          ws.querySelectorAll('.tab-panel').forEach(function (p) {
            var on = p.getAttribute('data-tab-panel') === 'users';
            p.classList.toggle('is-active', on);
            if (on) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
        }
      } else {
        setScreen('system-admin-users');
      }
    });

    // Profile actions menu
    function closeProfileMenu() {
      var menu = document.getElementById('profile-menu');
      if (menu) menu.classList.remove('is-open');
      var toggleBtn = document.querySelector('[data-action="toggle-profile-menu"]');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    }
    document.addEventListener('click', function (e) {
      var menu = document.getElementById('profile-menu');
      if (!menu) return;
      if (menu.classList.contains('is-open') &&
          !menu.contains(e.target) &&
          !e.target.closest('[data-action="toggle-profile-menu"]')) {
        closeProfileMenu();
      }
    });

    // ------- Workspace dropdown -------
    var wsToggle = document.getElementById('ws-toggle');
    var wsDropdown = document.getElementById('ws-dropdown');

    function openDropdown() {
      if (!wsDropdown) return;
      wsDropdown.classList.add('is-open');
      wsToggle.setAttribute('aria-expanded', 'true');
    }
    function closeDropdown() {
      if (!wsDropdown) return;
      wsDropdown.classList.remove('is-open');
      if (wsToggle) wsToggle.setAttribute('aria-expanded', 'false');
    }
    function toggleDropdown() {
      if (wsDropdown.classList.contains('is-open')) closeDropdown();
      else openDropdown();
    }

    if (wsToggle) {
      wsToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        toggleDropdown();
      });
    }
    document.addEventListener('click', function (e) {
      if (!wsDropdown) return;
      if (wsDropdown.classList.contains('is-open') &&
          !wsDropdown.contains(e.target) &&
          !(wsToggle && wsToggle.contains(e.target))) {
        closeDropdown();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeDropdown();
        closeAllModals();
      }
    });

    // ------- Workspace switcher (P5 Part 3) -------
    // Sarah Chen (u2) is the current persona. Her workspaces span three different roles,
    // demonstrating the cross-workspace role case.
    var SARAH_WORKSPACES = [
      { id: 'ld-hub',         name: 'L&D Hub',         initials: 'LH', role: 'workspace-admin' },
      { id: 'sales-training', name: 'Sales Training',  initials: 'ST', role: 'standard' },
      { id: 'grad-hiring',    name: 'Graduate Hiring', initials: 'GH', role: 'moderator' },
    ];

    var DEFAULT_WS_ID = 'ld-hub';
    var currentWorkspaceId = DEFAULT_WS_ID;

    // Role badge helper for workspace list rows
    var WS_ROLE_BADGE = {
      'workspace-admin': { cls: 'is-admin-tier', label: 'Workspace admin' },
      'moderator':       { cls: 'is-neutral-tier', label: 'Moderator' },
      'standard':        { cls: 'is-neutral-tier', label: 'Standard user' },
      'viewer':          { cls: 'is-neutral-tier', label: 'Viewer' },
    };

    // Count members per workspace from ORG_USERS (populated later after ORG_USERS is defined)
    function countMembersForWorkspace(wsName) {
      var users = window._orgUsers || [];
      return users.filter(function (u) {
        return u.workspaces && u.workspaces.some(function (w) { return w.name === wsName; });
      }).length;
    }

    function renderWsList() {
      var section = document.getElementById('ws-list-section');
      if (!section) return;
      section.innerHTML = '';
      SARAH_WORKSPACES.forEach(function (ws) {
        var isCurrent = (ws.id === currentWorkspaceId);
        var badgeInfo = WS_ROLE_BADGE[ws.role] || { cls: 'is-neutral-tier', label: ws.role };
        var memberCount = countMembersForWorkspace(ws.name);
        var metaText = memberCount > 0 ? memberCount + (memberCount === 1 ? ' member' : ' members') : '';

        var btn = document.createElement('button');
        btn.className = 'ws-list-row' + (isCurrent ? ' is-current' : '');
        btn.setAttribute('role', 'menuitem');
        if (isCurrent) {
          btn.setAttribute('aria-current', 'true');
          btn.setAttribute('aria-disabled', 'true');
        }
        btn.setAttribute('data-ws-id', ws.id);
        btn.setAttribute('data-ws-name', ws.name);

        btn.innerHTML =
          '<div class="ws-list-row-body">' +
            '<div class="ws-list-row-name">' + ws.name + '</div>' +
            (metaText ? '<div class="ws-list-row-meta">' + metaText + '</div>' : '') +
          '</div>' +
          '<div class="ws-list-row-right">' +
            '<span class="role-badge ' + badgeInfo.cls + '">' + badgeInfo.label + '</span>' +
            (isCurrent ? '<span class="ws-current-pill">Current</span>' : '') +
          '</div>';

        if (!isCurrent) {
          btn.addEventListener('click', function () {
            switchWorkspace(ws.id, ws.name, ws.initials);
          });
        }

        section.appendChild(btn);
      });
    }

    function updateSidebarIdentity(wsId, wsName, wsInitials) {
      var avatarEl = document.getElementById('ws-sidebar-avatar');
      var nameEl   = document.getElementById('ws-sidebar-name');
      if (avatarEl) avatarEl.textContent = wsInitials;
      if (nameEl)   nameEl.textContent   = wsName;
    }

    var _toastTimer = null;
    function showWsToast(wsName) {
      var toast = document.getElementById('ws-switch-toast');
      if (!toast) return;
      toast.textContent = 'Switched to ' + wsName;
      toast.classList.add('is-visible');
      if (_toastTimer) clearTimeout(_toastTimer);
      _toastTimer = setTimeout(function () {
        toast.classList.remove('is-visible');
      }, 2200);
    }

    function switchWorkspace(wsId, wsName, wsInitials) {
      if (wsId === currentWorkspaceId) return;
      currentWorkspaceId = wsId;
      updateSidebarIdentity(wsId, wsName, wsInitials);
      renderWsList(); // re-render to update active state
      closeDropdown();
      showWsToast(wsName);
    }

    // Expose reset for devbar button
    window._resetWorkspace = function () {
      currentWorkspaceId = DEFAULT_WS_ID;
      var def = SARAH_WORKSPACES.find(function (w) { return w.id === DEFAULT_WS_ID; });
      if (def) updateSidebarIdentity(def.id, def.name, def.initials);
      renderWsList();
      closeDropdown();
    };

    // Initial render (deferred so ORG_USERS is available via window._orgUsers)
    setTimeout(function () {
      updateSidebarIdentity(DEFAULT_WS_ID, 'L&D Hub', 'LH');
      renderWsList();
    }, 0);

    // Devbar reset button
    var devResetWs = document.getElementById('dev-reset-workspace');
    if (devResetWs) {
      devResetWs.addEventListener('click', function () {
        window._resetWorkspace();
      });
    }

    // ------- Tabs (Workspace Settings) -------
    var tabsContainers = document.querySelectorAll('.tabs');
    tabsContainers.forEach(function (container) {
      container.addEventListener('click', function (e) {
        var btn = e.target.closest('.tab[data-tab]');
        if (!btn) return;
        var name = btn.getAttribute('data-tab');
        var scope = container.parentElement;
        scope.querySelectorAll('.tab').forEach(function (t) {
          t.classList.toggle('is-active', t === btn);
        });
        scope.querySelectorAll('.tab-panel').forEach(function (p) {
          var on = p.getAttribute('data-tab-panel') === name;
          p.classList.toggle('is-active', on);
          if (on) p.removeAttribute('hidden');
          else p.setAttribute('hidden', '');
        });
      });
    });

    // ------- Modals -------
    function openModal(id) {
      var m = document.getElementById(id);
      if (m) m.classList.add('is-open');
    }
    function closeAllModals() {
      document.querySelectorAll('.modal-overlay.is-open').forEach(function (m) {
        m.classList.remove('is-open');
      });
    }
    document.addEventListener('click', function (e) {
      var action = e.target.closest('[data-action]');
      if (!action) return;
      var a = action.getAttribute('data-action');
      if (a === 'open-add-users') openModal('add-users-modal');
      else if (a === 'open-invite-user') openModal('invite-user-modal');
      else if (a === 'open-edit-profile') openModal('edit-profile-modal');
      else if (a === 'open-add-to-workspace') openModal('add-to-workspace-modal');
      else if (a === 'close-modal') { closeAllModals(); resetTypeahead(); }
      else if (a === 'toggle-ws-dropdown') toggleDropdown();
      else if (a === 'toggle-profile-menu') {
        var menu = document.getElementById('profile-menu');
        if (menu) {
          var isOpen = menu.classList.toggle('is-open');
          action.setAttribute('aria-expanded', String(isOpen));
        }
      }
    });

    // ------- Workspace typeahead (Add to workspace modal) -------
    var WORKSPACES = [
      { value: 'med',        name: 'School of medicine',     desc: 'Clinical simulation and assessment' },
      { value: 'biz',        name: 'School of business',     desc: 'Case studies and MBA programmes' },
      { value: 'eng',        name: 'School of engineering',  desc: 'Technical assessments and labs' },
      { value: 'leadership', name: 'Leadership development', desc: 'Executive and management training' },
      { value: 'hiring',     name: 'Graduate hiring',        desc: 'Campus recruitment assessments' }
    ];
    var tInput     = document.getElementById('ws-typeahead-input');
    var tArea      = document.getElementById('ws-typeahead-area');
    var tDropdown  = document.getElementById('ws-typeahead-dropdown');
    var tClear     = document.getElementById('ws-typeahead-clear');
    var tConfirm   = document.getElementById('add-to-ws-confirm');
    var tSelected  = null;

    function renderTypeahead() {
      if (!tDropdown) return;
      var q = (tInput.value || '').toLowerCase().trim();
      var filtered = WORKSPACES.filter(function (w) {
        return w.name.toLowerCase().indexOf(q) !== -1 || w.desc.toLowerCase().indexOf(q) !== -1;
      });
      tDropdown.innerHTML = '';
      if (!filtered.length) {
        var empty = document.createElement('div');
        empty.className = 'typeahead-empty';
        empty.textContent = 'No workspaces found';
        tDropdown.appendChild(empty);
        return;
      }
      filtered.forEach(function (ws) {
        var opt = document.createElement('div');
        opt.className = 'typeahead-option' + (tSelected && tSelected.value === ws.value ? ' is-active' : '');
        opt.setAttribute('role', 'option');
        opt.innerHTML = '<div class="typeahead-opt-name">' + ws.name + '</div>' +
                        '<div class="typeahead-opt-desc">' + ws.desc + '</div>';
        opt.addEventListener('mousedown', function (e) {
          e.preventDefault();
          selectTypeahead(ws);
        });
        tDropdown.appendChild(opt);
      });
    }
    function selectTypeahead(ws) {
      tSelected = ws;
      if (tInput) tInput.value = ws.name;
      if (tClear) tClear.classList.add('is-visible');
      if (tConfirm) tConfirm.setAttribute('aria-disabled', 'false');
      closeTypeahead();
    }
    function resetTypeahead() {
      tSelected = null;
      if (tInput) tInput.value = '';
      if (tClear) tClear.classList.remove('is-visible');
      if (tConfirm) tConfirm.setAttribute('aria-disabled', 'true');
      closeTypeahead();
    }
    function openTypeahead() {
      if (!tDropdown) return;
      renderTypeahead();
      tDropdown.classList.add('is-open');
      tArea.classList.add('is-focused');
    }
    function closeTypeahead() {
      if (!tDropdown) return;
      tDropdown.classList.remove('is-open');
      tArea.classList.remove('is-focused');
    }
    if (tInput) {
      tInput.addEventListener('focus', openTypeahead);
      tInput.addEventListener('input', function () {
        if (tSelected && tInput.value !== tSelected.name) {
          tSelected = null;
          tClear.classList.remove('is-visible');
          tConfirm.setAttribute('aria-disabled', 'true');
        }
        renderTypeahead();
        tDropdown.classList.add('is-open');
      });
      tInput.addEventListener('blur', function () { setTimeout(closeTypeahead, 150); });
      tInput.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeTypeahead(); tInput.blur(); }
      });
    }
    if (tClear) {
      tClear.addEventListener('mousedown', function (e) {
        e.preventDefault();
        resetTypeahead();
        if (tInput) tInput.focus();
      });
    }
