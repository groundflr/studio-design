</div>

<!-- ==========================================================
     Bulk action bar — Users tab (Section 4)
     Hidden initially; JS shows it when checkboxes are selected.
     ========================================================== -->
<div class="users-bulk-bar" id="users-bulk-bar" aria-live="polite" aria-label="Bulk actions">
  <span class="users-bulk-label" id="users-bulk-label">0 users selected</span>
  <span class="users-bulk-divider"></span>
  <button class="users-bulk-btn" type="button">Change role</button>
  <button class="users-bulk-btn" type="button">Add to workspace</button>
  <button class="users-bulk-btn is-danger" type="button">Deactivate</button>
  <span class="users-bulk-divider"></span>
  <button class="users-bulk-btn users-bulk-clear" id="users-bulk-clear" type="button">Clear</button>
</div>

