            if (checked) {
              wmSelectedIds.add(id);
              row.classList.add('is-selected');
            } else {
              wmSelectedIds.delete(id);
              row.classList.remove('is-selected');
            }
          });
          updateWmBulkBar();
        });
      }

      if (wmBulkClear) {
        wmBulkClear.addEventListener('click', function () { clearWmSelection(); });
      }

      // ---- 5. Invite member CTA → open org-invite-member-modal, pre-fill L&D Hub ----
      var wmInviteBtn = document.getElementById('ws-invite-member-btn');
      if (wmInviteBtn) {
        wmInviteBtn.addEventListener('click', function () {
          // Pre-select L&D Hub in the workspace dropdown
          var wsSelect = document.getElementById('invite-workspace');
          if (wsSelect) wsSelect.value = 'ld-hub';
          if (typeof openOrgModal === 'function') {
            openOrgModal('org-invite-member-modal');
          }
        });
      }

    })();
  })();

  // ============================================================
  // P5 — Welcome hero state (onboarding → dashboard handoff)
  // ============================================================
  (function () {

    // ---- Data ----
    var WORKSPACE_NAME = 'David Guetta';
    var FIRST_NAME     = 'Jane';
    var ADMIN_NAME     = 'Sarah Chen';
    var ADMIN_EMAIL    = 'sarah.chen@traverselearning.co';

    var ROLE_LABELS = {
      standard:  'Standard User',
      moderator: 'Moderator',
      viewer:    'Viewer',
      empty:     'Standard User'
    };

    var HERO_COPY = {
      standard: 'You have Standard User access — you can author, edit, and moderate any content in this workspace.',
      moderator: 'Your workspace admin will assign you to submission groups so you can start grading. ' + ADMIN_NAME + ' manages access for this workspace.',
      viewer: 'Your workspace admin will assign you to content so you can start reviewing. ' + ADMIN_NAME + ' manages access for this workspace.',
      empty: 'It looks like there is no content here yet. ' + ADMIN_NAME + ' can create content to get started.'
    };

    var CTA_LABELS = {
      standard:  'Start exploring',
      moderator: 'Contact ' + ADMIN_NAME,
      viewer:    'Contact ' + ADMIN_NAME,
      empty:     'Contact ' + ADMIN_NAME
    };

    var DISMISS_LABELS = {
      standard: 'Dismiss',
      moderator: 'Got it',
      viewer:    'Got it',
      empty:     'Got it'
    };

    // Storage key factory
    function storageKey(role) {
      return 'traverse.welcomeDismissed.' + (role || 'standard');
    }

    // ---- DOM refs ----
    var hero         = document.getElementById('welcome-hero');
    var placeholder  = document.getElementById('welcome-placeholder');
    var dashShell    = document.getElementById('dashboard-shell');
    var greeting     = document.getElementById('welcome-greeting');
    var roleLine     = document.getElementById('welcome-role-line');
    var copy         = document.getElementById('welcome-copy');
    var ctaBtn       = document.getElementById('welcome-cta');
    var dismissBtn   = document.getElementById('welcome-dismiss');
    var phIcon       = document.getElementById('placeholder-icon');
    var phHeading    = document.getElementById('placeholder-heading');
    var phBody       = document.getElementById('placeholder-body');
    var phCta        = document.getElementById('placeholder-cta');

    // ---- Core render ----
    function renderWelcome(role) {
      if (!hero) return;

      var isTakeover = (role === 'moderator' || role === 'viewer');
      var dismissed  = sessionStorage.getItem(storageKey(role)) === '1';

      // Update devbar active states
      document.querySelectorAll('[data-welcome-role]').forEach(function (btn) {
        btn.classList.toggle('is-active', btn.getAttribute('data-welcome-role') === role);
      });

      if (!role || role === 'off') {
        // Normal dashboard — no hero, no takeover
        hero.classList.add('is-hidden');
        placeholder.classList.remove('is-visible');
        dashShell.classList.remove('is-takeover');
        return;
      }

      // Populate hero content
      greeting.textContent   = 'Welcome to ' + WORKSPACE_NAME + ', ' + FIRST_NAME;
      roleLine.textContent   = 'Joined as ' + (ROLE_LABELS[role] || role);
      copy.textContent       = HERO_COPY[role] || '';
      ctaBtn.textContent     = CTA_LABELS[role] || 'Get started';
      dismissBtn.textContent = DISMISS_LABELS[role] || 'Dismiss';

      // Wire CTA: standard → dismiss hero (href="#", JS handles); mod/viewer/empty → mailto
      if (role === 'moderator' || role === 'viewer' || role === 'empty') {
        ctaBtn.setAttribute('href', 'mailto:' + ADMIN_EMAIL);
        ctaBtn.removeAttribute('role');
      } else {
        ctaBtn.setAttribute('href', '#');
        ctaBtn.setAttribute('role', 'button');
      }

      // Takeover: hide normal cards
      if (isTakeover) {
        dashShell.classList.add('is-takeover');
      } else {
        dashShell.classList.remove('is-takeover');
      }

      // Show/hide hero vs placeholder
      if (dismissed && isTakeover) {
        // Post-dismiss state: show placeholder, hide hero
        hero.classList.add('is-hidden');
        showPlaceholder(role);
      } else if (dismissed && !isTakeover) {
        // Standard/empty dismissed — just hide hero, cards show normally
        hero.classList.add('is-hidden');
        placeholder.classList.remove('is-visible');
      } else {
        // Not dismissed: show hero
        hero.classList.remove('is-hidden');
        placeholder.classList.remove('is-visible');
      }
    }

    function showPlaceholder(role) {
      if (role === 'moderator') {
        phIcon.className    = 'icon-clipboard-list';
        phHeading.textContent = 'No submission groups assigned yet';
        phBody.textContent  = 'Your workspace admin will assign you to submission groups once everything is set up.';
      } else {
        phIcon.className    = 'icon-eye';
        phHeading.textContent = 'No content assigned yet';
        phBody.textContent  = 'Your workspace admin will assign you to content so you can start reviewing.';
      }
      phCta.textContent    = 'Contact ' + ADMIN_NAME;
      phCta.setAttribute('href', 'mailto:' + ADMIN_EMAIL);
      placeholder.classList.add('is-visible');
    }

    // ---- Dismiss logic ----
    function dismiss(role) {
      sessionStorage.setItem(storageKey(role), '1');
      renderWelcome(role);
    }

    // ---- Read URL params and initialise ----
    function getUrlParams() {
      var params = new URLSearchParams(location.search);
      return {
        welcome: params.get('welcome'),
        role:    params.get('role') || 'standard'
      };
    }

    function setUrlWelcome(role) {
      var params = new URLSearchParams(location.search);
      if (role === 'off') {
        params.delete('welcome');
        params.delete('role');
      } else {
        params.set('welcome', '1');
        params.set('role', role);
      }
      history.replaceState(null, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
    }

    function init() {
      var p = getUrlParams();
      if (p.welcome === '1') {
        renderWelcome(p.role);
      } else {
        renderWelcome('off');
      }
    }

    // ---- Event handlers ----

    // Dismiss button
    if (dismissBtn) {
      dismissBtn.addEventListener('click', function () {
        var p = getUrlParams();
        dismiss(p.role);
      });
      dismissBtn.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          dismissBtn.click();
        }
      });
    }

    // Primary CTA (standard = dismiss; mod/viewer/empty = mailto handled by href)
    if (ctaBtn) {
      ctaBtn.addEventListener('click', function (e) {
        var p = getUrlParams();
        if (p.role !== 'moderator' && p.role !== 'viewer' && p.role !== 'empty') {
          // "Start exploring" — dismiss and prevent page jump
          e.preventDefault();
          dismiss(p.role);
        }
        // For moderator/viewer/empty, the mailto href opens the mail client naturally
      });
    }

    // Devbar welcome state buttons
    document.querySelectorAll('[data-welcome-role]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var role = btn.getAttribute('data-welcome-role');
        if (role === 'off') {
          setUrlWelcome('off');
          renderWelcome('off');
        } else {
          // Clear dismiss so the hero always shows on devbar switch
          sessionStorage.removeItem(storageKey(role));
          setUrlWelcome(role);
          renderWelcome(role);
        }
      });
    });

    // Reset dismiss button
    var resetBtn = document.getElementById('wb-reset-dismiss');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        var p = getUrlParams();
        if (p.role && p.role !== 'off') {
          sessionStorage.removeItem(storageKey(p.role));
          renderWelcome(p.role);
        }
      });
    }

    // Run on load
    init();

  })();
</script>

