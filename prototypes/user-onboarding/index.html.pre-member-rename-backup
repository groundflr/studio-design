  <span class="dev-label flow-hidden" id="devbar-step-label-ex">Step</span>
  <button class="dev-btn flow-hidden" data-nav-ex-step="ex-1" data-flow-step="existing">1 · Invite</button>
  <button class="dev-btn flow-hidden" data-nav-ex-step="ex-2" data-flow-step="existing">2 · Welcome</button>
  <span class="dev-divider"></span>
  <span class="dev-label">Welcome variant</span>
  <button class="dev-btn is-active" data-welcome-variant="standard">Standard</button>
  <button class="dev-btn" data-welcome-variant="moderator">Moderator (unassigned)</button>
  <button class="dev-btn" data-welcome-variant="viewer">Viewer (unassigned)</button>
  <button class="dev-btn" data-welcome-variant="empty">Empty workspace</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-action="reset">Reset state</button>
  <span class="dev-spacer"></span>
  <button class="dev-btn" data-action="prefill-signup">Prefill sign-up</button>
