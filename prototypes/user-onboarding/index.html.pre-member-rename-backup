  <button class="dev-btn" data-flow="existing-user">Existing user joining workspace (2-step)</button>
  <span class="dev-divider"></span>
  <!-- Step buttons for new-user flow -->
  <span class="dev-label" id="devbar-step-label-new">Step</span>
  <button class="dev-btn is-active" data-nav-step="1" data-flow-step="new">1 · Invite</button>
  <button class="dev-btn" data-nav-step="2" data-flow-step="new">2 · Sign up</button>
  <button class="dev-btn" data-nav-step="3" data-flow-step="new">3 · Verify</button>
  <button class="dev-btn" data-nav-step="4" data-flow-step="new">4 · Profile</button>
  <button class="dev-btn" data-nav-step="5" data-flow-step="new">5 · Welcome</button>
