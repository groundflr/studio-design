<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Join Traverse Studio — Onboarding</title>

  <link rel="stylesheet" href="../../colors_and_type.css">
  <link rel="stylesheet" href="https://unpkg.com/lucide-static@0.453.0/font/lucide.css">

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      color: var(--surface-900);
      background-color: var(--surface-50);
      /* Dotted grid background — matches the login launch screen.
         Small dots in surface-200 on a surface-50 canvas, 16px grid. */
      background-image: radial-gradient(circle, var(--surface-200) 1px, transparent 1.2px);
      background-size: 18px 18px;
      background-position: 0 0;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }
    button { font-family: inherit; cursor: pointer; border: 0; background: transparent; padding: 0; color: inherit; }
    a { color: inherit; text-decoration: none; }
    input, textarea, select { font-family: inherit; }

    /* ============================================================
       Shell
       ============================================================ */
    .ob-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 24px 88px;
    }
    /* Wordmark anchored to the viewport top-left, matching the login launch
       screen. Sits above the centred onboarding content; doesn't push it down. */
    .ob-wordmark {
      position: fixed;
      top: 20px;
      left: 24px;
      height: 24px;
      z-index: 10;
    }

    /* ============================================================
       Progress stepper
       ============================================================ */
    .progress-stepper {
      width: 100%;
      max-width: 520px;
      margin-bottom: 28px;
    }
    .progress-track {
      display: grid;
      grid-template-columns: 14px 1fr 14px 1fr 14px 1fr 14px 1fr 14px;
      align-items: center;
    }
    .progress-dot {
      width: 14px; height: 14px;
      border-radius: 999px;
      background: var(--surface-200);
      transition: background 160ms, box-shadow 160ms;
      position: relative;
    }
    .progress-dot.is-done {
      background: var(--success-500);
    }
    .progress-dot.is-done::after {
      content: "";
      position: absolute;
      inset: 3px;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
      background-size: contain;
      background-repeat: no-repeat;
      background-position: center;
    }
    .progress-dot.is-active {
      background: var(--primary-600);
      box-shadow: 0 0 0 4px var(--primary-100);
    }
    .progress-line {
      height: 2px;
      background: var(--surface-200);
      transition: background 160ms;
    }
    .progress-line.is-done { background: var(--success-500); }

    .progress-labels {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      margin-top: 10px;
      text-align: center;
    }
    .progress-labels span {
      font: 500 11px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .progress-labels span.is-done   { color: var(--success-600); }
    .progress-labels span.is-active { color: var(--primary-700); font-weight: 600; }

    /* ============================================================
       Step card (shared)
       ============================================================ */
    .step {
      display: none;
      width: 100%;
      max-width: 480px;
    }
    .step.is-active { display: block; }

    .ob-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      padding: 32px;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.04);
    }
    .ob-card.is-centered { text-align: center; }

    .card-title {
      font: 600 22px/1.3 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 0 0 8px;
    }
    .card-sub {
      font: 400 14px/1.55 var(--font-sans);
      color: var(--surface-600);
      margin: 0 0 24px;
    }

    /* ============================================================
       Email card (Step 1)
       ============================================================ */
    .email-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.04);
    }
    .email-header {
      background: var(--primary-600);
      padding: 28px 32px;
      text-align: center;
    }
    .email-header img {
      height: 26px;
      filter: brightness(0) invert(1);
    }
    .email-body { padding: 32px; }
    .email-greeting {
      font: 600 22px/1.3 var(--font-sans);
      color: var(--surface-900);
      margin: 0 0 12px;
    }
    .email-copy {
      font: 400 14px/1.7 var(--font-sans);
      color: var(--surface-600);
      margin: 0 0 20px;
    }
    .email-copy strong { color: var(--surface-900); }
    .email-invite-block {
      background: var(--surface-50);
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      padding: 14px 18px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .email-invite-icon {
      width: 44px; height: 44px;
      border-radius: 10px;
      background: var(--primary-100);
      color: var(--primary-700);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 20px;
    }
    .email-invite-name {
      font: 600 14px var(--font-sans);
      color: var(--surface-900);
      margin-bottom: 2px;
    }
    .email-invite-meta {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
    }
    .email-cta-wrap { text-align: center; margin-bottom: 18px; }
    .email-or {
      text-align: center;
      font: 500 12px var(--font-sans);
      color: var(--surface-400);
      margin-bottom: 12px;
      letter-spacing: 0.04em;
    }
    .email-login-link {
      display: block;
      text-align: center;
      font: 500 13px var(--font-sans);
      color: var(--primary-600);
      cursor: pointer;
    }
    .email-login-link:hover { text-decoration: underline; }
    .email-footer {
      border-top: 1px solid var(--surface-100);
      padding: 20px 32px;
      text-align: center;
      font: 400 11px/1.6 var(--font-sans);
      color: var(--surface-400);
    }
    .email-footer a { color: var(--surface-500); text-decoration: underline; cursor: pointer; }
    .email-footer strong { color: var(--surface-700); }

    /* ============================================================
       Buttons
       ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 10px;
      font: 600 14px var(--font-sans);
      cursor: pointer;
      transition: background 120ms, border-color 120ms, color 120ms, opacity 120ms;
      border: 1px solid transparent;
    }
    .btn i { font-size: 16px; }
    .btn-primary {
      background: var(--primary-600);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary-700); }
    .btn-secondary {
      background: #fff;
      border-color: var(--surface-200);
      color: var(--surface-800);
    }
    .btn-secondary:hover { background: var(--surface-50); border-color: var(--surface-300); }
    .btn-full { width: 100%; }
    .btn[aria-disabled="true"],
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-google {
      width: 100%;
      padding: 12px 16px;
      background: #fff;
      border: 1px solid var(--surface-300);
      border-radius: 10px;
      font: 500 14px var(--font-sans);
      color: var(--surface-900);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      transition: background 120ms, border-color 120ms;
    }
    .btn-google:hover { background: var(--surface-50); border-color: var(--surface-400); }

    .or-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0;
      font: 500 12px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.06em;
    }
    .or-divider::before,
    .or-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--surface-200);
    }

    /* ============================================================
       Form
       ============================================================ */
    .field-group { margin-bottom: 14px; }
    .field-group:last-of-type { margin-bottom: 0; }
    .field-label {
      display: block;
      font: 600 13px var(--font-sans);
      color: var(--surface-900);
      margin-bottom: 6px;
    }
    .field-label .req  { color: var(--error-500); margin-left: 2px; }
    .field-label .opt  { color: var(--surface-400); font-weight: 400; margin-left: 4px; }
    .field-hint {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin: 6px 0 0;
    }
    .text-input {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      transition: border-color 120ms, box-shadow 120ms;
    }
    .text-input::placeholder { color: var(--surface-400); }
    .text-input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .text-input[readonly] {
      background: var(--surface-50);
      color: var(--surface-500);
      cursor: default;
    }
    .textarea-input {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      resize: vertical;
      min-height: 88px;
      transition: border-color 120ms, box-shadow 120ms;
    }
    .textarea-input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .name-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }

    /* Password input + eye toggle */
    .password-wrap { position: relative; }
    .password-wrap .text-input { padding-right: 44px; }
    .password-eye {
      position: absolute;
      right: 4px; top: 50%;
      transform: translateY(-50%);
      width: 36px; height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      color: var(--surface-400);
      transition: background 120ms, color 120ms;
    }
    .password-eye:hover {
      background: var(--surface-100);
      color: var(--surface-700);
    }
    .password-eye i { font-size: 16px; }

    /* Password strength meter */
    .pw-strength { margin-top: 8px; }
    .pw-bar {
      height: 4px;
      background: var(--surface-200);
      border-radius: 2px;
      overflow: hidden;
    }
    .pw-fill {
      height: 100%;
      width: 0%;
      background: var(--surface-300);
      border-radius: 2px;
      transition: width 200ms, background 200ms;
    }
    .pw-fill.is-weak   { background: var(--error-500); }
    .pw-fill.is-medium { background: var(--warn-500); }
    .pw-fill.is-strong { background: var(--success-500); }
    .pw-label {
      font: 500 11px var(--font-sans);
      color: var(--surface-400);
      margin-top: 4px;
    }
    .pw-label.is-weak   { color: var(--error-500); }
    .pw-label.is-medium { color: var(--warn-600); }
    .pw-label.is-strong { color: var(--success-600); }

    /* Terms checkbox */
    .terms-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 16px 0 18px;
      font: 400 12px/1.5 var(--font-sans);
      color: var(--surface-600);
    }
    .terms-row input[type="checkbox"] {
      width: 16px; height: 16px;
      accent-color: var(--primary-600);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .terms-row a {
      color: var(--primary-600);
      cursor: pointer;
    }
    .terms-row a:hover { text-decoration: underline; }

    .login-row {
      font: 400 13px var(--font-sans);
      color: var(--surface-600);
      margin-top: 14px;
      text-align: center;
    }
    .login-row a {
      color: var(--primary-600);
      font-weight: 600;
      cursor: pointer;
    }
    .login-row a:hover { text-decoration: underline; }

    /* ============================================================
       Verify code
       ============================================================ */
    .verify-icon {
      width: 64px; height: 64px;
      border-radius: 999px;
      background: var(--primary-100);
      color: var(--primary-600);
      border: 1px solid var(--primary-200);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 26px;
    }
    .code-inputs {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin: 0 0 22px;
    }
    .code-box {
      width: 48px; height: 56px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      text-align: center;
      font: 600 22px var(--font-sans);
      color: var(--surface-900);
      background: #fff;
      transition: border-color 120ms, box-shadow 120ms, background 120ms;
    }
    .code-box:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .code-box.is-filled {
      background: var(--primary-100);
      border-color: var(--primary-400);
      color: var(--primary-800);
    }
    .resend-row {
      text-align: center;
      font: 400 13px var(--font-sans);
      color: var(--surface-600);
      margin-bottom: 22px;
    }
    .resend-link {
      color: var(--primary-600);
      font-weight: 600;
      cursor: pointer;
    }
    .resend-link:hover { text-decoration: underline; }

    /* ============================================================
       Profile (avatar)
       ============================================================ */
    .avatar-upload {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 22px;
    }
    .avatar-circle {
      width: 88px; height: 88px;
      border-radius: 999px;
      background: var(--primary-50);
      border: 2px dashed var(--primary-200);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-bottom: 10px;
      overflow: hidden;
      color: var(--primary-600);
      transition: background 120ms, border-color 120ms;
    }
    .avatar-circle:hover {
      border-color: var(--primary-400);
      background: var(--primary-100);
    }
    .avatar-circle i { font-size: 24px; }
    .avatar-circle img {
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .avatar-circle.has-image { border-style: solid; border-color: var(--primary-400); }
    .avatar-link {
      font: 500 13px var(--font-sans);
      color: var(--primary-600);
      cursor: pointer;
    }
    .avatar-link:hover { text-decoration: underline; }

    /* ============================================================
       Welcome
       ============================================================ */
    .check-circle {
      width: 72px; height: 72px;
      border-radius: 999px;
      background: var(--success-100);
      color: var(--success-600);
      border: 2px solid var(--success-500);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 22px;
    }
    .check-circle i { font-size: 36px; }

    /* ============================================================
       Welcome — handoff card
       ============================================================ */

    /* Role hint shown on Step 5 to reflect the selected devbar variant */
    .welcome-role-hint {
      display: inline-block;
      font: 500 13px var(--font-sans);
      color: var(--surface-500);
      background: var(--surface-100);
      border: 1px solid var(--surface-200);
      border-radius: 8px;
      padding: 5px 12px;
      margin: 0 0 20px;
    }

    /* ============================================================
       Step nav (back link)
       ============================================================ */
    .step-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font: 500 13px var(--font-sans);
      color: var(--surface-500);
      margin-bottom: 16px;
      cursor: pointer;
      transition: color 120ms;
    }
    .step-back:hover { color: var(--primary-600); }
    .step-back i { font-size: 14px; }

    /* ============================================================
       Flow visibility (Part 2)
       ============================================================ */
    /* Hides steps/steppers that belong to the inactive flow */
    .flow-hidden { display: none !important; }

    /* 2-step progress indicator — 2 dots with 1 connecting line */
    .progress-stepper-2step {
      width: 100%;
      max-width: 520px;
      margin-bottom: 28px;
    }
    .progress-track-2step {
      display: grid;
      grid-template-columns: 14px 1fr 14px;
      align-items: center;
    }
    .progress-labels-2step {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: 10px;
      text-align: center;
    }
    .progress-labels-2step span {
      font: 500 11px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .progress-labels-2step span.is-done   { color: var(--success-600); }
    .progress-labels-2step span.is-active { color: var(--primary-700); font-weight: 600; }

    /* Info block — existing user notice on ex-1 */
    .info-block {
      background: var(--surface-50);
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 20px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .info-block i {
      font-size: 16px;
      color: var(--surface-500);
      flex-shrink: 0;
      margin-top: 1px;
    }
    .info-block-copy {
      font: 400 13px/1.5 var(--font-sans);
      color: var(--surface-600);
    }

    /* ============================================================
       Devbar (prototype controls)
       ============================================================ */
    .devbar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--surface-900);
      color: #fff;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 100;
      font: 500 12px var(--font-sans);
      box-shadow: 0 -6px 20px -8px rgba(15, 23, 42, 0.35);
    }
    .devbar .dev-label {
      color: rgba(255,255,255,0.55);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 11px;
      margin-right: 6px;
    }
    .devbar .dev-btn {
      padding: 6px 10px;
      border-radius: 6px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      cursor: pointer;
      transition: background 120ms;
    }
    .devbar .dev-btn:hover { background: rgba(255,255,255,0.16); }
    .devbar .dev-btn.is-active { background: var(--primary-500); }
    .devbar .dev-divider {
      width: 1px;
      height: 18px;
      background: rgba(255,255,255,0.18);
      margin: 0 4px;
    }
    .devbar .dev-spacer { flex: 1; }

    /* ---------- Devbar group dropdowns (auto-wrapped at runtime) ---------- */
    .devbar .dev-dd { position: relative; display: inline-flex; }
    .devbar .dev-dd-trigger {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 10px;
      border-radius: 6px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      font: 500 12px var(--font-sans);
      cursor: pointer;
      transition: background 120ms;
    }
    .devbar .dev-dd-trigger:hover { background: rgba(255,255,255,0.16); }
    .devbar .dev-dd-trigger[aria-expanded="true"] { background: rgba(255,255,255,0.16); }
    .devbar .dev-dd-trigger-label {
      color: rgba(255,255,255,0.55);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 11px;
    }
    .devbar .dev-dd-trigger-value { color: #fff; font-weight: 500; }
    .devbar .dev-dd-trigger-value:not(:empty)::before {
      content: '·';
      margin-right: 6px;
      color: rgba(255,255,255,0.4);
    }
    .devbar .dev-dd-trigger-caret { font-size: 9px; opacity: 0.7; }
    .devbar .dev-dd-menu {
      display: none;
      position: absolute;
      bottom: calc(100% + 6px);
      left: 0;
      min-width: 200px;
      max-height: 60vh;
      overflow-y: auto;
      background: var(--surface-900);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      padding: 4px;
      box-shadow: 0 -6px 20px -4px rgba(0,0,0,0.4);
      z-index: 200;
    }
    .devbar .dev-dd-menu.is-open { display: block; }
    .devbar .dev-dd-item {
      display: block;
      width: 100%;
      text-align: left;
      padding: 7px 10px;
      border-radius: 5px;
      background: transparent;
      color: rgba(255,255,255,0.9);
      font: 500 12px var(--font-sans);
      cursor: pointer;
      transition: background 100ms;
    }
    .devbar .dev-dd-item:hover { background: rgba(255,255,255,0.12); }
    .devbar .dev-dd-item.is-active { background: var(--primary-500); color: #fff; }
  </style>
</head>
<body>

<div class="ob-shell">

  <img class="ob-wordmark" src="../../public/logo/studio_full_light.svg" alt="Traverse Studio">

  <!-- ============ Progress stepper — 5-step (new user) ============ -->
  <div class="progress-stepper" id="stepper-5step">
    <div class="progress-track">
      <span class="progress-dot is-active" data-progress-dot="1"></span>
      <span class="progress-line" data-progress-line="1-2"></span>
      <span class="progress-dot" data-progress-dot="2"></span>
      <span class="progress-line" data-progress-line="2-3"></span>
      <span class="progress-dot" data-progress-dot="3"></span>
      <span class="progress-line" data-progress-line="3-4"></span>
      <span class="progress-dot" data-progress-dot="4"></span>
      <span class="progress-line" data-progress-line="4-5"></span>
      <span class="progress-dot" data-progress-dot="5"></span>
    </div>
    <div class="progress-labels">
      <span class="is-active" data-progress-label="1">Invite</span>
      <span data-progress-label="2">Sign up</span>
      <span data-progress-label="3">Verify</span>
