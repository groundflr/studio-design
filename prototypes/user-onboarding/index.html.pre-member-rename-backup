<script>
(function () {
  var TOTAL_STEPS = 5;
  var currentStep = 1;
  // Track which steps have been completed so the progress dots can flip to "done"
  var doneSteps = new Set();

  // ----- DOM -----
  var steps = document.querySelectorAll('.step');
  var dots = document.querySelectorAll('[data-progress-dot]');
  var lines = document.querySelectorAll('[data-progress-line]');
  var labels = document.querySelectorAll('[data-progress-label]');
  var devBtns = document.querySelectorAll('.devbar .dev-btn[data-nav-step]');

  // ----- Step switching -----
  function setStep(n) {
    if (n < 1 || n > TOTAL_STEPS) return;
    if (n > currentStep) {
      // Mark every step we've moved past as done
      for (var i = currentStep; i < n; i++) doneSteps.add(i);
    }
    currentStep = n;
    steps.forEach(function (s) {
      s.classList.toggle('is-active', parseInt(s.getAttribute('data-step'), 10) === n);
    });
    updateProgress();
    updateDevbar();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress() {
    dots.forEach(function (d) {
      var i = parseInt(d.getAttribute('data-progress-dot'), 10);
      d.classList.toggle('is-done', doneSteps.has(i));
      d.classList.toggle('is-active', i === currentStep);
    });
    lines.forEach(function (l) {
      var pair = l.getAttribute('data-progress-line').split('-').map(Number);
      l.classList.toggle('is-done', doneSteps.has(pair[0]));
    });
    labels.forEach(function (lbl) {
      var i = parseInt(lbl.getAttribute('data-progress-label'), 10);
      lbl.classList.toggle('is-done', doneSteps.has(i) && i !== currentStep);
      lbl.classList.toggle('is-active', i === currentStep);
    });
  }

  function updateDevbar() {
    devBtns.forEach(function (b) {
      b.classList.toggle('is-active', parseInt(b.getAttribute('data-nav-step'), 10) === currentStep);
    });
  }

  // ----- Welcome variant switching -----
  // The variant now controls which `role` query param the CTA passes to the dashboard,
  // rather than changing inline content. A small hint on the Step 5 card shows the selected role.
  var currentVariant = 'standard';

  var VARIANT_CONFIG = {
    'standard':  { label: 'Standard User',  routeRole: 'standard'  },
    'moderator': { label: 'Moderator',       routeRole: 'moderator' },
    'viewer':    { label: 'Viewer',          routeRole: 'viewer'    },
    'empty':     { label: 'Standard User',   routeRole: 'empty'     }
  };

  function setWelcomeVariant(v) {
    if (!VARIANT_CONFIG[v]) return;
    currentVariant = v;
    var cfg = VARIANT_CONFIG[v];

    // Update the role hint on the Step 5 card (new-user flow)
    var hint = document.getElementById('welcome-role-label');
    if (hint) hint.textContent = cfg.label;

    // Update the role hint on Step ex-2 card (existing-user flow) — same label, "· Cross-workspace" suffix is static HTML
    var exHint = document.getElementById('ex-welcome-role-label');
    if (exHint) exHint.textContent = cfg.label;

    // Update devbar variant buttons
    document.querySelectorAll('[data-welcome-variant]').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-welcome-variant') === v);
    });
  }

  // ----- Flow switching (Part 2) -----
  var activeFlow = 'new-user'; // 'new-user' | 'existing-user'
  var currentExStep = 'ex-1'; // active step within the existing-user flow

  function setActiveFlow(flowName) {
    activeFlow = flowName;
    var isNew = (flowName === 'new-user');

    // Show/hide flow-specific step sections
    document.querySelectorAll('.step[data-flow="existing"]').forEach(function (s) {
      s.classList.toggle('flow-hidden', isNew);
      // When switching to existing flow, make ex-1 active; clear is-active on all
      if (!isNew) s.classList.remove('is-active');
    });

    // New-user steps: hide them when existing flow is active
    document.querySelectorAll('.step:not([data-flow="existing"])').forEach(function (s) {
      s.classList.toggle('flow-hidden', !isNew);
    });

    // Show/hide the correct progress stepper
    var stepper5 = document.getElementById('stepper-5step');
    var stepper2 = document.getElementById('stepper-2step');
    if (stepper5) stepper5.classList.toggle('flow-hidden', !isNew);
    if (stepper2) stepper2.classList.toggle('flow-hidden', isNew);

    // Show/hide devbar step groups
    var devStepLabelNew = document.getElementById('devbar-step-label-new');
    var devStepLabelEx  = document.getElementById('devbar-step-label-ex');
    if (devStepLabelNew) devStepLabelNew.classList.toggle('flow-hidden', !isNew);
    if (devStepLabelEx)  devStepLabelEx.classList.toggle('flow-hidden', isNew);
    document.querySelectorAll('[data-flow-step="new"]').forEach(function (b) {
      b.classList.toggle('flow-hidden', !isNew);
    });
    document.querySelectorAll('[data-flow-step="existing"]').forEach(function (b) {
      b.classList.toggle('flow-hidden', isNew);
    });

    // Update flow devbar button active states
    document.querySelectorAll('[data-flow]').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-flow') === flowName);
    });

    // Reset to step 1 of whichever flow is now active
    if (isNew) {
      doneSteps = new Set();
      setStep(1);
    } else {
      setExStep('ex-1');
    }
  }

  // ----- Existing-user step navigation -----
  function setExStep(stepId) {
    currentExStep = stepId;
    // Show only the target step within the existing flow
    document.querySelectorAll('.step[data-flow="existing"]').forEach(function (s) {
      var match = s.getAttribute('data-step') === stepId;
      s.classList.toggle('is-active', match);
      s.classList.remove('flow-hidden'); // already visible because flow is active
    });
    // Update 2-step progress indicator
    var isDone1 = (stepId === 'ex-2');
    var dot1 = document.getElementById('ex-dot-1');
    var dot2 = document.getElementById('ex-dot-2');
    var line  = document.getElementById('ex-line-1-2');
    var lbl1  = document.getElementById('ex-label-1');
    var lbl2  = document.getElementById('ex-label-2');
    if (dot1) {
      dot1.classList.toggle('is-done', isDone1);
      dot1.classList.toggle('is-active', !isDone1);
    }
    if (dot2) {
      dot2.classList.toggle('is-active', isDone1);
    }
    if (line)  line.classList.toggle('is-done', isDone1);
    if (lbl1)  { lbl1.classList.toggle('is-done', isDone1); lbl1.classList.toggle('is-active', !isDone1); }
    if (lbl2)  { lbl2.classList.toggle('is-active', isDone1); }
    // Update devbar ex step buttons
    document.querySelectorAll('[data-nav-ex-step]').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-nav-ex-step') === stepId);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ----- Navigation listeners -----
  document.addEventListener('click', function (e) {
    // Flow toggle buttons
    var flowBtn = e.target.closest('[data-flow]:not([data-flow-step])');
    if (flowBtn && flowBtn.closest('.devbar')) {
      e.preventDefault();
      setActiveFlow(flowBtn.getAttribute('data-flow'));
      return;
    }

    // Welcome variant buttons
    var variantBtn = e.target.closest('[data-welcome-variant]');
    if (variantBtn) {
      e.preventDefault();
      setWelcomeVariant(variantBtn.getAttribute('data-welcome-variant'));
      // Jump to the welcome step of whichever flow is active
      if (activeFlow === 'existing-user') {
        setExStep('ex-2');
      } else {
        setStep(5);
      }
      return;
    }

    // New-user step nav buttons (devbar)
    var navBtn = e.target.closest('[data-nav-step]');
    if (navBtn) {
      e.preventDefault();
      setStep(parseInt(navBtn.getAttribute('data-nav-step'), 10));
      return;
    }

    // Existing-user step nav buttons (devbar)
    var exNavBtn = e.target.closest('[data-nav-ex-step]');
    if (exNavBtn) {
      e.preventDefault();
      setExStep(exNavBtn.getAttribute('data-nav-ex-step'));
      return;
    }

    var action = e.target.closest('[data-action]');
    if (!action) return;
    var a = action.getAttribute('data-action');
    if (a === 'accept-invite') { setStep(2); }
    else if (a === 'google-sso') {
      // Google handles auth + verification, fast-track to profile
      doneSteps.add(2); doneSteps.add(3);
      setStep(4);
    }
    else if (a === 'resend-code') {
      var link = document.getElementById('resend-link');
      if (link) {
        var original = link.textContent;
        link.textContent = 'Code resent';
        link.style.pointerEvents = 'none';
        setTimeout(function () {
          link.textContent = original;
          link.style.pointerEvents = '';
        }, 2500);
      }
    }
    else if (a === 'trigger-avatar') {
      document.getElementById('avatar-file').click();
    }
    else if (a === 'go-to-workspace') {
      // Route to dashboard with welcome state query params (new-user flow)
      var role = (VARIANT_CONFIG[currentVariant] || VARIANT_CONFIG['standard']).routeRole;
      window.location.href = '../dashboard/?welcome=1&role=' + role;
    }
    else if (a === 'ex-go-to-workspace') {
      // Step 1 of existing-user flow — advance to step 2 (welcome handoff)
      setExStep('ex-2');
    }
    else if (a === 'ex-go-to-dashboard') {
      // Route to dashboard with welcome state query params (existing-user flow)
      var role = (VARIANT_CONFIG[currentVariant] || VARIANT_CONFIG['standard']).routeRole;
      window.location.href = '../dashboard/?welcome=1&role=' + role;
    }
    else if (a === 'reset') {
      doneSteps = new Set();
      resetSignupForm();
      resetCodeBoxes();
      resetProfileForm();
      resetAvatar();
      // Reset to new-user flow step 1
      if (activeFlow === 'existing-user') {
        setActiveFlow('new-user');
      } else {
        setStep(1);
      }
    }
    else if (a === 'prefill-signup') {
      prefillSignup();
    }
  });

  // ----- Password show/hide -----
  document.addEventListener('click', function (e) {
    var eye = e.target.closest('[data-toggle-password]');
    if (!eye) return;
    var id = eye.getAttribute('data-toggle-password');
    var input = document.getElementById(id);
    if (!input) return;
    var icon = eye.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      if (icon) icon.className = 'icon-eye-off';
      eye.setAttribute('aria-label', 'Hide password');
    } else {
      input.type = 'password';
      if (icon) icon.className = 'icon-eye';
      eye.setAttribute('aria-label', 'Show password');
    }
  });

  // ----- Sign-up form: validation, strength meter, continue gating -----
  var suFirst    = document.getElementById('su-first');
  var suLast     = document.getElementById('su-last');
  var suPassword = document.getElementById('su-password');
  var suConfirm  = document.getElementById('su-confirm');
  var suTerms    = document.getElementById('su-terms');
  var suContinue = document.getElementById('su-continue');
  var pwFill     = document.getElementById('su-pw-fill');
  var pwLabel    = document.getElementById('su-pw-label');
  var confirmHint = document.getElementById('su-confirm-hint');
  var signupForm = document.getElementById('signup-form');

  function passwordStrength(pw) {
    if (!pw) return { score: 0, label: 'Enter a password', cls: '' };
    var score = 0;
    if (pw.length >= 8) score++;
    if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
    if (/\d/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    if (pw.length >= 12) score++;
    if (score <= 1) return { score: score, label: 'Weak — keep going', cls: 'is-weak', pct: 20 };
    if (score <= 3) return { score: score, label: 'Medium — try adding a symbol', cls: 'is-medium', pct: 60 };
    return { score: score, label: 'Strong password', cls: 'is-strong', pct: 100 };
  }

  function updatePasswordMeter() {
    var pw = suPassword.value;
    var r = passwordStrength(pw);
    pwFill.style.width = (r.pct || 0) + '%';
    pwFill.className = 'pw-fill' + (r.cls ? ' ' + r.cls : '');
    pwLabel.textContent = r.label;
    pwLabel.className = 'pw-label' + (r.cls ? ' ' + r.cls : '');
  }

  function updateConfirmHint() {
    if (!suConfirm.value) {
      confirmHint.hidden = true;
      return;
    }
    if (suConfirm.value === suPassword.value) {
      confirmHint.textContent = 'Passwords match.';
      confirmHint.style.color = 'var(--success-600)';
    } else {
      confirmHint.textContent = 'Passwords don\'t match yet.';
      confirmHint.style.color = 'var(--error-500)';
    }
    confirmHint.hidden = false;
  }

  function updateSignupContinue() {
    var ok = !!suFirst.value.trim() &&
             !!suLast.value.trim() &&
             suPassword.value.length >= 8 &&
             suPassword.value === suConfirm.value &&
             suTerms.checked;
    suContinue.disabled = !ok;
    suContinue.setAttribute('aria-disabled', String(!ok));
  }

  [suFirst, suLast, suPassword, suConfirm].forEach(function (input) {
    input.addEventListener('input', function () {
      if (input === suPassword) { updatePasswordMeter(); updateConfirmHint(); }
      if (input === suConfirm) updateConfirmHint();
      updateSignupContinue();
    });
  });
  suTerms.addEventListener('change', updateSignupContinue);

  signupForm.addEventListener('submit', function (e) {
    e.preventDefault();
    if (suContinue.disabled) return;
    // Remember first name for the welcome step
    document.querySelectorAll('[data-welcome-first]').forEach(function (el) {
      el.textContent = suFirst.value.trim() || 'Jane';
    });
    setStep(3);
  });

  function resetSignupForm() {
    [suFirst, suLast, suPassword, suConfirm].forEach(function (i) { i.value = ''; });
    suTerms.checked = false;
    updatePasswordMeter();
    updateConfirmHint();
    updateSignupContinue();
  }

  function prefillSignup() {
    suFirst.value = 'Jane';
    suLast.value = 'Smith';
    suPassword.value = 'Tr@verse2026!';
    suConfirm.value = 'Tr@verse2026!';
    suTerms.checked = true;
    updatePasswordMeter();
    updateConfirmHint();
    updateSignupContinue();
    document.querySelectorAll('[data-welcome-first]').forEach(function (el) { el.textContent = 'Jane'; });
  }

  // ----- Verify code: auto-advance + backspace + complete gating -----
  var codeBoxes = document.querySelectorAll('.code-box');
  var verifyContinue = document.getElementById('verify-continue');

  function codeComplete() {
    return Array.from(codeBoxes).every(function (b) { return b.value.length === 1; });
  }
  function updateVerifyContinue() {
    var ok = codeComplete();
    verifyContinue.disabled = !ok;
    verifyContinue.setAttribute('aria-disabled', String(!ok));
  }

  codeBoxes.forEach(function (box, idx) {
    box.addEventListener('input', function (e) {
      // Allow only digits
      var v = box.value.replace(/\D/g, '');
      box.value = v.charAt(0) || '';
      box.classList.toggle('is-filled', !!box.value);
      if (box.value && idx < codeBoxes.length - 1) {
        codeBoxes[idx + 1].focus();
      }
      updateVerifyContinue();
    });
    box.addEventListener('keydown', function (e) {
      if (e.key === 'Backspace' && !box.value && idx > 0) {
        codeBoxes[idx - 1].focus();
        codeBoxes[idx - 1].value = '';
        codeBoxes[idx - 1].classList.remove('is-filled');
        updateVerifyContinue();
      }
    });
    box.addEventListener('paste', function (e) {
      var pasted = (e.clipboardData || window.clipboardData).getData('text');
      var digits = pasted.replace(/\D/g, '').split('').slice(0, codeBoxes.length - idx);
      if (!digits.length) return;
      e.preventDefault();
      digits.forEach(function (d, j) {
        var target = codeBoxes[idx + j];
        if (target) {
          target.value = d;
          target.classList.add('is-filled');
        }
      });
      var next = Math.min(idx + digits.length, codeBoxes.length - 1);
      codeBoxes[next].focus();
      updateVerifyContinue();
    });
  });

  verifyContinue.addEventListener('click', function () {
    if (verifyContinue.disabled) return;
    setStep(4);
  });

  function resetCodeBoxes() {
    codeBoxes.forEach(function (b) {
      b.value = '';
      b.classList.remove('is-filled');
    });
    updateVerifyContinue();
  }

  // ----- Profile: avatar upload + continue gating -----
  var avatarFile     = document.getElementById('avatar-file');
  var avatarPreview  = document.getElementById('avatar-preview');
  var avatarIcon     = document.getElementById('avatar-icon');
  var avatarTrigger  = document.getElementById('avatar-trigger');
  var prJob          = document.getElementById('pr-job');
  var prDept         = document.getElementById('pr-dept');
  var prBio          = document.getElementById('pr-bio');
  var profileContinue= document.getElementById('profile-continue');

  avatarTrigger.addEventListener('click', function (e) {
    // Avoid double-trigger when the inner Choose photo link also fires
    if (e.target.closest('[data-action="trigger-avatar"]')) return;
    avatarFile.click();
  });
  avatarFile.addEventListener('change', function () {
    var file = avatarFile.files && avatarFile.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (ev) {
      avatarPreview.src = ev.target.result;
      avatarPreview.hidden = false;
      avatarIcon.style.display = 'none';
      avatarTrigger.classList.add('has-image');
    };
    reader.readAsDataURL(file);
  });

  function resetAvatar() {
    avatarFile.value = '';
    avatarPreview.removeAttribute('src');
    avatarPreview.hidden = true;
    avatarIcon.style.display = '';
    avatarTrigger.classList.remove('has-image');
  }

  function updateProfileContinue() {
    var ok = !!prJob.value.trim();
    profileContinue.disabled = !ok;
    profileContinue.setAttribute('aria-disabled', String(!ok));
  }
  prJob.addEventListener('input', updateProfileContinue);
  profileContinue.addEventListener('click', function () {
    if (profileContinue.disabled) return;
    setStep(5);
  });

  function resetProfileForm() {
    [prJob, prDept, prBio].forEach(function (i) { i.value = ''; });
    updateProfileContinue();
  }

  // ----- Init -----
  updatePasswordMeter();
  updateSignupContinue();
  updateVerifyContinue();
  updateProfileContinue();
})();
</script>

<!-- ============================================================
     Devbar group → dropdown converter (same payload as dashboard)
     ============================================================ -->
<script>
(function () {
  function init() {
    document.querySelectorAll('.devbar').forEach(function (devbar) {
      injectImplicitLabels(devbar);
      collectGroups(devbar).forEach(convertGroup);
    });
  }
  function injectImplicitLabels(devbar) {
    var firstLabel = devbar.querySelector('.dev-label, .devbar__label');
    var firstNav = devbar.querySelector('[data-nav]');
    if (firstNav && (!firstLabel || (firstLabel.compareDocumentPosition(firstNav) & Node.DOCUMENT_POSITION_PRECEDING))) {
      var scrLbl = document.createElement('span');
      scrLbl.className = 'dev-label';
      scrLbl.textContent = 'Screen';
      firstNav.parentNode.insertBefore(scrLbl, firstNav);
    }
    var firstModalBtn = devbar.querySelector('[data-action^="open-"], [data-org-modal-open]');
    if (firstModalBtn) {
      var prev = firstModalBtn.previousElementSibling;
      while (prev && !prev.matches('.dev-label, .devbar__label')) prev = prev.previousElementSibling;
      if (prev && prev.textContent.trim().toLowerCase() === 'screen') {
        var modLbl = document.createElement('span');
        modLbl.className = 'dev-label';
        modLbl.textContent = 'Modals';
        firstModalBtn.parentNode.insertBefore(modLbl, firstModalBtn);
      }
    }
  }
  function collectGroups(devbar) {
    var explicitGroups = devbar.querySelectorAll('.devbar__group');
    if (explicitGroups.length) {
      return Array.from(explicitGroups).map(function (g) {
        return {
          container: g,
          label: g.querySelector('.devbar__label, .dev-label'),
          buttons: Array.from(g.querySelectorAll('.devbar__btn, .dev-btn')),
          dividers: []
        };
      }).filter(function (g) { return g.buttons.length >= 2; });
    }
    var groups = [];
    var seenByLabel = {};
    Array.from(devbar.querySelectorAll('.dev-label')).forEach(function (lbl) {
      var key = lbl.textContent.trim().toLowerCase();
      var buttons = [], dividers = [];
      var n = lbl.nextElementSibling;
      while (n && !n.matches('.dev-label, .dev-spacer')) {
        if (n.matches('.dev-btn')) buttons.push(n);
        else if (n.matches('.dev-divider')) dividers.push(n);
        n = n.nextElementSibling;
      }
      if (seenByLabel[key]) {
        var prior = seenByLabel[key];
        prior.buttons = prior.buttons.concat(buttons);
        prior.dividers = prior.dividers.concat(dividers);
        prior.absorbedLabels = (prior.absorbedLabels || []).concat([lbl]);
        return;
      }
      if (buttons.length >= 2) {
        var grp = { container: null, label: lbl, buttons: buttons, dividers: dividers };
        groups.push(grp);
        seenByLabel[key] = grp;
      }
    });
    return groups;
  }
  function convertGroup(g) {
    var labelText = g.label ? g.label.textContent.trim() : '';
    var dd = document.createElement('div');
    dd.className = 'dev-dd';
    var trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'dev-dd-trigger';
    trigger.setAttribute('aria-haspopup', 'menu');
    trigger.setAttribute('aria-expanded', 'false');
    var triggerLabel = document.createElement('span');
    triggerLabel.className = 'dev-dd-trigger-label';
    triggerLabel.textContent = labelText;
    var triggerValue = document.createElement('span');
    triggerValue.className = 'dev-dd-trigger-value';
    var triggerCaret = document.createElement('span');
    triggerCaret.className = 'dev-dd-trigger-caret';
    triggerCaret.textContent = '▾';
    trigger.appendChild(triggerLabel);
    trigger.appendChild(triggerValue);
    trigger.appendChild(triggerCaret);
    var menu = document.createElement('div');
    menu.className = 'dev-dd-menu';
    menu.setAttribute('role', 'menu');
    g.buttons.forEach(function (btn, idx) {
      var item = document.createElement('button');
      item.type = 'button';
      item.className = 'dev-dd-item';
      item.setAttribute('role', 'menuitem');
      item.textContent = btn.textContent.trim() || ('Option ' + (idx + 1));
      item.dataset.linkedIdx = String(idx);
      item.addEventListener('click', function (e) {
        e.stopPropagation();
        btn.click();
        triggerValue.textContent = item.textContent;
        Array.from(menu.querySelectorAll('.dev-dd-item')).forEach(function (mi) {
          mi.classList.toggle('is-active', mi === item);
        });
        closeMenu();
      });
      menu.appendChild(item);
    });
    dd.appendChild(trigger);
    dd.appendChild(menu);
    if (g.container) g.container.insertBefore(dd, g.container.firstChild);
    else g.label.parentNode.insertBefore(dd, g.label);
    if (g.label) g.label.style.display = 'none';
    g.buttons.forEach(function (b) { b.style.display = 'none'; b.dataset.devDdHidden = '1'; });
    if (g.dividers) g.dividers.forEach(function (d) { d.style.display = 'none'; });
    if (g.absorbedLabels) g.absorbedLabels.forEach(function (l) { l.style.display = 'none'; });
    syncActive();
    function openMenu() {
      menu.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      Array.from(menu.querySelectorAll('.dev-dd-item')).forEach(function (mi) {
        var orig = g.buttons[parseInt(mi.dataset.linkedIdx, 10)];
        var hidden = orig.classList.contains('flow-hidden') || orig.classList.contains('is-hidden');
        mi.style.display = hidden ? 'none' : '';
      });
      setTimeout(function () {
        document.addEventListener('click', outsideHandler, true);
        document.addEventListener('keydown', escHandler, true);
      }, 0);
    }
    function closeMenu() {
      menu.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      document.removeEventListener('click', outsideHandler, true);
      document.removeEventListener('keydown', escHandler, true);
    }
    function outsideHandler(e) { if (!dd.contains(e.target)) closeMenu(); }
    function escHandler(e) { if (e.key === 'Escape') { closeMenu(); trigger.focus(); } }
    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      if (menu.classList.contains('is-open')) closeMenu(); else openMenu();
    });
    var observer = new MutationObserver(syncActive);
    g.buttons.forEach(function (b) {
      observer.observe(b, { attributes: true, attributeFilter: ['class'] });
    });
    function syncActive() {
      var active = g.buttons.find(function (b) {
        return b.classList.contains('is-active') || b.classList.contains('active');
      });
      if (active) {
        triggerValue.textContent = active.textContent.trim();
        Array.from(menu.querySelectorAll('.dev-dd-item')).forEach(function (mi, i) {
          mi.classList.toggle('is-active', i === g.buttons.indexOf(active));
        });
      } else {
        triggerValue.textContent = '';
        Array.from(menu.querySelectorAll('.dev-dd-item')).forEach(function (mi) {
          mi.classList.remove('is-active');
        });
      }
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

