<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Join Traverse Studio — Onboarding</title>

  <link rel="stylesheet" href="../../colors_and_type.css">
  <link rel="stylesheet" href="https://unpkg.com/lucide-static@0.453.0/font/lucide.css">

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      color: var(--surface-900);
      background: var(--surface-50);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }
    button { font-family: inherit; cursor: pointer; border: 0; background: transparent; padding: 0; color: inherit; }
    a { color: inherit; text-decoration: none; }
    input, textarea, select { font-family: inherit; }

    /* ============================================================
       Shell
       ============================================================ */
    .ob-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 24px 88px;
    }
    .ob-wordmark {
      height: 28px;
      margin-bottom: 28px;
    }

    /* ============================================================
       Progress stepper
       ============================================================ */
    .progress-stepper {
      width: 100%;
      max-width: 520px;
      margin-bottom: 28px;
    }
    .progress-track {
      display: grid;
      grid-template-columns: 14px 1fr 14px 1fr 14px 1fr 14px 1fr 14px;
      align-items: center;
    }
    .progress-dot {
      width: 14px; height: 14px;
      border-radius: 999px;
      background: var(--surface-200);
      transition: background 160ms, box-shadow 160ms;
      position: relative;
    }
    .progress-dot.is-done {
      background: var(--success-500);
    }
    .progress-dot.is-done::after {
      content: "";
      position: absolute;
      inset: 3px;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
      background-size: contain;
      background-repeat: no-repeat;
      background-position: center;
    }
    .progress-dot.is-active {
      background: var(--primary-600);
      box-shadow: 0 0 0 4px var(--primary-100);
    }
    .progress-line {
      height: 2px;
      background: var(--surface-200);
      transition: background 160ms;
    }
    .progress-line.is-done { background: var(--success-500); }

    .progress-labels {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      margin-top: 10px;
      text-align: center;
    }
    .progress-labels span {
      font: 500 11px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .progress-labels span.is-done   { color: var(--success-600); }
    .progress-labels span.is-active { color: var(--primary-700); font-weight: 600; }

    /* ============================================================
       Step card (shared)
       ============================================================ */
    .step {
      display: none;
      width: 100%;
      max-width: 480px;
    }
    .step.is-active { display: block; }

    .ob-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      padding: 32px;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.04);
    }
    .ob-card.is-centered { text-align: center; }

    .card-title {
      font: 600 22px/1.3 var(--font-sans);
      color: var(--surface-900);
      letter-spacing: -0.01em;
      margin: 0 0 8px;
    }
    .card-sub {
      font: 400 14px/1.55 var(--font-sans);
      color: var(--surface-600);
      margin: 0 0 24px;
    }

    /* ============================================================
       Email card (Step 1)
       ============================================================ */
    .email-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.04);
    }
    .email-header {
      background: var(--primary-600);
      padding: 28px 32px;
      text-align: center;
    }
    .email-header img {
      height: 26px;
      filter: brightness(0) invert(1);
    }
    .email-body { padding: 32px; }
    .email-greeting {
      font: 600 22px/1.3 var(--font-sans);
      color: var(--surface-900);
      margin: 0 0 12px;
    }
    .email-copy {
      font: 400 14px/1.7 var(--font-sans);
      color: var(--surface-600);
      margin: 0 0 20px;
    }
    .email-copy strong { color: var(--surface-900); }
    .email-invite-block {
      background: var(--surface-50);
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      padding: 14px 18px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .email-invite-icon {
      width: 44px; height: 44px;
      border-radius: 10px;
      background: var(--primary-100);
      color: var(--primary-700);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 20px;
    }
    .email-invite-name {
      font: 600 14px var(--font-sans);
      color: var(--surface-900);
      margin-bottom: 2px;
    }
    .email-invite-meta {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
    }
    .email-cta-wrap { text-align: center; margin-bottom: 18px; }
    .email-or {
      text-align: center;
      font: 500 12px var(--font-sans);
      color: var(--surface-400);
      margin-bottom: 12px;
      letter-spacing: 0.04em;
    }
    .email-login-link {
      display: block;
      text-align: center;
      font: 500 13px var(--font-sans);
      color: var(--primary-600);
      cursor: pointer;
    }
    .email-login-link:hover { text-decoration: underline; }
    .email-footer {
      border-top: 1px solid var(--surface-100);
      padding: 20px 32px;
      text-align: center;
      font: 400 11px/1.6 var(--font-sans);
      color: var(--surface-400);
    }
    .email-footer a { color: var(--surface-500); text-decoration: underline; cursor: pointer; }
    .email-footer strong { color: var(--surface-700); }

    /* ============================================================
       Buttons
       ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 10px;
      font: 600 14px var(--font-sans);
      cursor: pointer;
      transition: background 120ms, border-color 120ms, color 120ms, opacity 120ms;
      border: 1px solid transparent;
    }
    .btn i { font-size: 16px; }
    .btn-primary {
      background: var(--primary-600);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary-700); }
    .btn-secondary {
      background: #fff;
      border-color: var(--surface-200);
      color: var(--surface-800);
    }
    .btn-secondary:hover { background: var(--surface-50); border-color: var(--surface-300); }
    .btn-full { width: 100%; }
    .btn[aria-disabled="true"],
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-google {
      width: 100%;
      padding: 12px 16px;
      background: #fff;
      border: 1px solid var(--surface-300);
      border-radius: 10px;
      font: 500 14px var(--font-sans);
      color: var(--surface-900);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      transition: background 120ms, border-color 120ms;
    }
    .btn-google:hover { background: var(--surface-50); border-color: var(--surface-400); }

    .or-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0;
      font: 500 12px var(--font-sans);
      color: var(--surface-400);
      letter-spacing: 0.06em;
    }
    .or-divider::before,
    .or-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--surface-200);
    }

    /* ============================================================
       Form
       ============================================================ */
    .field-group { margin-bottom: 14px; }
    .field-group:last-of-type { margin-bottom: 0; }
    .field-label {
      display: block;
      font: 600 13px var(--font-sans);
      color: var(--surface-900);
      margin-bottom: 6px;
    }
    .field-label .req  { color: var(--error-500); margin-left: 2px; }
    .field-label .opt  { color: var(--surface-400); font-weight: 400; margin-left: 4px; }
    .field-hint {
      font: 400 12px var(--font-sans);
      color: var(--surface-500);
      margin: 6px 0 0;
    }
    .text-input {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      transition: border-color 120ms, box-shadow 120ms;
    }
    .text-input::placeholder { color: var(--surface-400); }
    .text-input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .text-input[readonly] {
      background: var(--surface-50);
      color: var(--surface-500);
      cursor: default;
    }
    .textarea-input {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      background: #fff;
      font: 400 14px var(--font-sans);
      color: var(--surface-900);
      resize: vertical;
      min-height: 88px;
      transition: border-color 120ms, box-shadow 120ms;
    }
    .textarea-input:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .name-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }

    /* Password input + eye toggle */
    .password-wrap { position: relative; }
    .password-wrap .text-input { padding-right: 44px; }
    .password-eye {
      position: absolute;
      right: 4px; top: 50%;
      transform: translateY(-50%);
      width: 36px; height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      color: var(--surface-400);
      transition: background 120ms, color 120ms;
    }
    .password-eye:hover {
      background: var(--surface-100);
      color: var(--surface-700);
    }
    .password-eye i { font-size: 16px; }

    /* Password strength meter */
    .pw-strength { margin-top: 8px; }
    .pw-bar {
      height: 4px;
      background: var(--surface-200);
      border-radius: 2px;
      overflow: hidden;
    }
    .pw-fill {
      height: 100%;
      width: 0%;
      background: var(--surface-300);
      border-radius: 2px;
      transition: width 200ms, background 200ms;
    }
    .pw-fill.is-weak   { background: var(--error-500); }
    .pw-fill.is-medium { background: var(--warn-500); }
    .pw-fill.is-strong { background: var(--success-500); }
    .pw-label {
      font: 500 11px var(--font-sans);
      color: var(--surface-400);
      margin-top: 4px;
    }
    .pw-label.is-weak   { color: var(--error-500); }
    .pw-label.is-medium { color: var(--warn-600); }
    .pw-label.is-strong { color: var(--success-600); }

    /* Terms checkbox */
    .terms-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 16px 0 18px;
      font: 400 12px/1.5 var(--font-sans);
      color: var(--surface-600);
    }
    .terms-row input[type="checkbox"] {
      width: 16px; height: 16px;
      accent-color: var(--primary-600);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .terms-row a {
      color: var(--primary-600);
      cursor: pointer;
    }
    .terms-row a:hover { text-decoration: underline; }

    .login-row {
      font: 400 13px var(--font-sans);
      color: var(--surface-600);
      margin-top: 14px;
      text-align: center;
    }
    .login-row a {
      color: var(--primary-600);
      font-weight: 600;
      cursor: pointer;
    }
    .login-row a:hover { text-decoration: underline; }

    /* ============================================================
       Verify code
       ============================================================ */
    .verify-icon {
      width: 64px; height: 64px;
      border-radius: 999px;
      background: var(--primary-100);
      color: var(--primary-600);
      border: 1px solid var(--primary-200);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 26px;
    }
    .code-inputs {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin: 0 0 22px;
    }
    .code-box {
      width: 48px; height: 56px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      text-align: center;
      font: 600 22px var(--font-sans);
      color: var(--surface-900);
      background: #fff;
      transition: border-color 120ms, box-shadow 120ms, background 120ms;
    }
    .code-box:focus {
      outline: none;
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }
    .code-box.is-filled {
      background: var(--primary-100);
      border-color: var(--primary-400);
      color: var(--primary-800);
    }
    .resend-row {
      text-align: center;
      font: 400 13px var(--font-sans);
      color: var(--surface-600);
      margin-bottom: 22px;
    }
    .resend-link {
      color: var(--primary-600);
      font-weight: 600;
      cursor: pointer;
    }
    .resend-link:hover { text-decoration: underline; }

    /* ============================================================
       Profile (avatar)
       ============================================================ */
    .avatar-upload {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 22px;
    }
    .avatar-circle {
      width: 88px; height: 88px;
      border-radius: 999px;
      background: var(--primary-50);
      border: 2px dashed var(--primary-200);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-bottom: 10px;
      overflow: hidden;
      color: var(--primary-600);
      transition: background 120ms, border-color 120ms;
    }
    .avatar-circle:hover {
      border-color: var(--primary-400);
      background: var(--primary-100);
    }
    .avatar-circle i { font-size: 24px; }
    .avatar-circle img {
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .avatar-circle.has-image { border-style: solid; border-color: var(--primary-400); }
    .avatar-link {
      font: 500 13px var(--font-sans);
      color: var(--primary-600);
      cursor: pointer;
    }
    .avatar-link:hover { text-decoration: underline; }

    /* ============================================================
       Welcome
       ============================================================ */
    .check-circle {
      width: 72px; height: 72px;
      border-radius: 999px;
      background: var(--success-100);
      color: var(--success-600);
      border: 2px solid var(--success-500);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 22px;
    }
    .check-circle i { font-size: 36px; }

    .role-chip {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      background: var(--info-100);
      color: var(--info-500);
      font: 600 11px var(--font-sans);
      letter-spacing: 0.04em;
    }

    /* ============================================================
       Step nav (back link)
       ============================================================ */
    .step-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font: 500 13px var(--font-sans);
      color: var(--surface-500);
      margin-bottom: 16px;
      cursor: pointer;
      transition: color 120ms;
    }
    .step-back:hover { color: var(--primary-600); }
    .step-back i { font-size: 14px; }

    /* ============================================================
       Devbar (prototype controls)
       ============================================================ */
    .devbar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--surface-900);
      color: #fff;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 100;
      font: 500 12px var(--font-sans);
      box-shadow: 0 -6px 20px -8px rgba(15, 23, 42, 0.35);
    }
    .devbar .dev-label {
      color: rgba(255,255,255,0.55);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 11px;
      margin-right: 6px;
    }
    .devbar .dev-btn {
      padding: 6px 10px;
      border-radius: 6px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      cursor: pointer;
      transition: background 120ms;
    }
    .devbar .dev-btn:hover { background: rgba(255,255,255,0.16); }
    .devbar .dev-btn.is-active { background: var(--primary-500); }
    .devbar .dev-divider {
      width: 1px;
      height: 18px;
      background: rgba(255,255,255,0.18);
      margin: 0 4px;
    }
    .devbar .dev-spacer { flex: 1; }
  </style>
</head>
<body>

<div class="ob-shell">

  <img class="ob-wordmark" src="../../public/logo/studio_full_light.svg" alt="Traverse Studio">

  <!-- ============ Progress stepper ============ -->
  <div class="progress-stepper">
    <div class="progress-track">
      <span class="progress-dot is-active" data-progress-dot="1"></span>
      <span class="progress-line" data-progress-line="1-2"></span>
      <span class="progress-dot" data-progress-dot="2"></span>
      <span class="progress-line" data-progress-line="2-3"></span>
      <span class="progress-dot" data-progress-dot="3"></span>
      <span class="progress-line" data-progress-line="3-4"></span>
      <span class="progress-dot" data-progress-dot="4"></span>
      <span class="progress-line" data-progress-line="4-5"></span>
      <span class="progress-dot" data-progress-dot="5"></span>
    </div>
    <div class="progress-labels">
      <span class="is-active" data-progress-label="1">Invite</span>
      <span data-progress-label="2">Sign up</span>
      <span data-progress-label="3">Verify</span>
      <span data-progress-label="4">Profile</span>
      <span data-progress-label="5">Welcome</span>
    </div>
  </div>

  <!-- ============================================================
       Step 1 — Invitation email
       ============================================================ -->
  <section class="step is-active" data-step="1" aria-labelledby="step-1-title">
    <div class="email-card">
      <div class="email-header">
        <img src="../../public/logo/studio_full_light.svg" alt="Traverse Studio">
      </div>
      <div class="email-body">
        <h1 id="step-1-title" class="email-greeting">You've been invited to Traverse Studio</h1>
        <p class="email-copy">
          Hi Jane, <strong>Sarah Chen</strong> has invited you to use Traverse Studio
          to collaborate in the <strong>Acme Corp</strong> workspace.
          You'll join as a <strong>Standard user</strong>, giving you access to create
          and edit assessments and content collections.
        </p>

        <div class="email-invite-block">
          <div class="email-invite-icon" aria-hidden="true">
            <i class="icon-building-2"></i>
          </div>
          <div>
            <div class="email-invite-name">Acme Corp</div>
            <div class="email-invite-meta">Invited by Sarah Chen · Workspace admin</div>
          </div>
        </div>

        <div class="email-cta-wrap">
          <button class="btn btn-primary btn-full" data-action="accept-invite">Accept invitation</button>
        </div>
        <div class="email-or">or</div>
        <a class="email-login-link" data-action="accept-invite">Already have a Traverse Studio account? Log in instead</a>
      </div>
      <div class="email-footer">
        This invitation was sent to <strong>jane.smith@acmecorp.com</strong> and expires in 7 days.<br>
        If you weren't expecting this, you can safely ignore it.<br><br>
        <a>Unsubscribe</a> · <a>Privacy policy</a> · Traverse Studio
      </div>
    </div>
  </section>

  <!-- ============================================================
       Step 2 — Account creation
       ============================================================ -->
  <section class="step" data-step="2" aria-labelledby="step-2-title">
    <div class="ob-card">
      <a class="step-back" data-nav-step="1">
        <i class="icon-chevron-left"></i> Back
      </a>
      <h1 id="step-2-title" class="card-title">Create your account</h1>
      <p class="card-sub">Sign up to Traverse Studio to continue to <strong style="color: var(--surface-800);">Acme Corp</strong>.</p>

      <button class="btn-google" data-action="google-sso">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
          <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 009 18z" fill="#34A853"/>
          <path d="M3.964 10.71A5.41 5.41 0 013.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 000 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
          <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 00.957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </button>

      <div class="or-divider">OR</div>

      <form id="signup-form" novalidate>
        <div class="name-row">
          <div>
            <label class="field-label" for="su-first">First name<span class="req">*</span></label>
            <input class="text-input" type="text" id="su-first" placeholder="Jane" autocomplete="given-name" required>
          </div>
          <div>
            <label class="field-label" for="su-last">Last name<span class="req">*</span></label>
            <input class="text-input" type="text" id="su-last" placeholder="Smith" autocomplete="family-name" required>
          </div>
        </div>

        <div class="field-group">
          <label class="field-label" for="su-email">Email address</label>
          <input class="text-input" type="email" id="su-email" value="jane.smith@acmecorp.com" readonly>
          <p class="field-hint">Pre-filled from your invitation.</p>
        </div>

        <div class="field-group">
          <label class="field-label" for="su-password">Password<span class="req">*</span></label>
          <div class="password-wrap">
            <input class="text-input" type="password" id="su-password" placeholder="At least 8 characters" autocomplete="new-password" required>
            <button type="button" class="password-eye" data-toggle-password="su-password" aria-label="Show password">
              <i class="icon-eye"></i>
            </button>
          </div>
          <div class="pw-strength">
            <div class="pw-bar"><div class="pw-fill" id="su-pw-fill"></div></div>
            <div class="pw-label" id="su-pw-label">Enter a password</div>
          </div>
        </div>

        <div class="field-group">
          <label class="field-label" for="su-confirm">Confirm password<span class="req">*</span></label>
          <div class="password-wrap">
            <input class="text-input" type="password" id="su-confirm" placeholder="Re-enter your password" autocomplete="new-password" required>
            <button type="button" class="password-eye" data-toggle-password="su-confirm" aria-label="Show password">
              <i class="icon-eye"></i>
            </button>
          </div>
          <p class="field-hint" id="su-confirm-hint" hidden></p>
        </div>

        <label class="terms-row">
          <input type="checkbox" id="su-terms">
          <span>I agree to Traverse Studio's <a>terms of service</a> and <a>privacy policy</a>.</span>
        </label>

        <button type="submit" class="btn btn-primary btn-full" id="su-continue" aria-disabled="true" disabled>Continue</button>
      </form>

      <div class="login-row">Already have an account? <a>Log in</a></div>
    </div>
  </section>

  <!-- ============================================================
       Step 3 — Email verification
       ============================================================ -->
  <section class="step" data-step="3" aria-labelledby="step-3-title">
    <div class="ob-card is-centered">
      <a class="step-back" data-nav-step="2" style="float: left;">
        <i class="icon-chevron-left"></i> Back
      </a>
      <div style="clear: both;"></div>

      <div class="verify-icon"><i class="icon-mail"></i></div>
      <h1 id="step-3-title" class="card-title">Check your inbox</h1>
      <p class="card-sub">
        We sent a 6-digit verification code to<br>
        <strong style="color: var(--surface-900);" data-verify-email>jane.smith@acmecorp.com</strong>
      </p>

      <div class="code-inputs" role="group" aria-label="Verification code">
        <input class="code-box" type="text" inputmode="numeric" maxlength="1" data-code-index="0" aria-label="Digit 1">
        <input class="code-box" type="text" inputmode="numeric" maxlength="1" data-code-index="1" aria-label="Digit 2">
        <input class="code-box" type="text" inputmode="numeric" maxlength="1" data-code-index="2" aria-label="Digit 3">
        <input class="code-box" type="text" inputmode="numeric" maxlength="1" data-code-index="3" aria-label="Digit 4">
        <input class="code-box" type="text" inputmode="numeric" maxlength="1" data-code-index="4" aria-label="Digit 5">
        <input class="code-box" type="text" inputmode="numeric" maxlength="1" data-code-index="5" aria-label="Digit 6">
      </div>

      <div class="resend-row">
        Didn't receive it? <span class="resend-link" id="resend-link" data-action="resend-code">Resend code</span>
      </div>

      <button class="btn btn-primary btn-full" id="verify-continue" aria-disabled="true" disabled>Verify and continue</button>
    </div>
  </section>

  <!-- ============================================================
       Step 4 — Profile setup
       ============================================================ -->
  <section class="step" data-step="4" aria-labelledby="step-4-title">
    <div class="ob-card">
      <h1 id="step-4-title" class="card-title">Tell us about yourself</h1>
      <p class="card-sub">Help your teammates know who you are.</p>

      <div class="avatar-upload">
        <button type="button" class="avatar-circle" id="avatar-trigger" aria-label="Upload profile photo">
          <i class="icon-camera" id="avatar-icon"></i>
          <img id="avatar-preview" alt="" hidden>
        </button>
        <span class="avatar-link" data-action="trigger-avatar">Choose photo</span>
        <input type="file" id="avatar-file" accept="image/*" hidden>
      </div>

      <div class="field-group">
        <label class="field-label" for="pr-job">Job title<span class="req">*</span></label>
        <input class="text-input" type="text" id="pr-job" placeholder="e.g. Learning &amp; Development Manager" required>
      </div>

      <div class="field-group">
        <label class="field-label" for="pr-dept">Department<span class="opt">(optional)</span></label>
        <input class="text-input" type="text" id="pr-dept" placeholder="e.g. Human Resources">
      </div>

      <div class="field-group">
        <label class="field-label" for="pr-bio">Bio<span class="opt">(optional)</span></label>
        <textarea class="textarea-input" id="pr-bio" placeholder="A short intro about yourself…" rows="3"></textarea>
      </div>

      <button type="button" class="btn btn-primary btn-full" id="profile-continue" aria-disabled="true" disabled style="margin-top: 18px;">Continue</button>
    </div>
  </section>

  <!-- ============================================================
       Step 5 — Welcome
       ============================================================ -->
  <section class="step" data-step="5" aria-labelledby="step-5-title">
    <div class="ob-card is-centered">
      <div class="check-circle" aria-hidden="true"><i class="icon-check"></i></div>
      <h1 id="step-5-title" class="card-title">Welcome to Traverse Studio, <span data-welcome-first>Jane</span>!</h1>
      <p class="card-sub">
        You're set up as a <span class="role-chip">Standard user</span> in the <strong style="color: var(--surface-800);">Acme Corp</strong> workspace. You're all set to get started.
      </p>

      <button type="button" class="btn btn-primary btn-full" data-action="go-to-workspace">
        Go to workspace
        <i class="icon-arrow-right"></i>
      </button>
    </div>
  </section>

</div>

<!-- ============================================================
     Devbar
     ============================================================ -->
<div class="devbar" aria-label="Prototype controls">
  <span class="dev-label">Step</span>
  <button class="dev-btn is-active" data-nav-step="1">1 · Invite</button>
  <button class="dev-btn" data-nav-step="2">2 · Sign up</button>
  <button class="dev-btn" data-nav-step="3">3 · Verify</button>
  <button class="dev-btn" data-nav-step="4">4 · Profile</button>
  <button class="dev-btn" data-nav-step="5">5 · Welcome</button>
  <span class="dev-divider"></span>
  <button class="dev-btn" data-action="reset">Reset state</button>
  <span class="dev-spacer"></span>
  <button class="dev-btn" data-action="prefill-signup">Prefill sign-up</button>
</div>

<script>
(function () {
  var TOTAL_STEPS = 5;
  var currentStep = 1;
  // Track which steps have been completed so the progress dots can flip to "done"
  var doneSteps = new Set();

  // ----- DOM -----
  var steps = document.querySelectorAll('.step');
  var dots = document.querySelectorAll('[data-progress-dot]');
  var lines = document.querySelectorAll('[data-progress-line]');
  var labels = document.querySelectorAll('[data-progress-label]');
  var devBtns = document.querySelectorAll('.devbar .dev-btn[data-nav-step]');

  // ----- Step switching -----
  function setStep(n) {
    if (n < 1 || n > TOTAL_STEPS) return;
    if (n > currentStep) {
      // Mark every step we've moved past as done
      for (var i = currentStep; i < n; i++) doneSteps.add(i);
    }
    currentStep = n;
    steps.forEach(function (s) {
      s.classList.toggle('is-active', parseInt(s.getAttribute('data-step'), 10) === n);
    });
    updateProgress();
    updateDevbar();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress() {
    dots.forEach(function (d) {
      var i = parseInt(d.getAttribute('data-progress-dot'), 10);
      d.classList.toggle('is-done', doneSteps.has(i));
      d.classList.toggle('is-active', i === currentStep);
    });
    lines.forEach(function (l) {
      var pair = l.getAttribute('data-progress-line').split('-').map(Number);
      l.classList.toggle('is-done', doneSteps.has(pair[0]));
    });
    labels.forEach(function (lbl) {
      var i = parseInt(lbl.getAttribute('data-progress-label'), 10);
      lbl.classList.toggle('is-done', doneSteps.has(i) && i !== currentStep);
      lbl.classList.toggle('is-active', i === currentStep);
    });
  }

  function updateDevbar() {
    devBtns.forEach(function (b) {
      b.classList.toggle('is-active', parseInt(b.getAttribute('data-nav-step'), 10) === currentStep);
    });
  }

  // ----- Navigation listeners -----
  document.addEventListener('click', function (e) {
    var navBtn = e.target.closest('[data-nav-step]');
    if (navBtn) {
      e.preventDefault();
      setStep(parseInt(navBtn.getAttribute('data-nav-step'), 10));
      return;
    }
    var action = e.target.closest('[data-action]');
    if (!action) return;
    var a = action.getAttribute('data-action');
    if (a === 'accept-invite') { setStep(2); }
    else if (a === 'google-sso') {
      // Google handles auth + verification, fast-track to profile
      doneSteps.add(2); doneSteps.add(3);
      setStep(4);
    }
    else if (a === 'resend-code') {
      var link = document.getElementById('resend-link');
      if (link) {
        var original = link.textContent;
        link.textContent = 'Code resent';
        link.style.pointerEvents = 'none';
        setTimeout(function () {
          link.textContent = original;
          link.style.pointerEvents = '';
        }, 2500);
      }
    }
    else if (a === 'trigger-avatar') {
      document.getElementById('avatar-file').click();
    }
    else if (a === 'go-to-workspace') {
      // For the prototype, return to the dashboard prototype if available
      window.location.href = '../dashboard/';
    }
    else if (a === 'reset') {
      doneSteps = new Set();
      resetSignupForm();
      resetCodeBoxes();
      resetProfileForm();
      resetAvatar();
      setStep(1);
    }
    else if (a === 'prefill-signup') {
      prefillSignup();
    }
  });

  // ----- Password show/hide -----
  document.addEventListener('click', function (e) {
    var eye = e.target.closest('[data-toggle-password]');
    if (!eye) return;
    var id = eye.getAttribute('data-toggle-password');
    var input = document.getElementById(id);
    if (!input) return;
    var icon = eye.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      if (icon) icon.className = 'icon-eye-off';
      eye.setAttribute('aria-label', 'Hide password');
    } else {
      input.type = 'password';
      if (icon) icon.className = 'icon-eye';
      eye.setAttribute('aria-label', 'Show password');
    }
  });

  // ----- Sign-up form: validation, strength meter, continue gating -----
  var suFirst    = document.getElementById('su-first');
  var suLast     = document.getElementById('su-last');
  var suPassword = document.getElementById('su-password');
  var suConfirm  = document.getElementById('su-confirm');
  var suTerms    = document.getElementById('su-terms');
  var suContinue = document.getElementById('su-continue');
  var pwFill     = document.getElementById('su-pw-fill');
  var pwLabel    = document.getElementById('su-pw-label');
  var confirmHint = document.getElementById('su-confirm-hint');
  var signupForm = document.getElementById('signup-form');

  function passwordStrength(pw) {
    if (!pw) return { score: 0, label: 'Enter a password', cls: '' };
    var score = 0;
    if (pw.length >= 8) score++;
    if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
    if (/\d/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    if (pw.length >= 12) score++;
    if (score <= 1) return { score: score, label: 'Weak — keep going', cls: 'is-weak', pct: 20 };
    if (score <= 3) return { score: score, label: 'Medium — try adding a symbol', cls: 'is-medium', pct: 60 };
    return { score: score, label: 'Strong password', cls: 'is-strong', pct: 100 };
  }

  function updatePasswordMeter() {
    var pw = suPassword.value;
    var r = passwordStrength(pw);
    pwFill.style.width = (r.pct || 0) + '%';
    pwFill.className = 'pw-fill' + (r.cls ? ' ' + r.cls : '');
    pwLabel.textContent = r.label;
    pwLabel.className = 'pw-label' + (r.cls ? ' ' + r.cls : '');
  }

  function updateConfirmHint() {
    if (!suConfirm.value) {
      confirmHint.hidden = true;
      return;
    }
    if (suConfirm.value === suPassword.value) {
      confirmHint.textContent = 'Passwords match.';
      confirmHint.style.color = 'var(--success-600)';
    } else {
      confirmHint.textContent = 'Passwords don\'t match yet.';
      confirmHint.style.color = 'var(--error-500)';
    }
    confirmHint.hidden = false;
  }

  function updateSignupContinue() {
    var ok = !!suFirst.value.trim() &&
             !!suLast.value.trim() &&
             suPassword.value.length >= 8 &&
             suPassword.value === suConfirm.value &&
             suTerms.checked;
    suContinue.disabled = !ok;
    suContinue.setAttribute('aria-disabled', String(!ok));
  }

  [suFirst, suLast, suPassword, suConfirm].forEach(function (input) {
    input.addEventListener('input', function () {
      if (input === suPassword) { updatePasswordMeter(); updateConfirmHint(); }
      if (input === suConfirm) updateConfirmHint();
      updateSignupContinue();
    });
  });
  suTerms.addEventListener('change', updateSignupContinue);

  signupForm.addEventListener('submit', function (e) {
    e.preventDefault();
    if (suContinue.disabled) return;
    // Remember first name for the welcome step
    document.querySelectorAll('[data-welcome-first]').forEach(function (el) {
      el.textContent = suFirst.value.trim() || 'Jane';
    });
    setStep(3);
  });

  function resetSignupForm() {
    [suFirst, suLast, suPassword, suConfirm].forEach(function (i) { i.value = ''; });
    suTerms.checked = false;
    updatePasswordMeter();
    updateConfirmHint();
    updateSignupContinue();
  }

  function prefillSignup() {
    suFirst.value = 'Jane';
    suLast.value = 'Smith';
    suPassword.value = 'Tr@verse2026!';
    suConfirm.value = 'Tr@verse2026!';
    suTerms.checked = true;
    updatePasswordMeter();
    updateConfirmHint();
    updateSignupContinue();
    document.querySelectorAll('[data-welcome-first]').forEach(function (el) { el.textContent = 'Jane'; });
  }

  // ----- Verify code: auto-advance + backspace + complete gating -----
  var codeBoxes = document.querySelectorAll('.code-box');
  var verifyContinue = document.getElementById('verify-continue');

  function codeComplete() {
    return Array.from(codeBoxes).every(function (b) { return b.value.length === 1; });
  }
  function updateVerifyContinue() {
    var ok = codeComplete();
    verifyContinue.disabled = !ok;
    verifyContinue.setAttribute('aria-disabled', String(!ok));
  }

  codeBoxes.forEach(function (box, idx) {
    box.addEventListener('input', function (e) {
      // Allow only digits
      var v = box.value.replace(/\D/g, '');
      box.value = v.charAt(0) || '';
      box.classList.toggle('is-filled', !!box.value);
      if (box.value && idx < codeBoxes.length - 1) {
        codeBoxes[idx + 1].focus();
      }
      updateVerifyContinue();
    });
    box.addEventListener('keydown', function (e) {
      if (e.key === 'Backspace' && !box.value && idx > 0) {
        codeBoxes[idx - 1].focus();
        codeBoxes[idx - 1].value = '';
        codeBoxes[idx - 1].classList.remove('is-filled');
        updateVerifyContinue();
      }
    });
    box.addEventListener('paste', function (e) {
      var pasted = (e.clipboardData || window.clipboardData).getData('text');
      var digits = pasted.replace(/\D/g, '').split('').slice(0, codeBoxes.length - idx);
      if (!digits.length) return;
      e.preventDefault();
      digits.forEach(function (d, j) {
        var target = codeBoxes[idx + j];
        if (target) {
          target.value = d;
          target.classList.add('is-filled');
        }
      });
      var next = Math.min(idx + digits.length, codeBoxes.length - 1);
      codeBoxes[next].focus();
      updateVerifyContinue();
    });
  });

  verifyContinue.addEventListener('click', function () {
    if (verifyContinue.disabled) return;
    setStep(4);
  });

  function resetCodeBoxes() {
    codeBoxes.forEach(function (b) {
      b.value = '';
      b.classList.remove('is-filled');
    });
    updateVerifyContinue();
  }

  // ----- Profile: avatar upload + continue gating -----
  var avatarFile     = document.getElementById('avatar-file');
  var avatarPreview  = document.getElementById('avatar-preview');
  var avatarIcon     = document.getElementById('avatar-icon');
  var avatarTrigger  = document.getElementById('avatar-trigger');
  var prJob          = document.getElementById('pr-job');
  var prDept         = document.getElementById('pr-dept');
  var prBio          = document.getElementById('pr-bio');
  var profileContinue= document.getElementById('profile-continue');

  avatarTrigger.addEventListener('click', function (e) {
    // Avoid double-trigger when the inner Choose photo link also fires
    if (e.target.closest('[data-action="trigger-avatar"]')) return;
    avatarFile.click();
  });
  avatarFile.addEventListener('change', function () {
    var file = avatarFile.files && avatarFile.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (ev) {
      avatarPreview.src = ev.target.result;
      avatarPreview.hidden = false;
      avatarIcon.style.display = 'none';
      avatarTrigger.classList.add('has-image');
    };
    reader.readAsDataURL(file);
  });

  function resetAvatar() {
    avatarFile.value = '';
    avatarPreview.removeAttribute('src');
    avatarPreview.hidden = true;
    avatarIcon.style.display = '';
    avatarTrigger.classList.remove('has-image');
  }

  function updateProfileContinue() {
    var ok = !!prJob.value.trim();
    profileContinue.disabled = !ok;
    profileContinue.setAttribute('aria-disabled', String(!ok));
  }
  prJob.addEventListener('input', updateProfileContinue);
  profileContinue.addEventListener('click', function () {
    if (profileContinue.disabled) return;
    setStep(5);
  });

  function resetProfileForm() {
    [prJob, prDept, prBio].forEach(function (i) { i.value = ''; });
    updateProfileContinue();
  }

  // ----- Init -----
  updatePasswordMeter();
  updateSignupContinue();
  updateVerifyContinue();
  updateProfileContinue();
})();
</script>

</body>
</html>
