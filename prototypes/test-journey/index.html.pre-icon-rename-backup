        setPriority('high');
        fbAnnounce('Scenario set to high priority. Review priority indicator updated.');

      } else if (state === 'ready' || state === 'no-edits') {
        // Full reset including quality indicators
        resetQualityIndicators();
        syncQualityRowVisibility();

      } else if (state === 'pending' || state === 'failed') {
        // Hide quality row when not in ready state
        syncQualityRowVisibility();

      } else if (state === 'variability') {
