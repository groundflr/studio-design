    }
    .doc-body h4 { font: 700 18px/1.3 var(--font-sans); color: var(--surface-900); margin: 0 0 10px; }
    .doc-body p { margin: 0 0 10px; }

    /* =====================================================
       Feedback Review panel (Group 2 — Sub-section A)
       ===================================================== */

    /* Screen-reader-only utility */
    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* Split layout: context pane (left) + content pane (right) */
    .feedback-review-layout {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 16px;
      padding: 0 40px 32px;
    }

    /* ------- Left pane ------- */
    .fb-context-pane {
      display: flex; flex-direction: column; gap: 12px;
    }
    .fb-context-section {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      overflow: hidden;
    }
    .fb-context-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px;
      border-bottom: 1px solid var(--surface-100);
    }
    .eyebrow-label {
      font: 600 10px/1 var(--font-sans);
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--surface-500);
    }
    .fb-context-doc {
      padding: 14px 16px 16px;
      font: 400 13px/1.55 var(--font-body);
      color: var(--surface-700);
      max-height: 200px; overflow-y: auto;
    }
    .fb-context-doc h4 { font: 600 13px/1.3 var(--font-sans); color: var(--surface-900); margin: 0 0 8px; }
    .fb-context-doc p { margin: 0 0 8px; }

    /* Grade mini-table */
    .fb-grade-mini {
      width: 100%; border-collapse: collapse;
      font: 400 12px var(--font-sans); color: var(--surface-700);
    }
    .fb-grade-mini td { padding: 7px 16px; border-bottom: 1px solid var(--surface-100); vertical-align: middle; }
    .fb-grade-mini tbody tr:last-child td { border-bottom: none; }
    .fb-grade-mini tfoot td { padding: 8px 16px; border-top: 1px solid var(--surface-200); font-weight: 600; color: var(--surface-900); }
    .fb-grade-mini td.right { text-align: right; }
    .fb-grade-mini td.score-col { text-align: right; color: var(--surface-500); font-size: 11px; min-width: 48px; }

    /* ------- Right pane ------- */
    .fb-content-pane {
      display: flex; flex-direction: column; gap: 12px;
    }

    /* Status bar */
    .fb-status-bar {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    }
    .fb-status-left { display: flex; align-items: center; gap: 10px; }
    .fb-status-meta {
      font: 400 12px var(--font-sans); color: var(--surface-500);
    }
    .fb-status-badge {
      font-size: 11px; letter-spacing: 0.07em;
    }

    /* Editor card */
    .fb-editor-card {
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      overflow: hidden;
      flex: 1;
    }
    .fb-editor-card.is-editing {
      border-color: var(--primary-400);
      box-shadow: 0 0 0 3px var(--primary-100);
    }

    /* Formatting toolbar */
    .fb-toolbar {
      display: flex; align-items: center; gap: 2px;
      padding: 8px 14px;
      border-bottom: 1px solid var(--surface-100);
      background: var(--surface-50);
    }
    .fb-tool-btn {
      width: 30px; height: 30px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 6px; border: none; background: transparent;
      font: 500 13px/1 var(--font-sans); color: var(--surface-700);
      cursor: pointer;
    }
    .fb-tool-btn:hover { background: var(--surface-200); color: var(--surface-900); }
    .fb-tool-btn i { font-size: 14px; }
    .fb-tool-sep {
      width: 1px; height: 18px;
      background: var(--surface-200);
      margin: 0 4px;
    }

    /* Editable feedback region */
    .fb-edit-region {
      padding: 18px 20px 14px;
      font: 400 14px/1.65 var(--font-body);
      color: var(--surface-800);
      min-height: 240px;
      outline: none;
    }
    .fb-edit-region[contenteditable="true"] {
      background: var(--surface-50);
    }
    .fb-edit-region p { margin: 0 0 10px; }
    .fb-edit-region ul, .fb-edit-region ol { margin: 0 0 10px; padding-left: 20px; }
    .fb-edit-region li { margin-bottom: 4px; }

    /* Editor footer */
    .fb-editor-footer {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 20px 10px;
      border-top: 1px solid var(--surface-100);
    }
    .fb-word-count {
      font: 400 11px var(--font-sans); color: var(--surface-400);
    }
    .fb-edit-hint {
      font: 400 11px var(--font-sans); color: var(--surface-400);
      font-style: italic;
    }

    /* Action bar */
    .fb-action-bar {
      display: flex; align-items: center; justify-content: space-between;
      gap: 8px;
    }
    .fb-action-left { display: flex; align-items: center; gap: 8px; }
    .fb-action-right { display: flex; align-items: center; gap: 8px; }

    /* Approve confirmation bar */
    .fb-confirm-bar {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 18px;
      background: var(--warn-100);
      border: 1px solid #fcd34d;
      border-radius: 10px;
      font: 400 13px/1.45 var(--font-sans); color: var(--surface-800);
    }

    /* ------- State screens (pending / failed) ------- */
    .fb-state { padding: 16px 40px 32px; }
    .fb-state-inner {
      display: flex; flex-direction: column; align-items: center;
      text-align: center; gap: 12px;
      padding: 48px 32px;
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 12px;
    }
    .fb-skeleton-icon {
      width: 48px; height: 48px; border-radius: 12px;
      background: var(--primary-100);
      display: flex; align-items: center; justify-content: center;
      color: var(--primary-600); font-size: 22px;
    }
    .fb-icon-error { background: var(--error-100); color: var(--error-500); }
    .fb-state-title {
      font: 600 16px/1.3 var(--font-sans); color: var(--surface-900);
      margin: 0;
    }
    .fb-state-desc {
      font: 400 14px/1.55 var(--font-sans); color: var(--surface-500);
      max-width: 480px; margin: 0;
    }
    /* Skeleton loading bars */
    .fb-skeleton-bars {
      display: flex; flex-direction: column; gap: 8px;
      width: 100%; max-width: 480px;
    }
    .fb-skel-bar {
      height: 12px; border-radius: 6px;
      background: linear-gradient(90deg, var(--surface-100) 25%, var(--surface-200) 50%, var(--surface-100) 75%);
      background-size: 400% 100%;
      animation: fb-shimmer 1.6s ease-in-out infinite;
    }
    @keyframes fb-shimmer {
      0% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* =====================================================
       Feedback Review — Sub-section B
       History panel, Revert action, Variability comparison
       ===================================================== */

    /* --- History panel --- */
    .fb-history-toggle {
      display: inline-flex; align-items: center; gap: 6px;
      font: 500 12px var(--font-sans); color: var(--primary-600);
      background: none; border: none; padding: 0; cursor: pointer;
      text-decoration: none;
    }
    .fb-history-toggle:hover { color: var(--primary-700); text-decoration: underline; }
    .fb-history-toggle i { font-size: 13px; }

    .fb-history-panel {
      background: var(--surface-50);
      border: 1px solid var(--surface-200);
      border-radius: 8px;
      overflow: hidden;
    }
    .fb-history-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px;
      border-bottom: 1px solid var(--surface-100);
    }
    .fb-history-head-label {
      font: 600 11px var(--font-sans); letter-spacing: 0.07em;
      text-transform: uppercase; color: var(--surface-500);
    }
    .fb-history-close {
      background: none; border: none; padding: 2px;
      cursor: pointer; color: var(--surface-400); font-size: 13px;
      display: inline-flex; align-items: center;
      border-radius: 4px;
    }
    .fb-history-close:hover { color: var(--surface-700); background: var(--surface-100); }

    .fb-history-list {
      list-style: none; margin: 0; padding: 0;
    }
    .fb-history-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--surface-100);
      font: 400 12px var(--font-sans); color: var(--surface-700);
    }
    .fb-history-item:last-child { border-bottom: none; }
    .fb-history-item.is-current { background: var(--primary-50); }
    .fb-history-ver {
      font: 600 11px var(--font-sans); color: var(--surface-500);
      white-space: nowrap; min-width: 56px;
    }
    .fb-history-item.is-current .fb-history-ver { color: var(--primary-600); }
    .fb-history-detail { flex: 1; }
    .fb-history-who {
      font-weight: 500; color: var(--surface-800);
    }
    .fb-history-time {
      color: var(--surface-400); margin-left: 4px;
    }
    .fb-history-tag {
      font: 500 10px var(--font-sans); letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 2px 6px; border-radius: 4px;
      background: var(--primary-100); color: var(--primary-700);
      white-space: nowrap;
    }
    .fb-history-tag.tag-ai {
      background: var(--surface-100); color: var(--surface-500);
    }
    .fb-history-tag.tag-current {
      background: var(--primary-100); color: var(--primary-700);
    }

    /* --- Revert bar --- */
    .fb-revert-bar {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      background: var(--surface-100);
      border: 1px solid var(--surface-200);
      border-radius: 8px;
      font: 400 12px var(--font-sans); color: var(--surface-700);
    }
    .fb-revert-bar i { color: var(--surface-500); font-size: 14px; flex-shrink: 0; }
    .fb-revert-bar-text { flex: 1; }
    .fb-revert-confirm {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      background: var(--warn-100);
      border: 1px solid #fcd34d;
      border-radius: 8px;
      font: 400 12px/1.45 var(--font-sans); color: var(--surface-800);
    }
    .fb-revert-confirm i { font-size: 14px; flex-shrink: 0; color: var(--warn-500); }
    .fb-revert-confirm-text { flex: 1; }

    /* --- Variability comparison (left pane) --- */
    .fb-variability-banner {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 14px;
      background: var(--warn-100);
      border-bottom: 1px solid #fcd34d;
      font: 500 12px var(--font-sans); color: var(--warn-600);
    }
    .fb-variability-banner i { font-size: 14px; flex-shrink: 0; }

    .fb-run-compare {
      width: 100%; border-collapse: collapse;
      font: 400 11px var(--font-sans); color: var(--surface-700);
    }
    .fb-run-compare thead th {
      padding: 7px 12px;
      font: 600 10px var(--font-sans); letter-spacing: 0.07em;
      text-transform: uppercase; color: var(--surface-500);
      border-bottom: 1px solid var(--surface-100);
      text-align: left;
    }
    .fb-run-compare thead th:not(:first-child) { text-align: center; }
    .fb-run-compare td {
      padding: 7px 12px;
      border-bottom: 1px solid var(--surface-100);
      vertical-align: middle;
    }
    .fb-run-compare tbody tr:last-child td { border-bottom: none; }
    .fb-run-compare td.run-score { text-align: center; font-weight: 500; color: var(--surface-900); }
    .fb-run-compare td.run-score.mismatch {
      color: var(--warn-600);
    }

    /* =====================================================
       Feedback Review — Sub-section C
       Quality indicators (confidence, variability flag, review priority)
       ===================================================== */

    /* Indicator row — sits between status bar and editor card */
    .fb-quality-row {
      display: flex; align-items: center; gap: 8px;
      flex-wrap: wrap;
    }
    .fb-quality-label {
      font: 600 10px/1 var(--font-sans);
      letter-spacing: 0.07em; text-transform: uppercase;
      color: var(--surface-400);
      white-space: nowrap;
      margin-right: 4px;
    }

    /* Base chip */
    .fb-quality-chip {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 4px 9px;
      border-radius: 20px;
      border: 1px solid transparent;
      font: 500 11px/1 var(--font-sans);
      white-space: nowrap;
      cursor: default;
      transition: opacity 0.15s;
    }
    .fb-quality-chip i { font-size: 12px; flex-shrink: 0; }

    /* Confidence chip states */
    .fb-confidence-high {
      background: var(--success-100); color: var(--success-600);
    }
    .fb-confidence-medium {
      background: var(--warn-100); color: var(--warn-600);
    }
    .fb-confidence-low {
      background: var(--error-100); color: var(--error-500);
    }

    /* Variability chip states */
    .fb-variability-clear {
      background: var(--surface-100); color: var(--surface-500);
      border-color: var(--surface-200);
    }
    .fb-variability-flagged {
      background: var(--warn-100); color: var(--warn-600);
    }

    /* Priority chip states */
    .fb-priority-normal {
      background: var(--surface-100); color: var(--surface-500);
      border-color: var(--surface-200);
    }
    .fb-priority-high {
      background: var(--error-100); color: var(--error-500);
    }
    .fb-priority-low {
      background: var(--surface-100); color: var(--surface-400);
      border-color: var(--surface-200);
    }

    /* =====================================================
       Modal
       ===================================================== */
    .modal-backdrop {
      position: absolute; inset: 0;
      background: rgba(15,23,42,.35);
      backdrop-filter: blur(2px);
      display: flex; align-items: center; justify-content: center;
      z-index: 50;
    }
    .modal {
      background: #fff; border-radius: 12px;
      box-shadow: var(--shadow-md);
      width: 420px;
      padding: 22px 24px 20px;
    }
    .modal-head {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 16px;
    }
    .modal-head h3 { font: 600 18px var(--font-sans); color: var(--surface-900); margin: 0; }
    .modal-close {
      width: 28px; height: 28px; border-radius: 9999px;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--surface-500);
    }
    .modal-close:hover { background: var(--surface-100); }
    .modal-section-label {
      font: 600 10px/1 var(--font-sans);
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--surface-500);
      padding-bottom: 8px;
    }
    .modal-card-row {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--surface-100);
    }
    .modal-card-row .avatar {
      width: 36px; height: 36px; border-radius: 9999px;
      background: var(--primary-100); color: var(--primary-700);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .modal-card-row .title { font: 600 13px var(--font-sans); color: var(--surface-900); }
    .modal-card-row .meta { font: 400 12px var(--font-sans); color: var(--surface-500); }
    .modal-kv {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 0; border-top: 1px solid var(--surface-100);
      font: 400 13px var(--font-sans);
    }
    .modal-kv .k { color: var(--surface-600); }
    .modal-kv .v { color: var(--surface-900); font-weight: 500; }

    /* =====================================================
       Candidate feedback
       ===================================================== */
    .feedback-shell { background: var(--surface-50); height: 100%; overflow: auto; padding: 28px 40px 60px; }
    .feedback-card {
      max-width: 720px; margin: 0 auto;
      background: #fff;
      border: 1px solid var(--surface-200);
      border-radius: 12px;
      padding: 28px 36px 36px;
      position: relative;
    }
    .feedback-card .sub-details-btn {
      position: absolute; top: 22px; right: 22px;
    }
    .feedback-header { text-align: center; }
    .feedback-header .eyebrow {
      font: 600 11px/1 var(--font-sans);
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--surface-500);
    }
    .feedback-header h1 {
      font: 700 28px/1.2 var(--font-sans);
      color: var(--surface-900);
      margin: 10px 0 10px;
      letter-spacing: -0.01em;
    }
    .feedback-header .score-label {
      font: 600 11px/1 var(--font-sans);
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--surface-500);
    }
    .feedback-header .score {
      font: 600 32px/1.2 var(--font-sans);
      color: var(--surface-900);
      margin-top: 4px;
    }
    .feedback-tabs {
      display: flex; justify-content: center; gap: 22px;
      padding-top: 18px;
      border-bottom: 1px solid var(--surface-200);
      margin: 12px -36px 0;
      padding-left: 36px; padding-right: 36px;
    }
    .feedback-tabs .tab {
      padding: 8px 0 12px;
      font: 500 14px var(--font-sans);
      color: var(--surface-500);
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      cursor: pointer;
    }
    .feedback-tabs .tab.active {
      color: var(--primary-700);
      border-bottom-color: var(--primary-600);
    }

    .feedback-body { padding-top: 20px; }
    .feedback-body h4 { font: 600 14px var(--font-sans); color: var(--surface-900); margin: 18px 0 8px; }
    .feedback-body p { font: 400 14px/1.6 var(--font-sans); color: var(--surface-700); margin: 0 0 10px; }
    .feedback-body strong { color: var(--surface-900); font-weight: 600; }

    .feedback-grading thead th {
      background: transparent;
      padding: 10px 0;
      text-align: left;
      font: 600 11px/1 var(--font-sans);
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--surface-500);
      border-bottom: 1px solid var(--surface-200);
    }
    .feedback-grading { width: 100%; border-collapse: collapse; margin-top: 6px; }
    .feedback-grading .expand td {
      padding: 14px 0;
      border-bottom: 1px solid var(--surface-100);
      font: 500 14px var(--font-sans);
      color: var(--surface-900);
    }
    .feedback-grading td.right { text-align: right; }
    .feedback-grading .expand .category-label {
      display: inline-flex; align-items: center; gap: 8px;
    }
    .feedback-grading .expand .category-label i { color: var(--surface-400); font-size: 14px; }
    .feedback-grading .rationale td {
      padding: 8px 0 16px; color: var(--surface-700);
      font: 400 13px/1.55 var(--font-sans);
    }

    .chat-body {
      padding-top: 12px;
      display: flex; flex-direction: column;
      min-height: 420px;
    }
    .chat-messages { flex: 1; padding-bottom: 20px; }
    .chat-line { margin: 0 0 8px; font: 400 14px/1.55 var(--font-sans); color: var(--surface-800); }
    .chat-list { padding-left: 20px; margin: 0 0 10px; }
    .chat-list li { font: 400 14px/1.5 var(--font-sans); color: var(--surface-700); margin: 2px 0; }
    .chat-list.ordered { list-style: decimal; }
    .chat-list.bulleted { list-style: disc; }
    .chat-time { font: 400 11px var(--font-sans); color: var(--surface-400); margin-top: 8px; }
    .chat-input-row {
      position: relative; margin-top: 20px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      padding: 12px 48px 12px 14px;
      min-height: 44px;
      display: flex; align-items: center;
      color: var(--surface-400);
      font: 400 13px var(--font-sans);
    }
    .chat-input-row button.send {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      width: 30px; height: 30px; border-radius: 6px;
      background: var(--primary-600); color: #fff;
      display: inline-flex; align-items: center; justify-content: center;
    }

    .submission-inline {
      margin-top: 16px;
      border: 1px solid var(--surface-200);
      border-radius: 10px;
      overflow: hidden;
    }
    .submission-inline .head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 12px;
      border-bottom: 1px solid var(--surface-100);
      background: var(--surface-50);
      font: 500 12px var(--font-sans); color: var(--surface-700);
    }
    .submission-inline .head .spacer { flex: 1; }
    .submission-inline .body-doc {
      padding: 14px; display: grid; grid-template-columns: 56px 1fr; gap: 12px;
    }
    .inline-doc-pages { background: var(--surface-100); border-radius: 6px; padding: 8px; display: flex; flex-direction: column; gap: 6px; }
    .inline-doc-pages .ipage {
      background: #fff; border: 1px solid var(--surface-200);
      border-radius: 3px; height: 48px; font: 500 10px var(--font-sans);
      color: var(--surface-400); display: flex; align-items: flex-end; justify-content: center; padding-bottom: 3px;
    }
    .inline-doc-pages .ipage.active { outline: 2px solid var(--primary-400); }
    .inline-doc-body { font: 400 12px/1.5 var(--font-body); color: var(--surface-800); max-height: 260px; overflow: hidden; }
    .inline-doc-body h5 { font: 700 15px var(--font-sans); color: var(--surface-900); margin: 0 0 8px; }
    .inline-doc-body p { margin: 0 0 8px; }

    /* Utility */
    .sr { position: absolute; left: -9999px; }

    /* Browser chrome */
    .browser-top {
      height: 30px; background: var(--surface-50);
      border-bottom: 1px solid var(--surface-200);
      display: flex; align-items: center; justify-content: center;
      font: 500 12px var(--font-sans); color: var(--surface-500);
      gap: 8px;
    }
    .browser-top i { font-size: 12px; color: var(--surface-400); }

    /* ---------------------------------------------------------------
       Developer-tools bar — sticky, prototype-only.
       Houses every demo/scenario control and view-toggle in one place
       and is intentionally styled distinctly from the prototype UI so
       it reads as tooling, not product. NEVER place demo controls
       inside the prototype surfaces — they belong here only.
       --------------------------------------------------------------- */
    :root { --devbar-h: 44px; }
    .devbar {
      position: fixed; left: 0; right: 0; bottom: 0;
      height: var(--devbar-h);
      background: var(--surface-900);
      color: rgba(255,255,255,0.78);
      border-top: 1px solid rgba(255,255,255,0.08);
      font-family: var(--font-mono);
      font-size: 11px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 14px;
      overflow-x: auto;
      white-space: nowrap;
      box-shadow: 0 -8px 24px rgba(0,0,0,0.25);
    }
    .devbar__brand {
      display: inline-flex; align-items: center; gap: 6px;
      color: rgba(255,255,255,0.55);
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding-right: 12px;
      border-right: 1px solid rgba(255,255,255,0.1);
      flex-shrink: 0;
    }
    .devbar__brand i { font-size: 12px; }
    .devbar__group {
      display: inline-flex; align-items: center; gap: 4px;
      padding-right: 12px;
      border-right: 1px solid rgba(255,255,255,0.08);
      flex-shrink: 0;
    }
    .devbar__group:last-child { border-right: none; padding-right: 0; }
    .devbar__label {
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-right: 6px;
    }
    .devbar__btn {
      appearance: none;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.82);
      font: inherit;
      padding: 4px 8px;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .devbar__btn:hover {
      background: rgba(255,255,255,0.12);
      border-color: rgba(255,255,255,0.2);
      color: #fff;
    }
    .devbar__btn.active {
      background: var(--primary-600);
      border-color: var(--primary-500);
      color: #fff;
    }
  </style>
</head>
<body>

<div class="app" id="app" data-view="studio">

  <!-- ====================== SIDEBAR ====================== -->

  <!-- Studio sidebar (tests sub-section) -->
  <aside class="sidebar" data-shell="studio">
    <div class="sb-top">
      <img class="wordmark" src="../../assets/logos/studio_full_light.svg" alt="Traverse Studio"/>
      <span class="spacer"></span>
      <button class="sb-collapse js-sidebar-collapse" aria-label="Collapse sidebar" aria-pressed="false"><i class="icon-panel-left-close"></i></button>
    </div>
    <div class="sb-workspace">
      <span class="sb-avatar" style="background-image: linear-gradient(135deg, #6366f1, #db2777);"></span>
      <span class="name">David Guetta</span>
      <i class="icon-chevron-down chev"></i>
    </div>
    <button class="sb-back"><i class="icon-arrow-left"></i> Back</button>
    <button class="nav-item active" data-goto="test-list" title="Tests">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></span>
      <span class="ni-label">Tests</span>
    </button>
    <button class="nav-item" title="Assessments">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v4l-5 9a3 3 0 003 4h10a3 3 0 003-4l-5-9V3M9 3h6"/></svg></span>
      <span class="ni-label">Assessments</span>
    </button>
    <button class="nav-item" title="Rubrics">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 7h3M3 12h3M3 17h3"/><rect x="9" y="5" width="12" height="14" rx="1"/></svg></span>
      <span class="ni-label">Rubrics</span>
      <span class="badge">COMING</span>
    </button>
  </aside>

  <!-- Candidate sidebar (feedback) -->
  <aside class="sidebar" data-shell="candidate" style="display:none;">
    <div class="sb-top">
      <img class="wordmark" src="../../assets/logos/studio_full_light.svg" alt="Traverse Studio"/>
      <span class="spacer"></span>
      <button class="sb-collapse js-sidebar-collapse" aria-label="Collapse sidebar" aria-pressed="false"><i class="icon-panel-left-close"></i></button>
    </div>
    <div class="sb-workspace">
      <span class="sb-avatar" style="background-image: linear-gradient(135deg, #94a3b8, #334155);"></span>
      <span class="name">David Guetta</span>
      <i class="icon-chevron-down chev"></i>
    </div>
    <div class="sb-eyebrow">Summary</div>
    <button class="nav-item" title="Dashboard">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg></span>
      <span class="ni-label">Dashboard</span>
    </button>
    <button class="nav-item" title="Simulations">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16"/></svg></span>
      <span class="ni-label">Simulations</span>
    </button>
    <button class="nav-item" title="Assessments">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 3v4l-5 9a3 3 0 003 4h10a3 3 0 003-4l-5-9V3M9 3h6"/></svg></span>
      <span class="ni-label">Assessments</span>
    </button>
    <button class="nav-item" title="Sequences">
      <span class="ni-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 8l9 5 9-5-9-5z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/></svg></span>
      <span class="ni-label">Sequences</span>
    </button>
  </aside>

  <!-- ====================== MAIN ====================== -->
  <main class="main-wrap">
    <div class="content-window" id="contentWindow">

      <!-- ========== SCREEN: Test list ========== -->
      <section class="screen active" data-screen="test-list">
        <div class="tests-header">
          <h1 class="page-title">Tests</h1>
          <p class="page-subtitle">Manage the tests in your workspace.</p>
        </div>
        <div class="tests-tabs">
          <button class="tab active">Authored</button>
        </div>
        <div class="tests-toolbar">
          <div class="search-input"><i class="icon-search"></i><input class="input" placeholder="Type to search"/></div>
          <select class="select"><option>By type</option></select>
          <div class="new-test-wrap">
            <button class="btn outline" id="newTestBtn" aria-haspopup="menu" aria-expanded="false">
              <i class="icon-plus"></i> New
            </button>
            <div class="menu new-test-menu" id="newTestMenu" role="menu">
              <button class="item" role="menuitem" data-new-test="likert"><i class="icon-scale"></i> Likert Test</button>
              <button class="item" role="menuitem" data-new-test="mcq"><i class="icon-list"></i> MCQ Test</button>
              <button class="item" role="menuitem" data-new-test="written"><i class="icon-pencil"></i> Written Test</button>
              <button class="item" role="menuitem" data-new-test="submission"><i class="icon-upload"></i> Submission Test</button>
              <button class="item" role="menuitem" data-new-test="simulation"><i class="icon-flask-conical"></i> Simulation Test</button>
              <div class="sep"></div>
              <button class="item" role="menuitem" data-new-test="import"><i class="icon-file-input"></i> Import Test</button>
            </div>
          </div>
        </div>

        <table class="tests-table">
          <thead>
            <tr>
              <th>Title <span class="sort-handle"><i class="icon-chevron-up"></i><i class="icon-chevron-down"></i></span></th>
              <th style="width: 160px;">Feedback <span class="sort-handle"><i class="icon-chevron-up"></i><i class="icon-chevron-down"></i></span></th>
              <th style="width: 120px;">Connections <span class="sort-handle"><i class="icon-chevron-up"></i><i class="icon-chevron-down"></i></span></th>
              <th style="width: 40px;"></th>
            </tr>
          </thead>
          <tbody id="testsTableBody">
            <!-- Rows injected via JS -->
          </tbody>
        </table>

        <!-- Context menu for test row -->
        <div class="menu" id="testRowMenu">
          <button class="item"><i class="icon-pencil"></i> Edit</button>
          <button class="item"><i class="icon-copy"></i> Duplicate</button>
          <button class="item"><i class="icon-play"></i> Preview</button>
          <button class="item"><i class="icon-link"></i> Get Access Link</button>
          <button class="item" data-goto="test-summary"><i class="icon-list-checks"></i> View Submissions</button>
          <button class="item"><i class="icon-lock"></i> Lock Test</button>
          <button class="item"><i class="icon-braces"></i> Export as JSON</button>
          <button class="item"><i class="icon-pin"></i> Pin <i class="icon-chevron-right chev-right"></i></button>
          <div class="sep"></div>
          <button class="item" style="color: var(--error-500);"><i class="icon-trash-2" style="color: var(--error-500);"></i> Delete</button>
        </div>
      </section>

      <!-- ========== SCREEN: New test (Settings) ========== -->
      <section class="screen" data-screen="new-test-submission">
        <div class="builder-header">
          <div>
            <div class="crumbs">
              <a data-goto="test-list">Tests</a>
            </div>
            <div class="builder-title">
              <h1>New Test</h1>
              <span class="draft-dot">Draft</span>
            </div>
            <div class="tabs-pill" style="margin-top: 14px;">
              <button class="tab active" data-builder-tab="settings">Test Settings</button>
              <button class="tab" data-builder-tab="grading">Grading Criteria</button>
              <button class="tab" data-builder-tab="feedback">Feedback Settings</button>
            </div>
          </div>
          <div class="builder-top-right">
            <span class="unsaved"><i class="icon-circle"></i> Unsaved changes</span>
            <button class="btn primary">Save <span class="hk">⌘↵</span></button>
          </div>
        </div>

        <!-- Settings panel -->
        <div class="form-body" data-builder-panel="settings">
          <div class="section-header"><i class="icon-chevron-down"></i> General</div>
          <div class="field-row">
            <div class="field-label">
              <span class="label">Type of Submission</span>
              <span class="desc">What type of media will the candidate submit?</span>
            </div>
            <div class="field-control">
              <select class="select"><option>Document</option></select>
            </div>
          </div>
          <div class="field-row">
            <div class="field-label">
              <span class="label">Test objective</span>
              <span class="desc">What is the test objective?</span>
              <span class="word-count">0/100 words</span>
            </div>
            <div class="field-control">
              <textarea class="textarea" rows="3" placeholder="Enter objective"></textarea>
            </div>
          </div>

          <div class="section-header"><i class="icon-chevron-down"></i> Presentation</div>
          <div class="field-row">
            <div class="field-label">
              <span class="label">Heading</span>
              <span class="desc">A friendly heading for the test</span>
            </div>
            <div class="field-control">
              <input class="input" placeholder="Enter heading"/>
            </div>
          </div>
          <div class="field-row">
            <div class="field-label">
              <span class="label">Introduction</span>
              <span class="desc">A brief introduction for the test</span>
              <span class="word-count">0/1000 words</span>
            </div>
            <div class="field-control">
              <textarea class="textarea" rows="4" placeholder="Enter introduction"></textarea>
            </div>
          </div>
          <div class="field-row">
            <div class="field-label">
              <span class="label">Background</span>
              <span class="desc">Provide a background image for the test</span>
            </div>
            <div class="field-control">
              <select class="select"><option>No Background</option></select>
            </div>
          </div>

        </div>

        <!-- Feedback Settings panel -->
        <div class="form-body" data-builder-panel="feedback" style="display:none;">
          <!-- ======================================================
               Feedback Settings — generation, delivery, display
               ====================================================== -->

          <!-- (a) FEEDBACK GENERATION -->
          <div class="subsection-header"><i class="icon-chevron-down"></i> Feedback Generation</div>

          <!-- Master toggle: Enable Feedback -->
          <div class="field-row feedback-gen-master-row">
            <div class="field-label">
              <label class="label" for="sw-enable-feedback">Enable Feedback <i class="icon-circle-help" style="color:var(--surface-400);font-size:12px;"></i></label>
              <span class="desc">Generate AI feedback for each submission. Turn off to disable all feedback generation for this test.</span>
            </div>
            <div class="field-control feedback-gen-switch-control">
              <span
                class="switch on"
                id="sw-enable-feedback"
                role="switch"
                aria-checked="true"
                aria-label="Enable Feedback"
                tabindex="0"
                data-switch
                data-feedback-master
              ></span>
            </div>
          </div>

          <!-- Collapsible generation settings — hidden when master toggle is off -->
          <div id="feedback-gen-settings" class="feedback-gen-settings">

            <!-- Feedback Event Type — separate from the standard/custom either-or below -->
            <div class="field-row feedback-gen-row">
              <div class="field-label">
                <label class="label" for="sel-event-type">Feedback Event Type</label>
                <span class="desc">Per Assessment generates feedback after each individual submission. Summative generates feedback at the end of an assessment sequence.</span>
              </div>
              <div class="field-control">
                <select class="select" id="sel-event-type" name="feedback-event-type">
                  <option value="per-assessment" selected>Per Assessment</option>
                  <option value="summative">Summative</option>
                </select>
              </div>
            </div>

            <!-- ===== Standard configuration (Tone / Length / Detail Level) ===== -->
            <div id="fb-standard-config" class="feedback-config-group">
              <div class="feedback-config-group__head">
                <span class="feedback-config-group__title"><i class="icon-sliders-horizontal"></i> Standard configuration</span>
                <span class="feedback-config-group__hint">Compose feedback by choosing how it should sound, how long it should be, and how directly it should answer.</span>
              </div>
              <div class="feedback-config-replaced-banner">
                <i class="icon-info"></i>
                <span>Replaced by your custom prompt below. Clear the custom prompt to use these settings.</span>
              </div>

              <!-- Tone -->
              <div class="field-row feedback-gen-row">
                <div class="field-label">
                  <label class="label" for="sel-tone">Tone</label>
                  <span class="desc">Sets the voice and style of the generated feedback.</span>
                </div>
                <div class="field-control">
                  <select class="select" id="sel-tone" name="feedback-tone">
                    <option value="supportive">Supportive / Coaching</option>
                    <option value="default" selected>Default (Balanced)</option>
                    <option value="direct">Direct</option>
                  </select>
                </div>
              </div>

              <!-- Length -->
              <div class="field-row feedback-gen-row">
                <div class="field-label">
                  <label class="label" for="sel-length">Length</label>
                  <span class="desc">Approximate word count of the generated feedback.</span>
                </div>
                <div class="field-control">
                  <select class="select" id="sel-length" name="feedback-length">
                    <option value="brief">Brief — 100–200 words</option>
                    <option value="standard" selected>Standard — 200–400 words</option>
                    <option value="detailed">Detailed — 400–600 words</option>
                  </select>
                </div>
              </div>

              <!-- Detail Level -->
              <div class="field-row feedback-gen-row">
                <div class="field-label">
                  <label class="label" for="sel-detail">Detail Level</label>
                  <span class="desc">Guidance-focused keeps feedback instructional. Answer-focused reveals more of what a correct response would look like. Balanced is the default.</span>
                </div>
                <div class="field-control">
                  <select class="select" id="sel-detail" name="feedback-detail">
                    <option value="guidance">Guidance-focused</option>
                    <option value="balanced" selected>Balanced</option>
                    <option value="answer">Answer-focused</option>
                  </select>
                </div>
              </div>
            </div><!-- /#fb-standard-config -->

            <!-- OR divider — signals either/or relationship with the custom prompt below -->
            <div class="feedback-config-or" aria-hidden="true"><span>Or take more control</span></div>

            <!-- ===== Custom prompt (alternative to standard configuration) ===== -->
            <div id="fb-custom-config" class="feedback-config-group">
              <div class="feedback-config-group__head">
                <span class="feedback-config-group__title"><i class="icon-wand-sparkles"></i> Custom prompt</span>
                <span class="feedback-config-group__hint">Write your own instructions for the AI. When this is filled in, it replaces tone, length, and detail level above and gives you full control over how feedback is written.</span>
              </div>

              <div class="field-row feedback-gen-row">
                <div class="field-label">
                  <label class="label" for="ta-custom-prompt">Custom prompt <span style="font-weight:400;color:var(--surface-400);">(optional)</span></label>
                  <span class="desc">Leave blank to keep the standard configuration above. Add a prompt to override it entirely.</span>
                  <span class="word-count" id="custom-prompt-count">0/500 words</span>
                </div>
                <div class="field-control">
                  <textarea
                    class="textarea"
                    id="ta-custom-prompt"
                    name="feedback-custom-prompt"
                    rows="6"
                    placeholder="e.g. Write feedback in a warm, encouraging second-person voice, no longer than 200 words. Focus on the single most impactful next step the candidate could take, rather than listing every issue. Reference one concrete moment from their submission. End with a question that prompts reflection."
                    maxlength="3000"
                    data-wordcount="custom-prompt-count"
                  ></textarea>
                </div>
              </div>
            </div><!-- /#fb-custom-config -->

            <!-- ============================================================
                 ALTERNATIVE VIEW (for design comparison only) — duplicates
                 the two groups above into a single card with two tabs.
                 ============================================================ -->
            <div class="feedback-config-tabs-eyebrow"><span>Alternative view — tabbed</span></div>
            <div id="fb-config-tabs-card" class="feedback-config-tabs-card">
              <div class="feedback-config-tabs-strip" role="tablist">
                <button type="button" class="tab active" role="tab" data-fb-config-tab="standard" aria-selected="true">
                  <i class="icon-sliders-horizontal"></i>
                  <span>Standard configuration</span>
                  <span class="override-badge">Overridden</span>
                </button>
                <button type="button" class="tab" role="tab" data-fb-config-tab="custom" aria-selected="false">
                  <i class="icon-wand-sparkles"></i>
                  <span>Custom prompt</span>
                </button>
              </div>

              <!-- Standard tab panel -->
              <div class="feedback-config-tab-panel" data-fb-config-panel="standard" role="tabpanel">
                <p class="feedback-config-tab-panel__hint">Compose feedback by choosing how it should sound, how long it should be, and how directly it should answer.</p>
                <div class="feedback-config-replaced-banner">
                  <i class="icon-info"></i>
                  <span>Replaced by your custom prompt. Clear the custom prompt to use these settings.</span>
                </div>

                <!-- Tone -->
                <div class="field-row feedback-gen-row">
                  <div class="field-label">
                    <label class="label" for="sel-tone-alt">Tone</label>
                    <span class="desc">Sets the voice and style of the generated feedback.</span>
                  </div>
                  <div class="field-control">
                    <select class="select" id="sel-tone-alt" name="feedback-tone-alt">
                      <option value="supportive">Supportive / Coaching</option>
                      <option value="default" selected>Default (Balanced)</option>
                      <option value="direct">Direct</option>
                    </select>
                  </div>
                </div>

                <!-- Length -->
                <div class="field-row feedback-gen-row">
                  <div class="field-label">
                    <label class="label" for="sel-length-alt">Length</label>
                    <span class="desc">Approximate word count of the generated feedback.</span>
                  </div>
                  <div class="field-control">
                    <select class="select" id="sel-length-alt" name="feedback-length-alt">
                      <option value="brief">Brief — 100–200 words</option>
                      <option value="standard" selected>Standard — 200–400 words</option>
                      <option value="detailed">Detailed — 400–600 words</option>
                    </select>
                  </div>
                </div>

                <!-- Detail Level -->
                <div class="field-row feedback-gen-row">
                  <div class="field-label">
                    <label class="label" for="sel-detail-alt">Detail Level</label>
                    <span class="desc">Guidance-focused keeps feedback instructional. Answer-focused reveals more of what a correct response would look like. Balanced is the default.</span>
                  </div>
                  <div class="field-control">
                    <select class="select" id="sel-detail-alt" name="feedback-detail-alt">
                      <option value="guidance">Guidance-focused</option>
                      <option value="balanced" selected>Balanced</option>
                      <option value="answer">Answer-focused</option>
                    </select>
                  </div>
                </div>
              </div><!-- /standard panel -->

              <!-- Custom tab panel -->
              <div class="feedback-config-tab-panel" data-fb-config-panel="custom" role="tabpanel" hidden>
                <p class="feedback-config-tab-panel__hint">Write your own instructions for the AI. When this is filled in, it replaces tone, length, and detail level and gives you full control over how feedback is written.</p>

                <div class="field-row feedback-gen-row">
                  <div class="field-label">
                    <label class="label" for="ta-custom-prompt-alt">Custom prompt <span style="font-weight:400;color:var(--surface-400);">(optional)</span></label>
                    <span class="desc">Leave blank to keep the standard configuration. Add a prompt to override it entirely.</span>
                    <span class="word-count" id="custom-prompt-count-alt">0/500 words</span>
                  </div>
                  <div class="field-control">
                    <textarea
                      class="textarea"
                      id="ta-custom-prompt-alt"
                      name="feedback-custom-prompt-alt"
                      rows="6"
                      placeholder="e.g. Write feedback in a warm, encouraging second-person voice, no longer than 200 words. Focus on the single most impactful next step the candidate could take, rather than listing every issue. Reference one concrete moment from their submission. End with a question that prompts reflection."
                      maxlength="3000"
                      data-wordcount="custom-prompt-count-alt"
                    ></textarea>
                  </div>
                </div>
              </div><!-- /custom panel -->
            </div><!-- /#fb-config-tabs-card -->

            <!-- Additional Context -->
            <div class="field-row feedback-gen-row">
              <div class="field-label">
                <label class="label" for="ta-additional-context">Additional Context <span style="font-weight:400;color:var(--surface-400);">(optional)</span></label>
                <span class="desc">Supplementary information passed alongside the standard prompt — for example, course-level expectations, marking conventions, or cohort context. Unlike Custom Prompt, this does not replace the default instructions.</span>
                <span class="word-count" id="additional-context-count">0/300 words</span>
              </div>
              <div class="field-control">
                <textarea
                  class="textarea"
                  id="ta-additional-context"
                  name="feedback-additional-context"
                  rows="3"
                  placeholder="e.g. "Students are in their first year of study and have not yet covered citation conventions.""
                  maxlength="2000"
                  data-wordcount="additional-context-count"
                ></textarea>
              </div>
            </div>

          </div><!-- /feedback-gen-settings -->

          <!-- Disabled notice shown when Enable Feedback is off -->
          <div id="feedback-gen-off-notice" class="feedback-gen-off-notice" style="display:none;">
            <i class="icon-info" style="color:var(--surface-400);font-size:14px;flex-shrink:0;"></i>
            <span>Enable Feedback to configure feedback settings. Feedback will not be generated for this test while this is off.</span>
          </div>

          <div id="feedback-delivery-display">

          <!-- (b) FEEDBACK DELIVERY -->
          <div class="subsection-header" style="margin-top:8px;"><i class="icon-chevron-down"></i> Feedback Delivery</div>
          <div class="field-row">
            <div class="field-label">
              <span class="label">Delivery options</span>
              <span class="desc">Configure how feedback is sent to candidates</span>
            </div>
            <div class="field-control feedback-delivery-stack">
              <div class="feedback-switch-row">
                <span class="switch on" role="switch" aria-checked="true" aria-label="Show feedback on test completion" tabindex="0" data-switch></span>
                <span class="label">Show feedback on test completion</span>
              </div>
              <div class="feedback-switch-row">
                <span class="switch" role="switch" aria-checked="false" aria-label="Email" tabindex="0" data-switch></span>
                <span class="label">Email</span>
              </div>
              <div class="feedback-switch-row">
                <span class="switch" role="switch" aria-checked="false" aria-label="Link" tabindex="0" data-switch></span>
                <span class="label">Link</span>
              </div>
            </div>
          </div>

          <!-- (c) FEEDBACK DISPLAY -->
          <div class="feedback-display-greyed" aria-disabled="true">
            <div class="subsection-header" style="margin-top:8px;"><i class="icon-chevron-down"></i> Feedback Display</div>
            <div class="field-row">
              <div class="field-label">
                <span class="label">Display options</span>
                <span class="desc">Control which elements of the feedback are visible to candidates</span>
              </div>
              <div class="field-control feedback-delivery-stack">
                <div class="feedback-switch-row">
                  <span class="switch on" role="switch" aria-checked="true" aria-label="Show feedback header" tabindex="-1" data-switch></span>
                  <span class="label">Show feedback header <i class="icon-circle-help" style="color:var(--surface-400);font-size:12px;"></i></span>
