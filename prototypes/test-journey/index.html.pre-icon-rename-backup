  // Word-count helper for feedback generation textareas
  function updateWordCount(textarea) {
    const targetId = textarea.getAttribute('data-wordcount');
    if (!targetId) return;
    const display = document.getElementById(targetId);
    if (!display) return;
    const words = textarea.value.trim() === '' ? 0 : textarea.value.trim().split(/\s+/).length;
    const maxWords = (targetId === 'custom-prompt-count' || targetId === 'custom-prompt-count-alt') ? 500 : 300;
    display.textContent = words + '/' + maxWords + ' words';
  }
  document.querySelectorAll('textarea[data-wordcount]').forEach(function(ta) {
    ta.addEventListener('input', function() { updateWordCount(ta); });
  });

  // Custom prompt overrides Standard configuration (Tone / Length / Detail Level).
  // When the custom prompt has any content, grey out the standard group and
  // visually elevate the custom group so the either/or relationship is clear.
  (function syncCustomPromptOverride() {
    const ta       = document.getElementById('ta-custom-prompt');
    const standard = document.getElementById('fb-standard-config');
    const custom   = document.getElementById('fb-custom-config');
    if (!ta || !standard || !custom) return;
    const apply = function() {
      const hasContent = ta.value.trim().length > 0;
      standard.classList.toggle('is-disabled', hasContent);
      custom.classList.toggle('is-active', hasContent);
      // Disable the underlying selects so they're truly inert, not just dimmed.
      standard.querySelectorAll('select').forEach(function(s) { s.disabled = hasContent; });
    };
    ta.addEventListener('input', apply);
    apply();
  })();

  // Alternative-view tabbed card: tab switching + override sync.
  (function syncTabbedConfigCard() {
    const card = document.getElementById('fb-config-tabs-card');
    if (!card) return;
    const tabs   = card.querySelectorAll('[data-fb-config-tab]');
    const panels = card.querySelectorAll('[data-fb-config-panel]');
    const standardPanel = card.querySelector('[data-fb-config-panel="standard"]');
    const ta = document.getElementById('ta-custom-prompt-alt');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const which = tab.getAttribute('data-fb-config-tab');
        tabs.forEach(function(t) {
          const active = t === tab;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach(function(p) {
          p.hidden = p.getAttribute('data-fb-config-panel') !== which;
        });
      });
    });

    if (!ta || !standardPanel) return;
    const apply = function() {
      const hasContent = ta.value.trim().length > 0;
      card.classList.toggle('is-overridden', hasContent);
      standardPanel.classList.toggle('is-disabled', hasContent);
      standardPanel.querySelectorAll('select').forEach(function(s) { s.disabled = hasContent; });
    };
    ta.addEventListener('input', apply);
    apply();
  })();

