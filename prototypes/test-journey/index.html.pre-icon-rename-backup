      font-size: 11px;
    }
    .achievement-row .name { font: 600 14px var(--font-sans); color: var(--surface-900); }

    .add-level-row, .add-category-row {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 14px;
