    function setPriority(level) {
      if (!priorityChip || !priorityLabel) return;
      var cfg = priorityLevels[level] || priorityLevels.normal;
      Object.values(priorityLevels).forEach(function(c) { priorityChip.classList.remove(c.cls); });
      priorityChip.classList.add(cfg.cls);
