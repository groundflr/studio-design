  // -------------------------------------------------------
  // Group 2 — Feedback Review & Edit (Sub-section A)
  // -------------------------------------------------------
  (function initFeedbackReview() {

    // ---- Element references ----
    var editBtn      = document.getElementById('fb-edit-btn');
    var saveBtn      = document.getElementById('fb-save-btn');
    var cancelBtn    = document.getElementById('fb-cancel-btn');
    var approveBtn   = document.getElementById('fb-approve-btn');
    var confirmBar   = document.getElementById('fb-confirm-bar');
    var confirmOk    = document.getElementById('fb-confirm-approve-btn');
    var confirmCancel= document.getElementById('fb-confirm-cancel-btn');
    var editRegion   = document.getElementById('fb-edit-region');
    var toolbar      = document.getElementById('fb-toolbar');
    var wordCount    = document.getElementById('fb-word-count');
    var editHint     = document.getElementById('fb-edit-hint');
    var editorCard   = document.getElementById('fb-editor-card');
    var statusBadge  = document.getElementById('fb-status-badge');
    var announce     = document.getElementById('fb-status-announce');
    var actionBar    = document.getElementById('fb-action-bar');

    // State panels
    var stateReady   = document.getElementById('fb-state-ready');
    var statePending = document.getElementById('fb-state-pending');
    var stateFailed  = document.getElementById('fb-state-failed');
    var retryBtn     = document.getElementById('fb-retry-btn');

    if (!editBtn) return; // guard: only wire up when panel exists in DOM

    // Preserved original content for cancel/revert
    var originalContent = editRegion ? editRegion.innerHTML : '';
    var isEditing = false;

    // ---- Word count updater ----
    function updateFbWordCount() {
      if (!editRegion || !wordCount) return;
      var text = editRegion.textContent || '';
      var words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
      wordCount.textContent = words + ' words';
    }

    // ---- Announce to screen readers ----
    function fbAnnounce(msg) {
      if (!announce) return;
      announce.textContent = '';
      // Force re-announcement by briefly clearing then setting
      setTimeout(function() { announce.textContent = msg; }, 50);
    }

    // ---- Badge helper ----
    var badgeStyles = {
      'DRAFT':        { bg: 'var(--warn-100)',    color: 'var(--warn-500)' },
      'UNDER REVIEW': { bg: 'var(--primary-100)', color: 'var(--primary-700)' },
      'APPROVED':     { bg: 'var(--success-100)', color: 'var(--success-600)' },
      'FAILED':       { bg: 'var(--error-100)',   color: 'var(--error-500)' }
    };
    function setStatusBadge(label) {
      if (!statusBadge) return;
      statusBadge.textContent = label;
      var style = badgeStyles[label] || badgeStyles['DRAFT'];
      statusBadge.style.background = style.bg;
      statusBadge.style.color = style.color;
    }

    // ---- Enter / exit edit mode ----
    function enterEditMode() {
      isEditing = true;
      editRegion.contentEditable = 'true';
      editRegion.setAttribute('aria-readonly', 'false');
      editRegion.classList.add('is-editing');
      if (editorCard) editorCard.classList.add('is-editing');
      if (toolbar)  toolbar.style.display = 'flex';
      editBtn.style.display  = 'none';
      saveBtn.style.display  = 'inline-flex';
      cancelBtn.style.display= 'inline-flex';
      if (editHint) editHint.textContent = 'Editing — changes are not yet saved';
      editRegion.focus();
      updateFbWordCount();
      fbAnnounce('Editing mode active.');
    }

    function exitEditMode(save) {
      isEditing = false;
      editRegion.contentEditable = 'false';
      editRegion.setAttribute('aria-readonly', 'true');
      editRegion.classList.remove('is-editing');
      if (editorCard) editorCard.classList.remove('is-editing');
      if (toolbar)  toolbar.style.display = 'none';
      editBtn.style.display  = 'inline-flex';
      saveBtn.style.display  = 'none';
      cancelBtn.style.display= 'none';
      if (save) {
        originalContent = editRegion.innerHTML; // update preserved snapshot
        setStatusBadge('DRAFT');
        if (editHint) editHint.textContent = 'Draft saved · click Edit to make further changes';
        fbAnnounce('Draft saved.');
      } else {
        editRegion.innerHTML = originalContent; // revert unsaved changes
        if (editHint) editHint.textContent = 'Click Edit to make changes';
        fbAnnounce('Changes discarded.');
      }
      updateFbWordCount();
    }

    // ---- Button handlers ----
    if (editBtn) editBtn.addEventListener('click', function() { enterEditMode(); });

    if (saveBtn) saveBtn.addEventListener('click', function() { exitEditMode(true); });

    if (cancelBtn) cancelBtn.addEventListener('click', function() { exitEditMode(false); });

    if (approveBtn) approveBtn.addEventListener('click', function() {
      if (!confirmBar) return;
      confirmBar.style.display = 'flex';
      approveBtn.style.display = 'none';
      fbAnnounce('Confirm approval to mark feedback as ready for release.');
    });

    if (confirmCancel) confirmCancel.addEventListener('click', function() {
      confirmBar.style.display = 'none';
      approveBtn.style.display = 'inline-flex';
      fbAnnounce('Approval cancelled.');
    });

    if (confirmOk) confirmOk.addEventListener('click', function() {
      confirmBar.style.display = 'none';
      setStatusBadge('APPROVED');
      // Disable edit and approve once approved
      editBtn.disabled = true;
      editBtn.style.opacity = '0.45';
      approveBtn.style.display = 'none';
      var statusMeta = document.querySelector('.fb-status-meta');
      if (statusMeta) statusMeta.textContent = 'Approved — ready for release';
      if (editHint) editHint.textContent = 'Feedback is approved and locked';
      fbAnnounce('Feedback approved and marked ready for release.');
    });

    // ---- Retry button (failed state) ----
    if (retryBtn) retryBtn.addEventListener('click', function() {
      // Simulate going back to pending, then ready after a brief delay
      if (stateFailed) stateFailed.style.display = 'none';
      if (statePending) statePending.style.display = 'block';
      fbAnnounce('Retrying feedback generation.');
      setTimeout(function() {
        if (statePending) statePending.style.display = 'none';
        if (stateReady) stateReady.style.display = 'block';
        fbAnnounce('Feedback generated successfully.');
      }, 2500);
    });

    // ---- Formatting toolbar ----
    if (toolbar) {
      toolbar.addEventListener('mousedown', function(e) {
        var btn = e.target.closest('[data-command]');
        if (!btn) return;
        e.preventDefault(); // prevent blur on editRegion
        document.execCommand(btn.getAttribute('data-command'), false, null);
        updateFbWordCount();
      });
    }

    // ---- Track word count while editing ----
    if (editRegion) {
      editRegion.addEventListener('input', updateFbWordCount);
    }

    // ---- Demo state switchers ----
    document.addEventListener('click', function(e) {
      var demoBtn = e.target.closest('[data-fb-demo]');
      if (!demoBtn) return;
      var state = demoBtn.getAttribute('data-fb-demo');
      // Hide all states first
      if (stateReady)   stateReady.style.display   = 'none';
      if (statePending) statePending.style.display  = 'none';
      if (stateFailed)  stateFailed.style.display   = 'none';
      if (state === 'pending') {
        statePending.style.display = 'block';
      } else if (state === 'failed') {
        stateFailed.style.display = 'block';
      } else if (state === 'approved') {
        stateReady.style.display = 'block';
        setStatusBadge('APPROVED');
        editBtn.disabled = true; editBtn.style.opacity = '0.45';
        approveBtn.style.display = 'none';
        var sm = document.querySelector('.fb-status-meta');
        if (sm) sm.textContent = 'Approved — ready for release';
        if (editHint) editHint.textContent = 'Feedback is approved and locked';
      } else if (state === 'under-review') {
        stateReady.style.display = 'block';
        setStatusBadge('UNDER REVIEW');
