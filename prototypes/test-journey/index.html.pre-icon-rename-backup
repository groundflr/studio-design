  document.addEventListener('click', (e) => {
    const gotoBtn = e.target.closest('[data-goto]');
    if (gotoBtn) {
      const journey = gotoBtn.getAttribute('data-journey');
      if (journey) setView(journey);
      showScreen(gotoBtn.getAttribute('data-goto'));
      return;
    }
    const viewBtn = e.target.closest('[data-view-toggle]');
    if (viewBtn) {
      const v = viewBtn.getAttribute('data-view-toggle');
      setView(v);
      if (v === 'candidate') showScreen('feedback-summary');
      else showScreen('test-list');
      return;
    }
    const openModal = e.target.closest('[data-open-modal]');
    if (openModal) {
      document.getElementById('detailsModal').style.display = 'flex';
      return;
    }
    const closeModal = e.target.closest('[data-close-modal]');
    if (closeModal || e.target.id === 'detailsModal') {
      document.getElementById('detailsModal').style.display = 'none';
      return;
    }
    // Test row menu open
    const tMenu = e.target.closest('[data-test-menu]');
    if (tMenu) {
      const menu = document.getElementById('testRowMenu');
      const row = tMenu.closest('tr');
      const screen = document.querySelector('[data-screen="test-list"]');
      const rect = row.getBoundingClientRect();
      const sRect = screen.getBoundingClientRect();
      menu.style.top = (rect.top - sRect.top + 6) + 'px';
      menu.style.right = '60px';
      closeMenus();
      menu.classList.add('open');
      e.stopPropagation();
      return;
    }
    // Sub row menu open
    const sMenu = e.target.closest('[data-sub-menu]');
    if (sMenu) {
      const menu = document.getElementById('subRowMenu');
      const row = sMenu.closest('tr');
      const screen = document.querySelector('[data-screen="submissions-list"]');
      const rect = row.getBoundingClientRect();
      const sRect = screen.getBoundingClientRect();
      menu.style.top = (rect.top - sRect.top + 6) + 'px';
      menu.style.right = '60px';
      closeMenus();
      menu.classList.add('open');
      e.stopPropagation();
      return;
    }
    // Test row click -> test summary
    const tRow = e.target.closest('[data-test-row]');
    if (tRow && !e.target.closest('[data-test-menu]')) {
      showScreen('test-summary');
      return;
    }
    // Sub row click -> submission results
    const sRow = e.target.closest('[data-sub-row]');
    if (sRow && !e.target.closest('[data-sub-menu]')) {
      showScreen('submission-results');
      return;
    }
    // Switch click (toggle) — sync aria-checked and handle feedback master toggle
    const sw = e.target.closest('[data-switch]');
    if (sw) {
      sw.classList.toggle('on');
      const isOn = sw.classList.contains('on');
      sw.setAttribute('aria-checked', String(isOn));
      // Master feedback toggle: show/hide generation, delivery, and display settings
      if (sw.hasAttribute('data-feedback-master')) {
        const genSettings  = document.getElementById('feedback-gen-settings');
        const offNotice    = document.getElementById('feedback-gen-off-notice');
        const deliveryDisp = document.getElementById('feedback-delivery-display');
        if (genSettings)  { genSettings.style.display  = isOn ? '' : 'none'; }
        if (offNotice)    { offNotice.style.display    = isOn ? 'none' : 'flex'; }
        if (deliveryDisp) { deliveryDisp.style.display = isOn ? '' : 'none'; }
      }
      return;
    }

    // Builder tabs — scoped to the screen that owns them so multiple builders
    // (new-test-submission, new-test-likert, new-test-mcq, etc.) don't cross-fire.
    const bt = e.target.closest('[data-builder-tab]');
    if (bt) {
      const which = bt.getAttribute('data-builder-tab');
      const scope = bt.closest('.screen') || document;
      scope.querySelectorAll('[data-builder-tab]').forEach(x => x.classList.toggle('active', x === bt));
      scope.querySelectorAll('[data-builder-panel]').forEach(p => p.style.display = p.getAttribute('data-builder-panel') === which ? 'block' : 'none');
      return;
    }
    // Result tabs
    const rt = e.target.closest('[data-result-tab]');
    if (rt) {
      const which = rt.getAttribute('data-result-tab');
      document.querySelectorAll('[data-result-tab]').forEach(x => x.classList.toggle('active', x === rt));
      document.querySelectorAll('[data-result-panel]').forEach(p => p.style.display = p.getAttribute('data-result-panel') === which ? 'block' : 'none');
      return;
    }
    // Feedback tabs
    const ft = e.target.closest('[data-feedback-tab]');
    if (ft) {
      const which = ft.getAttribute('data-feedback-tab');
      document.querySelectorAll('[data-feedback-tab]').forEach(x => x.classList.toggle('active', x === ft));
      document.querySelectorAll('[data-feedback-panel]').forEach(p => p.style.display = p.getAttribute('data-feedback-panel') === which ? 'block' : 'none');
      return;
    }
    // Clicking the New-test dropdown menu items routes to the right type screen.
    var newMenuItem = e.target.closest('#newTestMenu [data-new-test]');
    if (newMenuItem) {
      var type = newMenuItem.getAttribute('data-new-test');
      closeMenus();
      if (type === 'import') return; // Import flow not built in this prototype
      showScreen('new-test-' + type);
      return;
    }
    // Toggle the New-test dropdown when the New button is clicked.
    if (e.target.closest('#newTestBtn')) {
      e.stopPropagation();
      document.getElementById('newTestMenu').classList.toggle('open');
      return;
    }
    closeMenus();
  });

