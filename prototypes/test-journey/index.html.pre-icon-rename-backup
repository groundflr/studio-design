        var type = addQ.getAttribute('data-add-question');
        var host = addQ.parentElement.querySelector('[data-questions-host]');
        if (!host) return;
        clearEmpty(host);
        var idx = host.querySelectorAll('[data-q]').length + 1;
        var html = (type === 'likert') ? likertQuestionHTML(idx) : mcqQuestionHTML(idx);
        host.insertAdjacentHTML('beforeend', html);
        return;
      }

      // Remove Question
      var qDel = e.target.closest('[data-q-delete]');
      if (qDel) {
        var qCard = qDel.closest('[data-q]');
        var qHost = qCard.parentElement;
        qCard.remove();
        if (qHost && qHost.children.length === 0) {
          qHost.insertAdjacentHTML('beforeend', '<div class="builder-empty" data-empty>No questions</div>');
        }
        return;
      }

      // Collapse / expand a question card
      var qChev = e.target.closest('[data-q-collapse]');
      if (qChev) {
        qChev.closest('[data-q]').classList.toggle('is-collapsed');
        return;
      }

      // Question card sub-tabs (Question | Choices)
      var qTab = e.target.closest('[data-q-tab]');
      if (qTab) {
        var which = qTab.getAttribute('data-q-tab');
        var card = qTab.closest('[data-q]');
        card.querySelectorAll('[data-q-tab]').forEach(function (t) { t.classList.toggle('active', t === qTab); });
        card.querySelectorAll('[data-q-panel]').forEach(function (p) {
          p.style.display = p.getAttribute('data-q-panel') === which ? 'block' : 'none';
        });
        return;
