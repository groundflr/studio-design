    // ---- Confidence chip helper ----
    var confidenceLevels = {
      high:   { cls: 'fb-confidence-high',   icon: 'icon-shield-check',    label: 'High confidence' },
      medium: { cls: 'fb-confidence-medium',  icon: 'icon-gauge',           label: 'Medium confidence' },
      low:    { cls: 'fb-confidence-low',     icon: 'icon-alert-triangle',  label: 'Low confidence' }
    };
    function setConfidence(level) {
      if (!confidenceChip || !confidenceLabel) return;
      var cfg = confidenceLevels[level] || confidenceLevels.high;
      // Remove all confidence classes
      Object.values(confidenceLevels).forEach(function(c) { confidenceChip.classList.remove(c.cls); });
      confidenceChip.classList.add(cfg.cls);
      // Update icon
      var iconEl = confidenceChip.querySelector('i');
      if (iconEl) { iconEl.className = cfg.icon; }
      confidenceLabel.textContent = cfg.label;
    }

    // ---- Variability chip helper (summary signal, distinct from left-pane Run 1/Run 2 table) ----
    function setVariabilityChip(flagged) {
      if (!variabilityChip || !variabilityChipLabel || !variabilityChipIcon) return;
