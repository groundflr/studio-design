  function setView(view) {
    document.getElementById('app').setAttribute('data-view', view);
    document.querySelector('[data-shell="studio"]').style.display = view === 'studio' ? 'flex' : 'none';
    document.querySelector('[data-shell="candidate"]').style.display = view === 'candidate' ? 'flex' : 'none';
    document.getElementById('jStudio').classList.toggle('active', view === 'studio');
    document.getElementById('jCandidate').classList.toggle('active', view === 'candidate');
    if (view === 'studio') contentWindow.classList.remove('float');
    else contentWindow.classList.add('float');
