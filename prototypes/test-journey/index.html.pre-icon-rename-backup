        chipAdd.removeAttribute('data-chip-add');
        chipAdd.setAttribute('data-chip', addKind);
        var addLabel = addKind === 'link' ? 'External Link' : (addKind.charAt(0).toUpperCase() + addKind.slice(1));
        chipAdd.innerHTML = addLabel + ' <button class="q-chip__remove" data-chip-remove>×</button>';
        return;
      }

      // Likert: Add Option
      var addOpt = e.target.closest('[data-add-option]');
      if (addOpt) {
        var optList = addOpt.parentElement;
        var num = optList.querySelectorAll('[data-opt]').length + 1;
        addOpt.insertAdjacentHTML('beforebegin', optionRowHTML(num));
        return;
      }

      // MCQ / Written: Add Choice
      var addCh = e.target.closest('[data-add-choice]');
      if (addCh) {
        addCh.insertAdjacentHTML('beforebegin', choiceCardHTML());
        return;
      }

      // Toggle "correct" on a choice card
      var corr = e.target.closest('[data-toggle-correct]');
      if (corr) {
        corr.closest('[data-choice]').classList.toggle('is-correct');
        return;
      }

      // Delete a choice card
      var delCh = e.target.closest('[data-del-choice]');
      if (delCh) {
        delCh.closest('[data-choice]').remove();
        return;
      }

      // Add Grading Category
      var addCat = e.target.closest('[data-add-category]');
      if (addCat) {
        var gHost = addCat.parentElement.querySelector('[data-grading-host]');
        if (!gHost) return;
        clearEmpty(gHost);
        gHost.insertAdjacentHTML('beforeend', gradingCategoryHTML());
        return;
      }

      // Collapse / expand a grading category
      var catChev = e.target.closest('[data-cat-collapse]');
      if (catChev) {
        catChev.closest('[data-cat]').classList.toggle('is-collapsed');
        return;
      }

      // Delete a grading category
      var delCat = e.target.closest('[data-del-cat]');
      if (delCat) {
        var catEl = delCat.closest('[data-cat]');
        var catHost = catEl.parentElement;
        catEl.remove();
        if (catHost && catHost.querySelectorAll('[data-cat]').length === 0) {
          catHost.insertAdjacentHTML('beforeend', '<div class="builder-empty" data-empty>No grading categories</div>');
        }
        return;
      }

      // Add Level inside a category
      var addLvl = e.target.closest('[data-add-level]');
      if (addLvl) {
        var levelsHost = addLvl.previousElementSibling; // div.grade-cat__levels
        if (levelsHost) levelsHost.insertAdjacentHTML('beforeend', levelRowHTML(0, '', ''));
        return;
      }

      // Delete a level
      var delLvl = e.target.closest('[data-del-level]');
      if (delLvl) {
        delLvl.closest('[data-level]').remove();
        return;
      }
    });
  })();

  // Close any open dropdown menus when clicking outside their button.
  document.addEventListener('click', function (e) {
    if (e.target.closest('#newTestBtn')) return;
    if (e.target.closest('#newTestMenu')) return;
    var nm = document.getElementById('newTestMenu');
    if (nm) nm.classList.remove('open');
  });

  // Deep-link from dashboard / external entry points: ?screen=test-summary or #test-summary
  (function applyEntryHash() {
    var screenName = null;
    var params = new URLSearchParams(window.location.search);
    if (params.get('screen')) screenName = params.get('screen');
    else if (window.location.hash && window.location.hash.length > 1) screenName = window.location.hash.slice(1);
    if (screenName && document.querySelector('.screen[data-screen="' + screenName + '"]')) {
      showScreen(screenName);
    }
  })();
</script>
