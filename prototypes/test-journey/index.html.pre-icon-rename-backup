  function showScreen(name) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    const s = document.querySelector(`.screen[data-screen="${name}"]`);
    if (s) s.classList.add('active');
    contentWindow.scrollTop = 0;
    closeMenus();
