    }
    .add-level-row { border-top: 1px solid var(--surface-100); }
    .add-level-row:hover, .add-category-row:hover { background: var(--surface-50); }

    .add-category-wrap {
      display: flex; justify-content: center;
      padding: 14px 0 0;
    }
    .add-category {
      display: inline-flex; align-items: center; gap: 8px;
      font: 500 13px var(--font-sans); color: var(--surface-700);
      padding: 10px 16px; border-radius: 8px;
